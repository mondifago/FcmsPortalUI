@using FcmsPortal.Models
@using FcmsPortal.Constants
@using FcmsPortalUI.Services
@inject ISchoolDataService SchoolDataService

<div>
    @if (AllThreads == null)
    {
        <p>Loading discussion threads...</p>
    }
    else
    {
        <!-- New Post Form -->
        @if (AllowReplies)
        {
            <EditForm Model="newFirstPost" OnValidSubmit="@HandleAddFirstPost" class="mb-4">
                <CharacterCountTextArea @bind-Value="newFirstPost.Comment"
                                        Rows="2"
                                        Placeholder="Start a new discussion..." />
                <div class="d-flex justify-content-end mt-2">
                    <button type="submit" class="btn btn-fcms fcms-btn-round" title="Post">
                        <i class="fas fa-paper-plane"></i>
                    </button>
                </div>
            </EditForm>
        }

        <!-- List of All Discussion Threads -->
        @if (AllThreads != null && AllThreads.Any())
        {
            <div class="discussion-threads-container">
                @foreach (var thread in AllThreads.OrderByDescending(t => t.CreatedAt))
                {
                    var liked = HasLiked(thread);

                    <div class="discussion-thread mb-4 pb-3">
                        <!-- First Post with Author -->
                        <div class="d-flex mb-2">
                            <div class="me-3">
                                <ProfileThumbnailList Person="thread.FirstPost.Author" />
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@Util.GetFullName(thread.FirstPost.Author)</strong>
                                        <small class="text-muted ms-2" title="@thread.FirstPost.CreatedAt.ToString("MMM dd, yyyy HH:mm")">@Util.FormatTimeAgo(thread.FirstPost.CreatedAt, DateTime.Now)</small>
                                    </div>
                                </div>

                                <p class="mt-2 mb-1">@thread.FirstPost.Comment</p>

                                <div class="d-flex align-items-center flex-wrap mt-2">
                                    <button class="btn btn-outline-fcms fcms-btn-round" title="Comment"
                                            disabled="@(!AllowReplies)" @onclick="() => ToggleReplyForm(thread.Id)">
                                        <i class="far fa-comment"></i>
                                    </button>
                                    <span class="ms-1 me-3">@thread.Replies.Count</span>

                                    <button class="btn @(liked ? "btn-fcms" : "btn-outline-fcms") fcms-btn-round" title="Like"
                                            disabled="@(!AllowReplies)" @onclick="() => ToggleLike(thread)">
                                        <i class="@(liked ? "fas" : "far") fa-thumbs-up"></i>
                                    </button>
                                    <span class="ms-1 me-3">@thread.Likes.Count</span>

                                </div>

                            </div>
                        </div>

                        <!-- Reply Form -->
                        @if (replyingToThreadId == thread.Id)
                        {
                            <div class="ms-5 mb-3 mt-3">
                                <EditForm Model="newReply" OnValidSubmit="() => HandleAddReply(thread)">
                                    <div class="mb-2">
                                        <CharacterCountTextArea @bind-Value="newReply.Comment"
                                                                Rows="2"
                                                                Placeholder="Write your reply..." />
                                    </div>
                                    <div class="d-flex justify-content-end">
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-2" @onclick="CancelReply">Cancel</button>
                                        <button type="submit" class="btn btn-sm btn-primary">Reply</button>
                                    </div>
                                </EditForm>
                            </div>
                        }

                        <!-- Replies Section -->
                        <div class="replies-container ms-5">
                            @{
                                var replies = thread.Replies.OrderByDescending(r => r.CreatedAt).ToList();
                                var displayReplies = expandedThreads.Contains(thread.Id)
                                ? replies
                                : replies.Take(FcmsConstants.DISCUSSION_REPLY_PREVIEW_COUNT).ToList();
                            }

                            @foreach (var reply in displayReplies)
                            {
                                <div class="reply-item d-flex mt-3">
                                    <div class="me-3">
                                        <ProfileThumbnailList Person="reply.Author" />
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <strong>@Util.GetFullName(reply.Author)</strong>
                                                <small class="text-muted ms-2" title="@reply.CreatedAt.ToString("MMM dd, yyyy HH:mm")">@Util.FormatTimeAgo(reply.CreatedAt, DateTime.Now)</small>
                                            </div>
                                        </div>
                                        <p class="mb-0 mt-1">@reply.Comment</p>
                                    </div>
                                </div>
                            }

                            @if (thread.Replies.Count > FcmsConstants.DISCUSSION_REPLY_PREVIEW_COUNT)
                            {
                                <div class="text-center mt-2">
                                    <button class="btn btn-sm btn-link" @onclick="() => ToggleThreadExpansion(thread.Id)">
                                        @(expandedThreads.Contains(thread.Id) ? "Show fewer replies" : $"View all {thread.Replies.Count} replies")
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>No discussions yet. Start a new one!
            </div>
        }
    }
</div>


@code {
    [Parameter] public List<DiscussionThread>? AllThreads { get; set; }
    [Parameter] public bool AllowReplies { get; set; } = true;
    [Parameter] public Person? CurrentUser { get; set; }
    [Parameter] public int ClassSessionId { get; set; }

    private FirstPost newFirstPost = new();
    private Reply newReply = new();
    private int replyingToThreadId = 0;
    private HashSet<int> expandedThreads = new HashSet<int>();

    private async Task HandleAddFirstPost()
    {
        if (CurrentUser == null || string.IsNullOrWhiteSpace(newFirstPost.Comment)) return;

        var firstPost = new FirstPost
        {
            PersonId = CurrentUser.Id,
            Comment = newFirstPost.Comment
        };

        await SchoolDataService.AddDiscussionThreadAsync(ClassSessionId, firstPost);
        AllThreads = await SchoolDataService.GetThreadsForClassSessionAsync(ClassSessionId);
        newFirstPost = new FirstPost();
    }

    private async Task HandleAddReply(DiscussionThread thread)
    {
        if (CurrentUser == null || string.IsNullOrWhiteSpace(newReply.Comment))
            return;

        await SchoolDataService.AddReplyAsync(thread.Id, CurrentUser.Id, newReply.Comment);

        AllThreads = await SchoolDataService.GetThreadsForClassSessionAsync(ClassSessionId);
        newReply = new Reply();
        replyingToThreadId = 0;
    }

    private bool HasLiked(DiscussionThread thread)
    {
        return CurrentUser != null && thread.Likes.Any(l => l.PersonId == CurrentUser.Id);
    }

    private async Task ToggleLike(DiscussionThread thread)
    {
        if (CurrentUser == null)
            return;

        await SchoolDataService.ToggleThreadLikeAsync(thread.Id, CurrentUser.Id);
        AllThreads = await SchoolDataService.GetThreadsForClassSessionAsync(ClassSessionId);
    }

    private void ToggleReplyForm(int threadId)
    {
        replyingToThreadId = replyingToThreadId == threadId ? 0 : threadId;

        if (replyingToThreadId != 0)
        {
            expandedThreads.Add(threadId);
        }
        newReply = new();
    }

    private void ToggleThreadExpansion(int threadId)
    {
        if (!expandedThreads.Remove(threadId))
            expandedThreads.Add(threadId);
    }

    private void CancelReply()
    {
        replyingToThreadId = 0;
        newReply = new();
    }

    private void ExpandThread(int threadId)
    {
        expandedThreads.Add(threadId);
    }

    private void CollapseThread(int threadId)
    {
        expandedThreads.Remove(threadId);
    }
}