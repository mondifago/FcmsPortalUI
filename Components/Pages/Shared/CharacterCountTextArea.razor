@using FcmsPortal.Constants

<div class="character-count-textarea-container">
    <textarea class="form-control @AdditionalCssClass"
              rows="@Rows"
              maxlength="@MaxLength"
              placeholder="@PlaceholderWithLimit"
              @bind:get="Value"
              @bind:set="HandleValueSet">
    </textarea>

    @if (ShowEmojiPicker || Actions != null)
    {
        <div class="d-flex align-items-center mt-2">
            @if (ShowEmojiPicker)
            {
                <div class="position-relative">
                    <button type="button" class="btn btn-outline-fcms fcms-btn-round" title="Insert emoji"
                            @onclick="ToggleEmojiPanel">
                        <i class="far fa-face-smile"></i>
                    </button>

                    @if (isEmojiPanelOpen)
                    {
                        <div class="position-fixed top-0 start-0 w-100 h-100 z-2" @onclick="CloseEmojiPanel"></div>
                        <div class="emoji-panel position-absolute top-100 start-0 z-3 mt-2 p-2 rounded-3 shadow">
                            @foreach (var emoji in emojiSet)
                            {
                                <span class="emoji-item" role="button" @onclick="() => InsertEmoji(emoji)">@emoji</span>
                            }
                        </div>
                    }
                </div>
            }
            <div class="ms-auto">@Actions</div>
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public int MaxLength { get; set; } = FcmsConstants.MAX_DISCUSSION_COMMENT_LENGTH;
    [Parameter] public int Rows { get; set; } = 3;
    [Parameter] public string Placeholder { get; set; } = string.Empty;
    [Parameter] public string AdditionalCssClass { get; set; } = string.Empty;
    [Parameter] public bool ShowEmojiPicker { get; set; } = true;
    [Parameter] public RenderFragment? Actions { get; set; }

    private bool isEmojiPanelOpen = false;

    private string PlaceholderWithLimit => string.IsNullOrEmpty(Placeholder)
        ? $"Up to {MaxLength} characters"
        : $"{Placeholder} (up to {MaxLength} characters)";

    private readonly string[] emojiSet = new[]
    {
        "😊", "😂", "😮", "🤔", "🙏", "👏", "👍",
        "🎉", "✅", "❓", "💡", "📚", "✏️", "📝",
        "⭐", "🌟", "🏆", "🔥", "💪", "👀", "🥳"
    };

    private async Task HandleValueSet(string? newValue)
    {
        Value = newValue ?? string.Empty;

        if (Value.Length > MaxLength)
        {
            Value = Value[..MaxLength];
        }

        await ValueChanged.InvokeAsync(Value);
    }

    private async Task InsertEmoji(string emoji)
    {
        if (Value.Length + emoji.Length > MaxLength) return;

        Value += emoji;
        await ValueChanged.InvokeAsync(Value);
        isEmojiPanelOpen = false;
    }

    private void ToggleEmojiPanel()
    {
        isEmojiPanelOpen = !isEmojiPanelOpen;
    }

    private void CloseEmojiPanel()
    {
        isEmojiPanelOpen = false;
    }
}