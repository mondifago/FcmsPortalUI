@using FcmsPortal
@using FcmsPortal.Models
@inject IJSRuntime JSRuntime

<div class="modal @(IsVisible ? "show" : "")" style="display: @(IsVisible ? "block" : "none");" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Fee Ledger</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                @if (Student == null)
                {
                    <p>Loading...</p>
                }
                else
                {
                    <div class="payment-report">
                        <h2>Fee Ledger</h2>

                        <div class="report-section">
                            <div class="report-grid">
                                <div>
                                    <p><strong>Student:</strong> @Util.GetFullName(Student.Person)</p>
                                </div>
                                <div>
                                    <p><strong>Closing balance:</strong> @Util.Money(ledgerData.ClosingBalance)</p>
                                </div>
                            </div>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Academic Period</th>
                                        <th class="text-end">Brought forward</th>
                                        <th class="text-end">Term fee</th>
                                        <th class="text-end">Discount</th>
                                        <th class="text-end">Term payable</th>
                                        <th class="text-end">Total payable</th>
                                        <th class="text-end">Paid</th>
                                        <th class="text-end">Carried forward</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!ledgerData.Entries.Any())
                                    {
                                        <tr>
                                            <td colspan="8" class="text-center">No fee records available.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var entry in ledgerData.Entries)
                                        {
                                            <tr>
                                                <td>
                                                    @entry.AcademicYear
                                                    <small class="text-muted d-block">
                                                        @entry.ClassLevel.ToDisplayName() &middot; @entry.Semester.ToTermDisplay()
                                                    </small>
                                                </td>
                                                <td class="text-end">@Util.Money(entry.BroughtForward)</td>
                                                <td class="text-end">@Util.Money(entry.TermFee)</td>
                                                <td class="text-end">@Util.Money(entry.Discount)</td>
                                                <td class="text-end">@Util.Money(entry.TermPayable)</td>
                                                <td class="text-end fw-bold">@Util.Money(entry.TotalPayable)</td>
                                                <td class="text-end text-success">@Util.Money(entry.Paid)</td>
                                                <td class="text-end fw-bold @(entry.CarriedForward > 0 ? "text-danger" : "text-success")">
                                                    @Util.Money(entry.CarriedForward)
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="timestamp text-muted">
                            <em>Ledger generated on @ledgerData.DateAndTimeLedgerGenerated.ToString("yyyy-MM-dd HH:mm:ss")</em>
                        </div>
                    </div>
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="Close">Close</button>
                <button type="button" class="btn btn-primary" @onclick="PrintLedger">Print</button>
            </div>
        </div>
    </div>
</div>

@if (IsVisible)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public Student? Student { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    private StudentFeeLedger ledgerData = new();

    protected override void OnParametersSet()
    {
        if (!IsVisible || Student == null)
        {
            return;
        }

        ledgerData = LogicMethods.GenerateStudentFeeLedger(Student);
    }

    private async Task PrintLedger()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private void Close()
    {
        OnClose.InvokeAsync();
    }
}
