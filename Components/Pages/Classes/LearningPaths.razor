@page "/classes"
@using Microsoft.AspNetCore.Components.QuickGrid
@using FcmsPortal
@using FcmsPortal.Models
@using FcmsPortal.Enums
@using FcmsPortal.Constants
@using FcmsPortalUI.Services
@using FcmsPortalUI.DTOs
@using FcmsPortalUI.Components.Pages.Shared
@inject ISchoolDataService SchoolDataService
@inject IPermissionService PermissionService
@inject NavigationManager NavigationManager

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0">Class Rooms</h2>

    @if (canManageLearningPaths)
    {
        <a href="/learningpath/create" class="btn btn-primary">
            <i class="fa fa-plus me-2"></i> Add New Learning Path
        </a>
    }
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <label for="academicYear" class="form-label">Academic Year:</label>
                <select class="form-select" id="academicYear" @bind="selectedAcademicYear" @bind:after="FilterLearningPaths">
                    <option value="">Select Academic Year</option>
                    @foreach (var year in availableAcademicYears)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label for="semester" class="form-label">Term:</label>
                <select class="form-select" id="semester" @bind="selectedSemester" @bind:after="FilterLearningPaths">
                    <option value="">Select Term</option>
                    @foreach (var semester in Enum.GetValues(typeof(Semester)).Cast<Semester>())
                    {
                        <option value="@semester">@semester</option>
                    }
                </select>
            </div>
        </div>
    </div>
</div>

@if (!filtersApplied)
{
    <div class="alert alert-info">
        <i class="fa fa-info-circle me-2"></i>
        Please select filters to view learning paths.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            @if (canManageLearningPaths)
            {
                <div class="d-flex align-items-center flex-wrap mb-2" style="gap:0.5rem;">
                    @if (!selectMode)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="EnterSelectMode">
                            <i class="fa fa-check-square me-1"></i>Select
                        </button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-warning" disabled="@(!CanEditSelected())" @onclick="EditSelected">
                            <i class="fa fa-pencil me-1"></i>Edit
                        </button>
                        <button class="btn btn-sm btn-danger" disabled="@(!selectedItems.Any())" @onclick="DeleteSelected">
                            <i class="fa fa-trash me-1"></i>Delete (@selectedItems.Count)
                        </button>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="ExitSelectMode">
                            <i class="fa fa-times me-1"></i>Cancel
                        </button>
                    }
                </div>
            }

            <div class="table-responsive">
                <QuickGrid Items="itemsQuery" Pagination="pagination" Class="table table-striped fcms-grid">
                    @if (selectMode)
                    {
                        <TemplateColumn Title="">
                            @if (context.ApprovalStatus != PrincipalApprovalStatus.Review)
                            {
                                <input type="checkbox"
                                       checked="@selectedItems.ContainsKey(context.Id)"
                                       @onchange="e => ToggleSelection(context, e)" />
                            }
                        </TemplateColumn>
                    }

                    <TemplateColumn Title="Class Level">
                        @if (context.ApprovalStatus != PrincipalApprovalStatus.Review)
                        {
                            <a href="/learningpaths/details/@context.Id" class="grid-name-link">
                                @context.ClassLevel.ToDisplayName()
                            </a>
                        }
                        else
                        {
                            @context.ClassLevel.ToDisplayName()
                        }
                    </TemplateColumn>

                    <TemplateColumn Title="Education Level" Class="d-none d-md-table-cell">
                        @context.EducationLevel.ToDisplayName()
                    </TemplateColumn>

                    <TemplateColumn Title="Term" Class="d-none d-md-table-cell">
                        @context.Semester.ToTermDisplay()
                    </TemplateColumn>

                    <TemplateColumn Title="Academic Year" Class="d-none d-md-table-cell">
                        @context.AcademicYear
                    </TemplateColumn>

                    <TemplateColumn Title="Approval Status">
                        <span class="@Util.GetApprovalStatusBadgeClass(context.ApprovalStatus)">
                            @context.ApprovalStatus
                        </span>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <button class="btn btn-sm btn-fcms"
                        disabled="@(pagination.CurrentPageIndex == 0)"
                        @onclick="PreviousPage">
                    <i class="fa fa-arrow-left"></i>
                </button>
                <small class="text-muted">Page @(pagination.CurrentPageIndex + 1) of @((pagination.LastPageIndex ?? 0) + 1)</small>
                <button class="btn btn-sm btn-fcms"
                        disabled="@(pagination.CurrentPageIndex >= (pagination.LastPageIndex ?? 0))"
                        @onclick="NextPage">
                    <i class="fa fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>
}

<ConfirmDeleteModal IsVisible="showDeleteConfirmation"
                    Title="Confirm Delete"
                    Message="@deleteMessage"
                    OnConfirm="DeleteLearningPath"
                    OnCancel="CancelDelete" />

<ErrorDisplayModal IsVisible="showErrorModal"
                   Title="Delete Error"
                   Message="@errorMessage"
                   OnClose="CloseErrorModal" />


@code {
    private IQueryable<LearningPathListItem>? scopedQuery;
    private IQueryable<LearningPathListItem>? itemsQuery;
    private PaginationState pagination = new() { ItemsPerPage = FcmsConstants.LIST_PAGE_SIZE };

    private bool selectMode = false;
    private Dictionary<int, PrincipalApprovalStatus> selectedItems = new();

    private List<string> availableAcademicYears = new();
    private Person? currentUser;
    private int? currentUserId;
    private bool canManageLearningPaths;
    private bool isStaff;
    private bool isGuardian;
    private bool isStudent;
    private string selectedAcademicYear = "";
    private string selectedSemester = "";
    private bool filtersApplied = false;
    private bool showDeleteConfirmation = false;
    private bool showErrorModal = false;
    private string errorMessage = "";
    private string deleteMessage = "";

    protected override async Task OnInitializedAsync()
    {
        pagination.TotalItemCountChanged += (sender, eventArgs) => InvokeAsync(StateHasChanged);

        currentUserId = await PermissionService.GetCurrentUserIdAsync();
        currentUser = await PermissionService.GetCurrentPersonAsync();

        canManageLearningPaths = await PermissionService.IsInAnyRoleAsync("Developer", "Principal", "Admin", "Teacher");
        isStaff = await PermissionService.IsInRoleAsync("Staff");
        isGuardian = await PermissionService.IsInRoleAsync("Guardian");
        isStudent = await PermissionService.IsInRoleAsync("Student");

        scopedQuery = SchoolDataService.GetLearningPathsForList();

        if (isGuardian)
        {
            var guardian = SchoolDataService.GetGuardians()
                .FirstOrDefault(g => g.PersonId == currentUser?.Id);

            var wardIds = guardian?.Wards
                .Where(w => w.LearningPathId != null)
                .Select(w => w.LearningPathId!.Value)
                .ToList() ?? new();

            scopedQuery = scopedQuery.Where(lp => wardIds.Contains(lp.Id));
        }

        if (isStudent)
        {
            var student = SchoolDataService.GetStudents()
                .FirstOrDefault(s => s.PersonId == currentUser?.Id);

            if (student?.LearningPathId != null)
            {
                var studentPathId = student.LearningPathId.Value;
                scopedQuery = scopedQuery.Where(lp => lp.Id == studentPathId);
            }
        }

        LoadAvailableFilters();
        InitializeWithCurrentAcademicPeriod();
    }

    private void InitializeWithCurrentAcademicPeriod()
    {
        var currentPeriod = SchoolDataService.GetCurrentAcademicPeriod();

        if (currentPeriod != null)
        {
            selectedAcademicYear = currentPeriod.AcademicYear;
            selectedSemester = currentPeriod.Semester.ToString();
            FilterLearningPaths();
        }
    }

    private void LoadAvailableFilters()
    {
        if (scopedQuery == null)
        {
            availableAcademicYears = new List<string>();
            return;
        }

        availableAcademicYears = scopedQuery
            .Select(lp => lp.AcademicYearStart.Year)
            .Distinct()
            .OrderByDescending(y => y)
            .ToList()
            .Select(y => $"{y}-{y + 1}")
            .ToList();
    }

    private void FilterLearningPaths()
    {
        filtersApplied = !string.IsNullOrEmpty(selectedAcademicYear) ||
                         !string.IsNullOrEmpty(selectedSemester);

        if (!filtersApplied || scopedQuery == null)
        {
            itemsQuery = null;
            return;
        }

        var query = scopedQuery;

        if (!string.IsNullOrEmpty(selectedAcademicYear) &&
            int.TryParse(selectedAcademicYear.Split('-')[0], out var startYear))
        {
            query = query.Where(lp => lp.AcademicYearStart.Year == startYear);
        }

        if (!string.IsNullOrEmpty(selectedSemester) && Enum.TryParse<Semester>(selectedSemester, out var semester))
        {
            query = query.Where(lp => lp.Semester == semester);
        }

        itemsQuery = query;
    }

    private void EnterSelectMode()
    {
        selectMode = true;
        selectedItems.Clear();
    }

    private void ExitSelectMode()
    {
        selectMode = false;
        selectedItems.Clear();
    }

    private void ToggleSelection(LearningPathListItem item, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;

        if (isChecked)
        {
            selectedItems[item.Id] = item.ApprovalStatus;
        }
        else
        {
            selectedItems.Remove(item.Id);
        }
    }

    private bool CanEditSelected()
    {
        return selectedItems.Count == 1 &&
               selectedItems.First().Value == PrincipalApprovalStatus.Pending;
    }

    private void EditSelected()
    {
        NavigationManager.NavigateTo($"/learningpath/edit/{selectedItems.First().Key}");
    }

    private void DeleteSelected()
    {
        deleteMessage = $"Are you sure you want to delete {selectedItems.Count} learning path(s)?";
        showDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
    }

    private void DeleteLearningPath()
    {
        var failures = new List<string>();

        foreach (var id in selectedItems.Keys.ToList())
        {
            try
            {
                SchoolDataService.DeleteLearningPath(id);
                selectedItems.Remove(id);
            }
            catch (BusinessRuleException ex)
            {
                failures.Add(ex.Message);
            }
        }

        if (failures.Any())
        {
            errorMessage = string.Join(" ", failures);
            showErrorModal = true;
        }

        LoadAvailableFilters();
        FilterLearningPaths();
        showDeleteConfirmation = false;
        StateHasChanged();
    }

    private async Task PreviousPage()
    {
        await pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex - 1);
    }

    private async Task NextPage()
    {
        await pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex + 1);
    }

    private void CloseErrorModal()
    {
        showErrorModal = false;
        errorMessage = "";
        StateHasChanged();
    }
}