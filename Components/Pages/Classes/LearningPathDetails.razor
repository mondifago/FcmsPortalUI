@page "/learningpaths/details/{Id:int}"
@using FcmsPortalUI.Services
@using FcmsPortal.Models
@using FcmsPortal.Enums
@using FcmsPortal
@using FcmsPortalUI.Components.Pages.Shared
@using System.Globalization
@inject ISchoolDataService SchoolDataService
@inject IPermissionService PermissionService
@inject NavigationManager NavigationManager

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Developer, Principal, Admin, Teacher")]

<div class="container-fluid mt-3">
    @if (learningPath == null)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-3 fcms-gap-sm">
            <h2>Class Room</h2>
            <div class="d-flex flex-wrap fcms-gap-sm">
                <AuthorizeView Roles="Developer,Principal,Admin,Teacher">
                    <Authorized>
                        <button class="btn btn-success" @onclick="ShowAddStudentsModal">
                            <i class="fa fa-user-plus"></i> Add Students
                        </button>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Developer,Principal,Admin">
                    <Authorized>
                        <a href="/learningpath/edit/@learningPath.Id" class="btn btn-warning">
                            <i class="fa fa-pencil"></i> Edit
                        </a>
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Developer,Principal,Admin,Teacher">
                    <Authorized>
                        @if (learningPath.ApprovalStatus == PrincipalApprovalStatus.Pending)
                        {
                            <button class="btn btn-primary" @onclick="() => showSubmitConfirm = true">
                                <i class="fa fa-check-circle"></i> Submit
                            </button>
                        }
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Developer,Principal">
                    <Authorized>
                        @if (learningPath.ApprovalStatus == PrincipalApprovalStatus.Review)
                        {
                            <button class="btn btn-success" @onclick="() => showApproveConfirm = true">
                                <i class="fa fa-thumbs-up"></i> Approve
                            </button>
                            <button class="btn btn-secondary" @onclick="RestoreLearningPath">
                                <i class="fa fa-undo"></i> Restore
                            </button>
                        }
                    </Authorized>
                </AuthorizeView>

                <a href="/classes" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Back to List
                </a>
            </div>
        </div>

        <div class="fcms-info-strip mb-4">
            <div>
                <span class="fcms-info-label">Education Level</span>
                <span class="fcms-info-value">@learningPath.EducationLevel.ToDisplayName()</span>
            </div>
            <div>
                <span class="fcms-info-label">Class Level</span>
                <span class="fcms-info-value">@learningPath.ClassLevel.ToDisplayName()</span>
            </div>
            <div>
                <span class="fcms-info-label">Term</span>
                <span class="fcms-info-value">@learningPath.Semester.ToTermDisplay()</span>
            </div>
            <div>
                <span class="fcms-info-label">Academic Year</span>
                <span class="fcms-info-value">@learningPath.AcademicYear</span>
            </div>
            <div>
                <span class="fcms-info-label">Fee</span>
                <span class="fcms-info-value">@learningPath.FeePerSemester.ToString("C", new CultureInfo("en-NG"))</span>
            </div>
            <div>
                <span class="fcms-info-label">Term Start</span>
                <span class="fcms-info-value">@learningPath.SemesterStartDate.ToString("MMM d, yyyy")</span>
            </div>
            <div>
                <span class="fcms-info-label">Term End</span>
                <span class="fcms-info-value">@learningPath.SemesterEndDate.ToString("MMM d, yyyy")</span>
            </div>
            <div>
                <span class="fcms-info-label">Exams Start</span>
                <span class="fcms-info-value">@learningPath.ExamsStartDate.ToString("MMM d, yyyy")</span>
            </div>
            <div>
                <span class="fcms-info-label">Status</span>
                <span class="@Util.GetApprovalStatusBadgeClass(learningPath.ApprovalStatus)">
                    @learningPath.ApprovalStatus
                </span>
            </div>
        </div>

        <ul class="nav fcms-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(activeTab == TabStudents ? "active" : "")"
                        @onclick="() => activeTab = TabStudents">
                    Students
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == TabAttendance ? "active" : "")"
                        @onclick="() => activeTab = TabAttendance">
                    Attendance
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == TabGrades ? "active" : "")"
                        @onclick="() => activeTab = TabGrades">
                    Grades
                </button>
            </li>
        </ul>

        @if (activeTab == TabStudents)
        {
            <div class="card timetable-card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">Students (@learningPath.Students.Count)</h4>
                </div>
                <div class="card-body">
                    @if (learningPath.Students == null || !learningPath.Students.Any())
                    {
                        <div class="alert alert-info">
                            <p class="mb-0">No students enrolled in this learning path yet.</p>
                        </div>
                    }
                    else
                    {
                        var hasGrades = HasAnyGrades();
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Rank</th>
                                        <th>Student</th>
                                        <th>Payment</th>
                                        <th>Ave. Grade</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (hasGrades)
                                    {
                                        var ranked = GetRankedStudents();
                                        for (int i = 0; i < ranked.Count; i++)
                                        {
                                            var studentGrade = ranked[i];
                                            var student = studentGrade.Student;
                                            var rank = i + 1;
                                            if (student != null)
                                            {
                                                var (statusText, badgeClass) = Util.GetPaymentStatus(student, learningPath.Id);
                                                <tr>
                                                    <td>
                                                        <span class="fw-light @Util.GetRankColorClass(rank)">
                                                            @Util.GetOrdinalNumber(rank)
                                                        </span>
                                                    </td>
                                                    <td>
                                                        <a href="/students/details/@student.Id" class="text-decoration-none">
                                                            @Util.GetFullName(student.Person)
                                                        </a>
                                                    </td>
                                                    <td><span class="badge @badgeClass">@statusText</span></td>
                                                    <td>@studentGrade.SemesterOverallGrade.ToString("F2")%</td>
                                                    <td>
                                                        <button class="btn btn-sm btn-primary" @onclick="() => ShowStudentDetails(student)">
                                                            Details
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        foreach (var student in learningPath.Students.OrderBy(s => s.Person.FirstName))
                                        {
                                            var (statusText, badgeClass) = Util.GetPaymentStatus(student, learningPath.Id);
                                            <tr>
                                                <td><span class="text-muted">-</span></td>
                                                <td>
                                                    <a href="/students/details/@student.Id" class="text-decoration-none">
                                                        @Util.GetFullName(student.Person)
                                                    </a>
                                                </td>
                                                <td><span class="badge @badgeClass">@statusText</span></td>
                                                <td><span class="badge bg-secondary">No Grades</span></td>
                                                <td></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        @if (activeTab == TabAttendance)
        {
            <div class="card timetable-card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">Attendance</h4>
                </div>
                <div class="card-body text-center">
                    @if (learningPath.Students != null && learningPath.Students.Any())
                    {
                        <button class="@GetAttendanceButtonClass()" @onclick="HandleAttendanceAction">
                            @GetAttendanceButtonText()
                        </button>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No students enrolled yet, so attendance cannot be taken.</p>
                    }
                </div>
            </div>
        }

        @if (activeTab == TabGrades)
        {
            <div class="card timetable-card mb-4">
                <div class="card-header">
                    <h4 class="mb-0">Grades</h4>
                </div>
                <div class="card-body">
                    @if (!IsGradeConfigurationComplete())
                    {
                        <div class="alert alert-warning">
                            <i class="fa fa-exclamation-triangle"></i>
                            <strong>Grade Configuration Required</strong>
                            <p class="mb-3">Grade weights must be configured for all courses before recording grades or issuing homework.</p>

                            @if (GetUnconfiguredCourses().Any())
                            {
                                <p class="mb-2"><strong>Courses needing configuration:</strong></p>
                                <ul class="mb-3">
                                    @foreach (var course in GetUnconfiguredCourses())
                                    {
                                        <li>@course</li>
                                    }
                                </ul>
                            }
                        </div>
                    }
                    <AuthorizeView Roles="Developer,Principal,Admin,Teacher">
                        <Authorized>
                            <div class="d-flex justify-content-center fcms-gap-sm">
                                <button class="btn btn-primary" @onclick="ShowMainGradePage">
                                    Manage Grades
                                </button>
                                <button class="btn btn-success" @onclick="ShowFinalizeGradesModal">
                                    Finalize Grades
                                </button>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        }
    }
</div>

@if (showSubmitConfirm)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal show" style="display:block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Submit Learning Path</h5>
                </div>
                <div class="modal-body">
                    <p>
                        This learning path will be submitted to the Principal for review.<br />
                        You will no longer have access to it after this action.<br />
                        Are you sure you are ready to submit?
                    </p>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showSubmitConfirm = false">Cancel</button>
                    <button class="btn btn-primary" @onclick="ConfirmSubmitForReview">Submit</button>
                </div>

            </div>
        </div>
    </div>
}

@if (showApproveConfirm)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal show" style="display:block;">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5>Approve Learning Path</h5>
                </div>
                <div class="modal-body">
                    <p>
                        Are you sure you are ready to approve this class?<br />
                        You cannot undo this action.
                    </p>
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showApproveConfirm = false">Cancel</button>
                    <button class="btn btn-success" @onclick="ConfirmApproveLearningPath">Approve</button>
                </div>

            </div>
        </div>
    </div>
}

@if (showAddStudentsModal)
{
    <div class="modal show" style="display: block" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Students to Learning Path</h5>
                    <button type="button" class="btn-close" @onclick="CloseAddStudentsModal"></button>
                </div>
                <div class="modal-body">
                    @if (availableStudents == null || !availableStudents.Any())
                    {
                        <p>No eligible students found for this learning path.</p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-2">
                                <div>
                                    <button type="button" class="btn btn-sm btn-outline-primary me-2"
                                            @onclick="SelectAllStudents">
                                        Select All
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-secondary"
                                            @onclick="UnselectAllStudents">
                                        Unselect All
                                    </button>
                                </div>
                                <div>
                                    <span class="badge bg-info">@selectedStudentIds.Count selected</span>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-sm table-striped">
                                    <thead>
                                        <tr>
                                            <th style="width: 50px;"></th>
                                            <th>ID</th>
                                            <th>Name</th>
                                            <th>Education Level</th>
                                            <th>Class Level</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var student in availableStudents)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="form-check">
                                                        <input type="checkbox"
                                                               class="form-check-input"
                                                               checked="@IsStudentSelected(student.Id)"
                                                               @onchange="(e) => ToggleStudentSelection(student.Id, e.Value as bool? ?? false)" />
                                                    </div>
                                                </td>
                                                <td>@student.Id</td>
                                                <td>@student.Person.FirstName @student.Person.LastName</td>
                                                <td>@student.Person.EducationLevel.ToDisplayName()</td>
                                                <td>@student.Person.ClassLevel.ToDisplayName()</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseAddStudentsModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="AddSelectedStudents"
                            disabled="@(!selectedStudentIds.Any())">
                        Add Students
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal-backdrop fade show"></div>
}

@if (showFinalizeGradesModal)
{
    <FinalizeGradesModal IsVisible="showFinalizeGradesModal"
                         LearningPath="learningPath"
                         OnClose="CloseFinalizeGradesModal" />
}

@if (showGradesModal)
{
    <LearningPathGradesModal IsVisible="showGradesModal"
                             LearningPath="learningPath"
                             OnClose="() => showGradesModal = false" />
}

<AuthorizeView Roles="Developer,Principal,Admin,Teacher">
    <Authorized>
        @if (showAttendanceModal)
        {
            <TakeAttendanceModal IsVisible="showAttendanceModal"
                                 Students="@(learningPath?.Students ?? new List<Student>())"
                                 LearningPath="learningPath"
                                 AttendanceDate="DateTime.Now"
                                 TeacherId="@(currentUserId ?? 0)"
                                 OnAttendanceSubmitted="OnAttendanceSubmitted"
                                 OnClose="CloseAttendanceModal" />
        }

        @if (showDailyAttendanceModal && todaysAttendance != null)
        {
            <DailyAttendanceViewModal IsVisible="showDailyAttendanceModal"
                                      SelectedDate="DateTime.Now"
                                      AttendanceData="dailyAttendanceData"
                                      LearningPathName="@Util.GetLearningPathName(learningPath)"
                                      OnClose="CloseDailyAttendanceModal" />
        }
    </Authorized>
    <NotAuthorized>

    </NotAuthorized>
</AuthorizeView>




@if (showStudentDetailsModal)
{
    <StudentGradeDetailsModal IsVisible="showStudentDetailsModal"
                              Student="selectedStudent"
                              LearningPath="learningPath"
                              OnClose="CloseStudentDetailsModal" />
}

@code {
    [Parameter]
    public int Id { get; set; }

    private LearningPath learningPath = new LearningPath();
    private DailyAttendanceLogEntry? dailyAttendanceData;
    private DailyAttendanceLogEntry? todaysAttendance;
    private List<Student> availableStudents = new List<Student>();
    private HashSet<int> selectedStudentIds = new HashSet<int>();
    private Student? selectedStudent;

 
    private bool showGradesModal = false;
    private bool showStudentDetailsModal = false;
    private bool showFinalizeGradesModal = false;
    private bool showAttendanceModal = false;
    private bool showDailyAttendanceModal = false;

    private bool showAddStudentsModal = false;
    private bool showSubmitConfirm = false;
    private bool showApproveConfirm = false;
    private Person? currentUser;
    private int? currentUserId;

    private const string TabStudents = "students";
    private const string TabAttendance = "attendance";
    private const string TabGrades = "grades";
    private string activeTab = TabStudents;

    protected override async Task OnInitializedAsync()
    {
        learningPath = SchoolDataService.GetLearningPathForDetails(Id) ?? new LearningPath();
        currentUserId = await PermissionService.GetCurrentUserIdAsync();
        currentUser = await PermissionService.GetCurrentPersonAsync();
    }

    private void ShowAddStudentsModal()
    {
        var allEligibleStudents = SchoolDataService.GetStudentsByLevel(
           learningPath.EducationLevel,
           learningPath.ClassLevel);

        availableStudents = allEligibleStudents
            .Where(s => !learningPath.Students.Any(existingStudent => existingStudent.Id == s.Id))
            .ToList();

        selectedStudentIds.Clear();
        showAddStudentsModal = true;
    }

    private void CloseAddStudentsModal()
    {
        showAddStudentsModal = false;
    }

    private bool IsStudentSelected(int studentId)
    {
        return selectedStudentIds.Contains(studentId);
    }

    private void ToggleStudentSelection(int studentId, object isChecked)
    {
        Util.ToggleItemSelection<Student>(studentId, isChecked, selectedStudentIds);
    }

    private void SelectAllStudents()
    {
        selectedStudentIds = new HashSet<int>(availableStudents.Select(s => s.Id));
    }

    private void UnselectAllStudents()
    {
        selectedStudentIds.Clear();
    }

    private void AddSelectedStudents()
    {
        if (!selectedStudentIds.Any())
            return;

        var studentsToAdd = availableStudents
            .Where(s => selectedStudentIds.Contains(s.Id))
            .ToList();

        SchoolDataService.AddMultipleStudentsToLearningPath(Id, studentsToAdd);
        CloseAddStudentsModal();
    }

    private void SubmitForReview()
    {
        learningPath.ApprovalStatus = PrincipalApprovalStatus.Review;
        learningPath.SubmittedById = currentUserId;
        learningPath.SubmittedByName = currentUser != null
            ? $"{currentUser.FirstName} {currentUser.LastName}"
            : "Unknown";
        learningPath.DateSubmitted = DateTime.Now;

        SchoolDataService.UpdateLearningPath(learningPath);
    }

    private void ApproveLearningPath()
    {
        learningPath.ApprovalStatus = PrincipalApprovalStatus.Approved;
       
        foreach (var student in learningPath.Students.ToList())
        {
            SchoolDataService.RemoveStudentFromLearningPath(learningPath, student);
        }

        SchoolDataService.UpdateLearningPath(learningPath);
        SchoolDataService.CreateTemplateFromLearningPath(learningPath);
        StateHasChanged();
    }

    private void RestoreLearningPath()
    {
        learningPath.ApprovalStatus = PrincipalApprovalStatus.Pending;
        SchoolDataService.UpdateLearningPath(learningPath);
    }

    private string GetAttendanceButtonText()
    {
        return SchoolDataService.HasAttendanceBeenTaken(learningPath.Id, DateTime.Today) ? "View Attendance" : "Take Attendance";
    }

    private string GetAttendanceButtonClass()
    {
        return SchoolDataService.HasAttendanceBeenTaken(learningPath.Id, DateTime.Today)
            ? "btn btn-success btn-sm"
            : "btn btn-warning btn-sm";
    }

    private void HandleAttendanceAction()
    {
        if (SchoolDataService.HasAttendanceBeenTaken(learningPath.Id, DateTime.Today))
        {
            ShowTodaysAttendance();
        }
        else
        {
            showAttendanceModal = true;
        }
    }

    private void ShowTodaysAttendance()
    {
        if (learningPath != null)
        {
            dailyAttendanceData = SchoolDataService.GetAttendanceForDate(learningPath.Id, DateTime.Today) ?? new DailyAttendanceLogEntry();
            todaysAttendance = dailyAttendanceData;
            showDailyAttendanceModal = true;
        }
    }

    private void OnAttendanceSubmitted(DailyAttendanceLogEntry attendanceLog)
    {
        showAttendanceModal = false;
        StateHasChanged();
    }

    private void CloseAttendanceModal()
    {
        showAttendanceModal = false;
    }

    private void CloseDailyAttendanceModal()
    {
        showDailyAttendanceModal = false;
        todaysAttendance = null;
    }

    private bool IsGradeConfigurationComplete()
    {
        var allCourses = CourseDefaults.GetCourseNames(learningPath.EducationLevel);
        var configuredCourses = SchoolDataService.GetAllCourseGradingConfigurations(learningPath.Id);

        return allCourses.All(course => configuredCourses.Any(config => config.Course == course));
    }

    private List<string> GetUnconfiguredCourses()
    {
        return SchoolDataService.GetCoursesWithoutGradingConfiguration(learningPath.Id);
    }

    private bool HasAnyGrades()
    {
        return learningPath.Students.Any(s => s.CourseGrades.Any(cg =>
            cg.LearningPathId == learningPath.Id && cg.TestGrades.Any()));
    }

    private List<StudentGradeSummary> GetRankedStudents()
    {
        var gradeReport = LogicMethods.GenerateLearningPathGradeReport(learningPath);
        return gradeReport.RankedStudents;
    }

    private void ShowMainGradePage()
    {
        showGradesModal = true;
    }

    private void ShowStudentDetails(Student student)
    {
        selectedStudent = student;
        showStudentDetailsModal = true;
    }

    private void CloseStudentDetailsModal()
    {
        showStudentDetailsModal = false;
        selectedStudent = null;
    }

    private void ShowFinalizeGradesModal()
    {
        showFinalizeGradesModal = true;
    }

    private void CloseFinalizeGradesModal()
    {
        showFinalizeGradesModal = false;
        StateHasChanged();
    }

    private void ConfirmSubmitForReview()
    {
        showSubmitConfirm = false;
        SubmitForReview();
    }

    private void ConfirmApproveLearningPath()
    {
        showApproveConfirm = false;
        ApproveLearningPath();
    }
}