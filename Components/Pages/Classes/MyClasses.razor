@page "/myclasses"
@using FcmsPortal
@using FcmsPortal.Models
@using FcmsPortal.Enums
@using FcmsPortalUI.Services
@using FcmsPortalUI.DTOs
@using FcmsPortalUI.Components.Pages.Shared
@inject ISchoolDataService SchoolDataService
@inject IPermissionService PermissionService
@inject NavigationManager NavigationManager

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Developer, Principal, Admin, Teacher, Student, Guardian")]

<PageTitle>My Classes</PageTitle>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap fcms-gap-sm">
        <h2 class="mb-0">@pageHeading</h2>

        
    </div>

    @if (isGuardian && guardianProfile != null && guardianProfile.Wards.Count > 1)
    {
        <div class="d-flex align-items-center flex-wrap mb-3 fcms-gap-sm">
            <small class="text-muted">Viewing ward:</small>
            @foreach (var ward in guardianProfile.Wards)
            {
                @if (ward.Id == activeWardId)
                {
                    <span class="badge fcms-badge-selected">@Util.GetFullName(ward.Person)</span>
                }
                else
                {
                    <span class="badge bg-light text-secondary border fcms-clickable"
                          @onclick="() => SelectWard(ward.Id)">@Util.GetFullName(ward.Person)</span>
                }
            }
        </div>
    }

    @if (isStaffViewer)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row">

                    <div class="col-md-3">
                        <label class="form-label">Education Level:</label>
                        <select class="form-select" @bind="staffEducationLevel" @bind:after="OnStaffFiltersChanged">
                            <option value="">Select Education Level</option>
                            @foreach (var level in Enum.GetValues<EducationLevel>().Where(l => l != EducationLevel.None))
                            {
                                <option value="@level">@level.ToDisplayName()</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Class Level:</label>
                        <select class="form-select" @bind="staffClassLevel" @bind:after="OnStaffFiltersChanged"
                                disabled="@(string.IsNullOrEmpty(staffEducationLevel))">
                            <option value="">Select Class Level</option>
                            @foreach (var level in availableClassLevels)
                            {
                                <option value="@level">@level.ToDisplayName()</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Term:</label>
                        <select class="form-select" @bind="staffTerm" @bind:after="OnStaffFiltersChanged"
                                disabled="@(string.IsNullOrEmpty(staffClassLevel))">
                            <option value="">Select Term</option>
                            @foreach (var semester in Enum.GetValues<Semester>())
                            {
                                <option value="@semester">@semester.ToTermDisplay()</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>
    }

    <ul class="nav fcms-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(activeTab == TabTimetable ? "active" : "")"
                    @onclick="() => activeTab = TabTimetable">
                Timetable
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == TabSessions ? "active" : "")"
                    @onclick="() => activeTab = TabSessions">
                Class Sessions
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == TabTwo ? "active" : "")"
                    @onclick="() => activeTab = TabTwo">
                Tab2
            </button>
        </li>
    </ul>

    @if (activeTab == TabTimetable)
    {
        @if (activeClassLevel == ClassLevel.None || activeTerm == null)
        {
            <div class="text-center py-4">
                <i class="fa fa-calendar-week fa-3x text-muted mb-3"></i>
                @if (isStudent)
                {
                    <h5 class="text-muted">You are not enrolled in any class yet</h5>
                    <p class="text-muted">Your timetable will appear here once you are enrolled.</p>
                }
                else
                {
                    @if (StaffFiltersComplete())
                    {
                        <h5 class="text-muted">No class found for this selection</h5>
                        <p class="text-muted">No learning path exists for that year, level and term combination.</p>
                    }
                    else
                    {
                        <h5 class="text-muted">Select a class to view its timetable</h5>
                    }
                }
            </div>
        }
        else
        {
            <div class="card timetable-card">
                <div class="card-body">

                    

                    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap fcms-gap-sm">
                        <button class="btn btn-sm btn-fcms" @onclick="PreviousWeek">
                            <i class="fa fa-arrow-left"></i>
                        </button>
                        <div class="text-center">
                            <strong>@currentWeekStart.ToString("MMM d") - @currentWeekStart.AddDays(5).ToString("MMM d, yyyy")</strong>
                            @if (!IsCurrentWeek())
                            {
                                <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="GoToToday">Today</button>
                            }
                        </div>
                        <button class="btn btn-sm btn-fcms" @onclick="NextWeek">
                            <i class="fa fa-arrow-right"></i>
                        </button>
                    </div>

                    @foreach (var day in GetVisibleDays())
                    {
                        var dayEntries = GetEntriesForDay(day);
                        var isExpanded = expandedDays.Contains(day);

                        <div class="border rounded mb-2">
                            <div class="d-flex justify-content-between align-items-center p-2 fcms-fold-header"
                                 @onclick="() => ToggleDay(day)">
                                <span>
                                    <strong>@day.ToString("dddd, MMMM d")</strong>
                                    <span class="text-muted ms-2">
                                        @(dayEntries.Any() ? $"{dayEntries.Count} class(es)" : "No classes")
                                    </span>
                                </span>
                                @if (day.Date == DateTime.Today)
                                {
                                    <span class="badge fcms-fold-center-badge">Today</span>
                                }
                                <i class="fa @(isExpanded ? "fa-chevron-up" : "fa-chevron-down") text-muted"></i>
                            </div>

                            @if (isExpanded && dayEntries.Any())
                            {
                                <div class="d-flex flex-column p-2 fcms-fold-body">
                                    @foreach (var entry in dayEntries)
                                    {
                                        <div class="d-flex align-items-center rounded fcms-fold-item">

                                            

                                            <div class="flex-grow-1 d-flex justify-content-between align-items-center flex-wrap p-2 fcms-fold-item-main @(entry.ClassSession != null ? "fcms-clickable" : "")"
                                                 @onclick="() => OpenSession(entry)">

                                                <div>
                                                    <strong class="fcms-text-sm">@entry.DateTime.ToString("h:mm tt") - @entry.DateTime.Add(entry.Duration).ToString("h:mm tt")</strong>
                                                    @if (entry.ClassSession != null)
                                                    {
                                                        <span class="ms-2 fcms-text-sm">@entry.ClassSession.Course</span>
                                                        <small class="text-muted d-block fcms-text-xs">@entry.ClassSession.Topic</small>
                                                    }
                                                    else
                                                    {
                                                        <span class="ms-2 fcms-text-sm text-muted">Unassigned</span>
                                                    }
                                                </div>

                                                <small class="text-muted fcms-text-sm">
                                                    <i class="fa fa-location-dot me-1"></i>@entry.Venue
                                                </small>

                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                        </div>
                    }

                </div>
            </div>
        }
    }

    @if (activeTab == TabSessions)
    {
        @if (canManageSessions)
        {
            <ClassSessionsPanel SelectedEducationLevel="SelectedEducationLevel"
                                SelectedClassLevel="SelectedClassLevel"
                                SelectedTerm="SelectedTerm" />
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="fa fa-hourglass-half fa-2x mb-2 fcms-icon-soft"></i>
                <p class="mb-0">Coming soon</p>
            </div>
        }
    }

    @if (activeTab == TabTwo)
    {
        <div class="text-center text-muted py-4">
            <i class="fa fa-hourglass-half fa-2x mb-2 fcms-icon-soft"></i>
            <p class="mb-0">Coming soon</p>
        </div>
    }
</div>



@code {
    private const string TabTimetable = "timetable";
    private const string TabSessions = "sessions";
    private const string TabTwo = "tab2";

    private string activeTab = TabTimetable;

    private Person? currentPerson;
    private bool isStudent = false;
    private bool isGuardian = false;
    private bool isStaffViewer = false;
    private bool canManageSessions = false;

    private Guardian? guardianProfile;
    private int activeWardId = 0;

    private DateTime currentWeekStart;
    private HashSet<DateTime> expandedDays = new();

    private string staffEducationLevel = "";
    private string staffClassLevel = "";
    private string staffTerm = "";
    private string pageHeading = "My Classes";
  
    private List<ClassLevel> availableClassLevels = new();
    private EducationLevel SelectedEducationLevel => Enum.TryParse<EducationLevel>(staffEducationLevel, out var level) ? level : EducationLevel.None;
    private ClassLevel SelectedClassLevel => Enum.TryParse<ClassLevel>(staffClassLevel, out var level) ? level : ClassLevel.None;
    private Semester? SelectedTerm => Enum.TryParse<Semester>(staffTerm, out var term) ? term : null;
    private ClassLevel activeClassLevel = ClassLevel.None;
    private Semester? activeTerm;
    private List<ClassSchedule> termSchedules = new();

    protected override async Task OnInitializedAsync()
    {
        currentPerson = await PermissionService.GetCurrentPersonAsync();

        if (currentPerson == null)
        {
            NavigationManager.NavigateTo("/Account/Login", true);
            return;
        }

        isStudent = await PermissionService.IsInRoleAsync("Student");
        isGuardian = await PermissionService.IsInRoleAsync("Guardian");
        isStaffViewer = await PermissionService.IsInAnyRoleAsync("Developer", "Principal", "Admin", "Teacher");
        canManageSessions = await PermissionService.IsInAnyRoleAsync("Developer", "Principal", "Admin");

        if (isStudent)
        {
            var student = SchoolDataService.GetStudentByPersonId(currentPerson.Id);
            SetActiveClass(student?.LearningPathId ?? 0);
        }

        if (isGuardian)
        {
            guardianProfile = SchoolDataService.GetGuardianByPersonId(currentPerson.Id);

            if (guardianProfile != null && guardianProfile.Wards.Any())
            {
                SelectWard(guardianProfile.Wards.First().Id);
            }
        }

        LoadTimetable();
        GoToToday();
    }

    private void SelectWard(int wardId)
    {
        activeWardId = wardId;
        var ward = guardianProfile?.Wards.FirstOrDefault(w => w.Id == wardId);
        SetActiveClass(ward?.LearningPathId ?? 0);
        LoadTimetable();
        GoToToday();
    }

    private void SetActiveClass(int learningPathId)
    {
        activeClassLevel = ClassLevel.None;
        activeTerm = null;
        pageHeading = "My Classes";

        if (learningPathId <= 0)
            return;

        var path = SchoolDataService.GetLearningPathsForList()
            .FirstOrDefault(p => p.Id == learningPathId);

        if (path == null)
            return;

        activeClassLevel = path.ClassLevel;
        activeTerm = path.Semester;
        pageHeading = $"{path.ClassLevel.ToDisplayName()} Classes";
    }

    private void LoadTimetable()
    {
        termSchedules = activeClassLevel != ClassLevel.None && activeTerm != null
            ? SchoolDataService.GetClassSchedules(activeClassLevel, activeTerm.Value)
            : new List<ClassSchedule>();
    }

    private void ResolveStaffPath()
    {
        activeClassLevel = SelectedClassLevel;
        activeTerm = SelectedTerm;

        LoadTimetable();
        GoToToday();
    }

    private static DateTime GetWeekStart(DateTime date)
    {
        return date.AddDays(-(((int)date.DayOfWeek + 6) % 7)).Date;
    }

    private bool IsCurrentWeek()
    {
        return currentWeekStart == GetWeekStart(DateTime.Today);
    }

    private void GoToToday()
    {
        currentWeekStart = GetWeekStart(DateTime.Today);
        expandedDays = new HashSet<DateTime> { DateTime.Today };
    }

    private void PreviousWeek()
    {
        currentWeekStart = currentWeekStart.AddDays(-7);
        ResetExpansionForWeek();
    }

    private void NextWeek()
    {
        currentWeekStart = currentWeekStart.AddDays(7);
        ResetExpansionForWeek();
    }

    private void ResetExpansionForWeek()
    {
        expandedDays = IsCurrentWeek()
            ? new HashSet<DateTime> { DateTime.Today }
            : new HashSet<DateTime>();
    }

    private void ToggleDay(DateTime day)
    {
        if (expandedDays.Contains(day))
        {
            expandedDays.Remove(day);
        }
        else
        {
            expandedDays.Add(day);
        }
    }

    private List<DateTime> GetVisibleDays()
    {
        var days = new List<DateTime>();

        for (var i = 0; i < 7; i++)
        {
            var day = currentWeekStart.AddDays(i);
            var isSchoolDay = i < 5;

            if (isSchoolDay || GetEntriesForDay(day).Any())
            {
                days.Add(day);
            }
        }

        return days;
    }

    private List<ClassSchedule> GetEntriesForDay(DateTime day)
    {
        return termSchedules
            .Where(se => se.DateTime.Date == day.Date)
            .OrderBy(se => se.DateTime.TimeOfDay)
            .ToList();
    }

    private void OpenSession(ClassSchedule entry)
    {
        if (entry.ClassSession != null)
        {
            NavigationManager.NavigateTo($"/classsession/details/{entry.ClassSession.Id}");
        }
    }

    private void OnStaffFiltersChanged()
    {
        availableClassLevels = new List<ClassLevel>();
        if (Enum.TryParse<EducationLevel>(staffEducationLevel, out var eduLevel))
        {
            availableClassLevels = LogicMethods.GetAvailableClassLevels(eduLevel);
        }

        if (!string.IsNullOrEmpty(staffClassLevel) && availableClassLevels.All(cl => cl.ToString() != staffClassLevel))
        {
            staffClassLevel = "";
            staffTerm = "";
        }

        ResolveStaffPath();
    }

    private bool StaffFiltersComplete()
    {
        return !string.IsNullOrEmpty(staffEducationLevel) &&
               !string.IsNullOrEmpty(staffClassLevel) &&
               !string.IsNullOrEmpty(staffTerm);
    }
}
