<div class="modal fade show" style="display: @(IsVisible ? "block" : "none");" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content fcms-modal-panel">
            <div class="modal-body">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="modal-title fcms-picker-title mb-0">YouTube Video</h5>
                    <button type="button" class="fcms-picker-close" @onclick="Close">
                        <i class="fa fa-times"></i>
                    </button>
                </div>

                <div class="mb-3">
                    <label class="form-label">Title (optional)</label>
                    <input type="text" class="form-control" @bind="title" placeholder="e.g., Introduction to Fractions" />
                </div>
                <div class="mb-2">
                    <label class="form-label">YouTube link</label>
                    <input type="text" class="form-control" @bind="url" placeholder="https://www.youtube.com/watch?v=..." />
                </div>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <p class="small text-danger mb-0">@errorMessage</p>
                }

                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-secondary me-2" @onclick="Close">Cancel</button>
                    <button type="button" class="btn btn-fcms" @onclick="Save">Save</button>
                </div>
            </div>
        </div>
    </div>
</div>

@if (IsVisible)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string InitialTitle { get; set; } = string.Empty;
    [Parameter] public string InitialUrl { get; set; } = string.Empty;
    [Parameter] public EventCallback<(string Title, string Url)> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private string title = string.Empty;
    private string url = string.Empty;
    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        title = InitialTitle;
        url = InitialUrl;
    }

    private async Task Save()
    {
        if (!Util.IsValidYouTubeUrl(url))
        {
            errorMessage = "Please enter a valid YouTube link.";
            return;
        }

        await OnSave.InvokeAsync((title, url));
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
