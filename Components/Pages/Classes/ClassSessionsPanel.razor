@using FcmsPortal
@using FcmsPortal.Constants
@using FcmsPortal.Enums
@using FcmsPortal.Models
@using FcmsPortalUI.DTOs
@using FcmsPortalUI.Services
@using FcmsPortalUI.Components.Pages.Shared
@inject ISchoolDataService SchoolDataService

@if (SelectedClassLevel == ClassLevel.None || SelectedTerm == null)
{
    <div class="text-center py-4">
        <i class="fa fa-book-open fa-3x text-muted mb-3"></i>
        <h5 class="text-muted">Select a class level and term to view its sessions</h5>
    </div>
}
else
{
    <div class="card fcms-tab-card mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center flex-wrap mb-3 fcms-gap-sm">
                <button class="btn btn-sm btn-primary" @onclick="OpenCreate">
                    <i class="fa fa-plus me-1"></i>Add Session
                </button>

                <select class="form-select form-select-sm w-auto ms-auto" @bind="courseFilter">
                    <option value="">All courses</option>
                    @foreach (var course in courses)
                    {
                        <option value="@course">@course</option>
                    }
                </select>
            </div>

            @if (!VisibleSessions.Any())
            {
                <p class="text-muted mb-0">No sessions yet for this selection.</p>
            }
            else
            {
                <p class="mb-2"><strong>@VisibleSessions.Count</strong> session(s)</p>
                <div class="table-responsive">
                    <table class="table table-striped table-hover fcms-grid">
                        <thead>
                            <tr>
                                
                                <th>Session No.</th>
                                <th>Course</th>
                                <th>Topic</th>
                                <th>Teacher</th>
                                <th>Date</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in PagedSessions)
                            {
                                <tr @key="session.Id" class="@RowClass(session)">
                                   
                                    <td>@Util.GetClassSessionCode(SelectedClassLevel, SelectedTerm!.Value, session.Course, session.SessionNumber)</td>
                                    <td>@session.Course</td>
                                    <td>@session.Topic</td>
                                    <td>
                                        @if (session.TeacherName == null)
                                        {
                                            <span class="badge bg-warning text-dark">No teacher</span>
                                        }
                                        else
                                        {
                                            @session.TeacherName
                                        }
                                    </td>
                                    <td>
                                        @if (session.ScheduledAt == null)
                                        {
                                            <span class="badge bg-secondary">Not scheduled</span>
                                        }
                                        else
                                        {
                                            @session.ScheduledAt.Value.ToString("ddd, MMM d, yyyy h:mm tt")
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-secondary me-1" title="Details"
                                                @onclick="() => OpenDetails(session)">
                                            <i class="fa fa-eye"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-warning me-1" title="Edit"
                                                @onclick="() => OpenEdit(session.Id)">
                                            <i class="fa fa-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" title="Delete"
                                                @onclick="() => AskDelete(session)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }

                        </tbody>
                    </table>
                    @if (PageCount > 1)
                    {
                        <div class="d-flex align-items-center justify-content-between mt-3">
                            <button class="btn btn-sm btn-fcms" disabled="@(page == 0)" @onclick="PreviousPage">
                                <i class="fa fa-arrow-left"></i>
                            </button>
                            <span class="fcms-text-xs">Page @(page + 1) of @PageCount</span>
                            <button class="btn btn-sm btn-fcms" disabled="@(page >= PageCount - 1)" @onclick="NextPage">
                                <i class="fa fa-arrow-right"></i>
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

<ClassSessionDetailModal IsVisible="showDetailModal"
                         Session="detailSession"
                         ClassLevel="SelectedClassLevel"
                         Term="@(SelectedTerm ?? Semester.First)"
                         OnClose="() => showDetailModal = false" />

<ClassSessionFormModal IsVisible="showFormModal"
                       ClassSessionId="editingSessionId"
                       EducationLevel="SelectedEducationLevel"
                       ClassLevel="SelectedClassLevel"
                       Term="@(SelectedTerm ?? Semester.First)"
                       OnSaved="HandleSaved"
                       OnClose="() => showFormModal = false" />

<ConfirmDeleteModal IsVisible="showDeleteConfirmation"
                    Title="Delete Sessions"
                    Message="@deleteMessage"
                    OnConfirm="ConfirmDelete"
                    OnCancel="() => showDeleteConfirmation = false" />

<ErrorDisplayModal IsVisible="showErrorModal"
                   Title="Not allowed"
                   Message="@errorMessage"
                   OnClose="() => showErrorModal = false" />

@code {
    [Parameter] public EducationLevel SelectedEducationLevel { get; set; }
    [Parameter] public ClassLevel SelectedClassLevel { get; set; }
    [Parameter] public Semester? SelectedTerm { get; set; }

    private List<ClassSessionListItem> sessions = new();
    private List<string> courses = new();
    private string courseFilter = string.Empty;
    private ClassLevel loadedClassLevel = ClassLevel.None;
    private Semester? loadedTerm;
    private ClassSessionListItem? detailSession;
    private bool showDetailModal = false;
    private ClassSessionListItem? sessionToDelete;
    private bool showFormModal = false;
    private int editingSessionId = 0;
    private bool showDeleteConfirmation = false;
    private string deleteMessage = string.Empty;

    private int page = 0;

    private List<ClassSessionListItem> PagedSessions => VisibleSessions
        .Skip(page * FcmsConstants.LIST_PAGE_SIZE)
        .Take(FcmsConstants.LIST_PAGE_SIZE)
        .ToList();

    private int PageCount => Math.Max(1, (VisibleSessions.Count + FcmsConstants.LIST_PAGE_SIZE - 1) / FcmsConstants.LIST_PAGE_SIZE);

    private void PreviousPage() => page = Math.Max(0, page - 1);

    private void NextPage() => page = Math.Min(PageCount - 1, page + 1);

    private List<ClassSessionListItem> VisibleSessions => string.IsNullOrEmpty(courseFilter)
        ? sessions
        : sessions.Where(s => s.Course == courseFilter).ToList();

    private void ResetPage() => page = 0;

    protected override void OnParametersSet()
    {
        ResetPage();

        if (SelectedClassLevel == loadedClassLevel && SelectedTerm == loadedTerm)
            return;

        loadedClassLevel = SelectedClassLevel;
        loadedTerm = SelectedTerm;
        courseFilter = string.Empty;
        courses = CourseDefaults.GetCourseNames(SelectedEducationLevel);
      
        LoadSessions();
    }

    private string RowClass(ClassSessionListItem session)
    {
        var state = LogicMethods.GetSessionState(session.ScheduledAt, session.ScheduledEnd - session.ScheduledAt, session.ClosedAt, DateTime.Now);

        if (state == SessionState.Completed)
            return "fcms-session-closed";

        if (state == SessionState.InProgress)
            return "fcms-session-in-progress";

        return "";
    }

    private void LoadSessions()
    {
        sessions = new List<ClassSessionListItem>();

        if (SelectedClassLevel == ClassLevel.None || SelectedTerm == null)
            return;

        sessions = SchoolDataService.GetClassSessionList(SelectedClassLevel, SelectedTerm.Value);
    }

    private void OpenCreate()
    {
        editingSessionId = 0;
        showFormModal = true;
    }

    private void OpenDetails(ClassSessionListItem session)
    {
        detailSession = session;
        showDetailModal = true;
    }

    private void OpenEdit(int sessionId)
    {
        editingSessionId = sessionId;
        showFormModal = true;
    }

    private void AskDelete(ClassSessionListItem session)
    {
        sessionToDelete = session;
        deleteMessage = $"Delete {Util.GetClassSessionCode(SelectedClassLevel, SelectedTerm!.Value, session.Course, session.SessionNumber)}? Its homework, discussions and study materials will be deleted too.";
        showDeleteConfirmation = true;
    }

    private async Task ConfirmDelete()
    {
        showDeleteConfirmation = false;

        if (sessionToDelete == null)
            return;

        try
        {
            await SchoolDataService.DeleteClassSessionsAsync(new List<int> { sessionToDelete.Id });
            page = 0;
            LoadSessions();
        }
        catch (BusinessRuleException ex)
        {
            errorMessage = ex.Message;
            showErrorModal = true;
        }

        sessionToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        await SchoolDataService.DeleteClassSessionsAsync(selectedIds.ToList());
        showDeleteConfirmation = false;
        LoadSessions();
        ResetPage();
    }

    private void HandleSaved()
    {
        showFormModal = false;
        LoadSessions();
        ResetPage();
    }
}
