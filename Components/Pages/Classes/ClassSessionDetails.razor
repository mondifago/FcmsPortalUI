    private void SaveRemark(string remark)
    {
        var submittedByName = currentUser != null ? Util.GetFullName(currentUser) : string.Empty;
        SchoolDataService.SaveTeacherRemarks(classSession.Id, remark, submittedByName);
        showRemarkModal = false;
        LoadCurrentRecord();
        LoadRemarkRecords();
