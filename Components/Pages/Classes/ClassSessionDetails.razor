@page "/classsession/details/{Id:int}"
@using FcmsPortalUI.Services
@using FcmsPortal.Models
@using FcmsPortal
@using FcmsPortal.Enums
@using FcmsPortal.Constants
@using FcmsPortalUI.Components.Pages.Shared
@inject ISchoolDataService SchoolDataService
@inject IPermissionService PermissionService
@inject NavigationManager NavigationManager

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3 fcms-gap-sm">
        <h2>Class Session</h2>
        <div class="d-flex flex-wrap fcms-gap-sm">
            <button class="btn btn-secondary" @onclick="GoBack">
                <i class="fa fa-arrow-left"></i> Back
            </button>
        </div>
    </div>

    @if (classSession == null)
    {
        <div class="d-flex justify-content-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else
    {
        <div class="fcms-info-strip mb-4">
            <div>
                <span class="fcms-info-label">Course</span>
                <span class="fcms-info-value">@classSession.Course</span>
            </div>
            <div>
                <span class="fcms-info-label">Topic</span>
                <span class="fcms-info-value">@classSession.Topic</span>
            </div>
            <div>
                <span class="fcms-info-label">Teacher</span>
                <span class="fcms-info-value">
                    @if (classSession.Teacher != null)
                    {
                        @($"{classSession.Teacher.Person.FirstName} {classSession.Teacher.Person.LastName}")
                    }
                    else
                    {
                        <span class="text-muted">Not assigned</span>
                    }
                </span>
            </div>
            <div>
                <span class="fcms-info-label">Date &amp; Time</span>
                <span class="fcms-info-value">
                    @(scheduleEntry != null ? scheduleEntry.DateTime.ToString("MMM d, yyyy h:mm tt") : "No schedule")
                </span>
            </div>
            <div>
                <span class="fcms-info-label">Venue</span>
                <span class="fcms-info-value">
                    @(scheduleEntry != null ? scheduleEntry.Venue : "-")
                </span>
            </div>

            <div>
                <span class="fcms-info-label">Term</span>
                <span class="fcms-info-value">
                    @if (isInCurrentPeriod)
                    {
                        @(currentPeriod?.DisplayName)
                    }
                    else
                    {
                        @($"Runs in {classSession.Semester} Term")
                    }
                </span>
            </div>
            @if (isInCurrentPeriod)
            {
                <div>
                    <span class="fcms-info-label">Status</span>
                    <div class="d-flex align-items-center flex-wrap fcms-gap-sm">
                        <span class="@Util.GetSessionStateBadgeClass(sessionState)">@sessionState</span>
                        @if (canManageClassSession && canEditYearActivity && sessionState == SessionState.InProgress)
                        {
                            <button class="btn btn-sm btn-success" @onclick="() => showCloseConfirmation = true">
                                <i class="fa fa-check me-1"></i>Close Session
                            </button>
                        }
                        @if (currentRecord?.ClosedAt != null)
                        {
                            <small>Closed by @currentRecord.ClosedByName on @currentRecord.ClosedAt.Value.ToString("MMM d, yyyy h:mm tt")</small>
                        }
                    </div>
                </div>
            }

            <div class="fcms-info-wide">
                <span class="fcms-info-label">Description</span>
                <span class="fcms-info-value">
                    @(string.IsNullOrEmpty(classSession.Description) ? "No description available" : classSession.Description)
                </span>
            </div>
        </div>

        <ul class="nav fcms-tabs mb-3">
            <li class="nav-item">
                <button class="nav-link @(activeTab == TabSession ? "active" : "")"
                        @onclick="() => activeTab = TabSession">
                    Class Session
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == TabMaterials ? "active" : "")"
                        @onclick="() => activeTab = TabMaterials">
                    Course Materials
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == TabHomework ? "active" : "")"
                        @onclick="OpenHomeworkTab">
                    Homework
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link @(activeTab == TabLessonPlan ? "active" : "")"
                        @onclick="() => activeTab = TabLessonPlan">
                    Lesson Plan
                </button>
            </li>
            <AuthorizeView Roles="Developer,Principal,Admin,Teacher">
                <Authorized Context="remarksTab">
                    <li class="nav-item">
                        <button class="nav-link @(activeTab == TabRemarks ? "active" : "")"
                                @onclick="OpenRemarksTab">
                            Teacher's Remarks
                        </button>
                    </li>
                </Authorized>
            </AuthorizeView>
        </ul>

        @if (activeTab == TabSession)
        {
            <div class="row">
                <!-- Discussion Section -->
                <div class="col-md-8">
                    <div class="fcms-tab-card rounded-3 p-3 mb-4">
                        <DiscussionThreadComponent AllThreads="currentRecord?.DiscussionThreads ?? new List<DiscussionThread>()"
                                                   AllowReplies="canEditYearActivity"
                                                   CurrentUser="currentUser"
                                                   ClassSessionId="classSession.Id" />
                    </div>
                </div>

                <!-- Student list Section -->
                <div class="col-md-4">
                    <div class="card fcms-tab-card mb-4">
                        <div class="card-header">
                            <h4 class="mb-0">Students in Class</h4>
                        </div>
                        <div class="card-body">
                            @if (!enrolledStudents.Any())
                            {
                                <p class="text-muted">No students in this class.</p>
                            }

                            @if (enrolledStudents.Any() && (relatedLearningPath?.AttendanceLog == null || !relatedLearningPath.AttendanceLog.Any()))
                            {
                                <p class="text-muted">Attendance not yet taken for this class.</p>
                            }

                            @if (enrolledStudents.Any() && relatedLearningPath?.AttendanceLog != null && relatedLearningPath.AttendanceLog.Any())
                            {
                                var sessionAttendance = relatedLearningPath.AttendanceLog.FirstOrDefault();

                                <div class="list-group">
                                    @foreach (var student in enrolledStudents)
                                    {
                                        bool isPresent = sessionAttendance?.PresentStudents?.Any(s => s.Id == student.Id) == true;
                                        bool isAbsent = sessionAttendance?.AbsentStudents?.Any(s => s.Id == student.Id) == true;

                                        <div class="list-group-item d-flex justify-content-between align-items-center">
                                            <div>
                                                <AuthorizeView Roles="Developer,Principal,Admin,Teacher">
                                                    <Authorized>
                                                        <a href="/students/details/@student.Id" class="text-decoration-none">
                                                            @student.Person.FirstName @student.Person.LastName
                                                        </a>
                                                    </Authorized>
                                                    <NotAuthorized>
                                                        <span>@student.Person.FirstName @student.Person.LastName</span>
                                                    </NotAuthorized>
                                                </AuthorizeView>
                                            </div>
                                            <div>
                                                @if (isPresent)
                                                {
                                                    <span class="badge bg-success">P</span>
                                                }
                                                @if (isAbsent && !isPresent)
                                                {
                                                    <span class="badge bg-danger">A</span>
                                                }
                                                @if (!isPresent && !isAbsent)
                                                {
                                                    <span class="badge bg-secondary">-</span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (activeTab == TabMaterials)
        {
            <div class="fcms-tab-card rounded-3 p-3 mb-4">
                <div class="row">
                    <div class="col-md-8 mb-3">
                        @if (isVideoSelected)
                        {
                            <div class="ratio ratio-16x9 rounded-3 overflow-hidden">
                                <iframe src="@Util.GetYouTubeEmbedUrl(classSession.VideoUrl)"
                                        title="@(classSession.VideoTitle ?? "Video Lesson")"
                                        frameborder="0"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen>
                                </iframe>
                            </div>
                        }
                        @if (isPdfSelected)
                        {
                            <div class="ratio ratio-4x3 rounded-3 overflow-hidden">
                                <embed src="@selectedMaterial?.FilePath" type="application/pdf" />
                            </div>
                        }
                        @if (isImageSelected)
                        {
                            <div class="ratio ratio-4x3">
                                <img src="@selectedMaterial?.FilePath" alt="@selectedMaterial?.FileName" class="object-fit-contain rounded-3" />
                            </div>
                        }
                        @if (isOtherSelected)
                        {
                            <div class="text-center py-5">
                                <i class="@Util.GetFileIcon(selectedMaterial?.FileName ?? string.Empty) fa-3x mb-3"></i>
                                <p>@selectedMaterial?.FileName</p>
                                <a href="@selectedMaterial?.FilePath" download="@selectedMaterial?.FileName" class="btn btn-fcms">
                                    <i class="fa fa-download me-1"></i>Download
                                </a>
                            </div>
                        }
                        @if (!isVideoSelected && selectedMaterial == null)
                        {
                            <div class="text-center py-5">
                                <i class="fa fa-folder-open fa-3x mb-3"></i>
                                <p class="mb-0">No materials yet.</p>
                            </div>
                        }
                    </div>

                    <div class="col-md-4">
                        @if (hasMaterials || canManageClassSession)
                        {
                            <div class="d-flex align-items-center mb-3">
                                @if (hasMaterials)
                                {
                                    <h5 class="mb-0">Study Materials</h5>
                                }
                                @if (canManageClassSession)
                                {
                                    <InputFile id="materialUpload" class="d-none" multiple OnChange="UploadMaterials" />
                                    <label for="materialUpload" title="Upload files"
                                           class="btn btn-fcms fcms-btn-round ms-auto @(isUploadingMaterials ? "disabled" : "")">
                                        <i class="fa @(isUploadingMaterials ? "fa-spinner fa-spin" : "fa-upload")"></i>
                                    </label>
                                    @if (string.IsNullOrEmpty(classSession.VideoUrl))
                                    {
                                        <button type="button" class="btn btn-outline-fcms fcms-btn-round ms-1" title="Add YouTube video"
                                                @onclick="() => showVideoModal = true">
                                            <i class="fab fa-youtube"></i>
                                        </button>
                                    }
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(materialErrorMessage))
                        {
                            <p class="small text-danger mb-2">@materialErrorMessage</p>
                        }

                        @if (!string.IsNullOrEmpty(classSession.VideoUrl))
                        {
                            <div class="d-flex align-items-center mb-2">
                                <button type="button" title="@classSession.VideoTitle"
                                        class="btn rounded-pill text-start text-truncate flex-grow-1 me-2 @(isVideoSelected ? "btn-fcms" : "btn-outline-fcms border-0")"
                                        @onclick="SelectVideo">
                                    <i class="fab fa-youtube me-2"></i>@(classSession.VideoTitle ?? "Video Lesson")
                                </button>
                                @if (canManageClassSession)
                                {
                                    <button type="button" class="btn btn-outline-fcms fcms-btn-round flex-shrink-0 me-1" title="Edit"
                                            @onclick="() => showVideoModal = true">
                                        <i class="fa fa-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-fcms fcms-btn-round flex-shrink-0" title="Remove"
                                            @onclick="AskDeleteVideo">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                }
                            </div>
                        }

                        @foreach (var material in classSession.StudyMaterials)
                        {
                            <div class="d-flex align-items-center mb-2" @key="material.Id">
                                <button type="button" title="@material.FileName"
                                        class="btn rounded-pill text-start text-truncate flex-grow-1 me-2 @(selectedMaterial == material ? "btn-fcms" : "btn-outline-fcms border-0")"
                                        @onclick="() => SelectMaterial(material)">
                                    <i class="@Util.GetFileIcon(material.FileName) me-2"></i>@material.FileName
                                </button>
                                <a href="@material.FilePath" download="@material.FileName" title="Download"
                                   class="btn btn-outline-fcms fcms-btn-round flex-shrink-0 me-1">
                                    <i class="fa fa-download"></i>
                                </a>
                                @if (canManageClassSession)
                                {
                                    <button type="button" class="btn btn-outline-fcms fcms-btn-round flex-shrink-0" title="Delete"
                                            @onclick="() => AskDeleteMaterial(material)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (activeTab == TabHomework)
        {
            <div class="fcms-tab-card rounded-3 p-3 mb-4">
                <div class="row">
                    <div class="@(canManageClassSession ? "col-md-8" : "col-12") mb-3">
                        @if (currentHomework == null)
                        {
                            <div class="text-center py-5">
                                <i class="fa fa-book-open fa-3x mb-3"></i>
                                <p class="mb-3">No homework for this session yet.</p>
                                @if (canManageClassSession && canEditYearActivity)
                                {
                                    <button type="button" class="btn btn-fcms fcms-btn-round" title="Add homework" @onclick="OpenNewHomework">
                                        <i class="fa fa-plus"></i>
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-start mb-2">
                                <div>
                                    <h5 class="mb-1">@currentHomework.Title</h5>
                                    <small>Due @currentHomework.DueDate.ToString("ddd, MMM d") · out of @currentHomework.MaxScore</small>
                                </div>
                                @if (canManageClassSession && canEditYearActivity && !currentHomework.Submissions.Any())
                                {
                                    <button type="button" class="btn btn-outline-fcms fcms-btn-round ms-auto me-1" title="Edit" @onclick="OpenEditHomework">
                                        <i class="fa fa-pencil"></i>
                                    </button>
                                    <button type="button" class="btn btn-outline-fcms fcms-btn-round" title="Delete" @onclick="() => AskDeleteHomework(currentHomework)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                }
                            </div>

                            <div class="formatted-content fcms-scroll-area mb-4">
                                @((MarkupString)Util.FormatTextWithLinks(currentHomework.Question))
                            </div>

                            @if (isStudent)
                            {
                                var mySubmission = MySubmission;

                                @if (mySubmission == null && canEditYearActivity)
                                {
                                    <CharacterCountTextArea @bind-Value="answerDraft"
                                                            MaxLength="FcmsConstants.MAX_HOMEWORK_ANSWER_LENGTH"
                                                            Rows="5"
                                                            ShowEmojiPicker="false"
                                                            Placeholder="Write your answer">
                                        <Actions>
                                            <button type="button" class="btn btn-fcms fcms-btn-round" title="Submit answer" @onclick="SubmitAnswer">
                                                <i class="fas fa-paper-plane"></i>
                                            </button>
                                        </Actions>
                                    </CharacterCountTextArea>
                                }
                                @if (mySubmission == null && !canEditYearActivity)
                                {
                                    <p class="mb-0">Submissions are closed for this session.</p>
                                }
                                @if (mySubmission != null && isEditingAnswer)
                                {
                                    <CharacterCountTextArea @bind-Value="answerDraft"
                                                            MaxLength="FcmsConstants.MAX_HOMEWORK_ANSWER_LENGTH"
                                                            Rows="5"
                                                            ShowEmojiPicker="false"
                                                            Placeholder="Write your answer">
                                        <Actions>
                                            <button type="button" class="btn btn-outline-fcms fcms-btn-round me-1" title="Cancel" @onclick="() => isEditingAnswer = false">
                                                <i class="fa fa-times"></i>
                                            </button>
                                            <button type="button" class="btn btn-fcms fcms-btn-round" title="Save answer" @onclick="() => SaveAnswerEdit(mySubmission)">
                                                <i class="fas fa-paper-plane"></i>
                                            </button>
                                        </Actions>
                                    </CharacterCountTextArea>
                                }
                                @if (mySubmission != null && !isEditingAnswer)
                                {
                                    <div class="d-flex align-items-center mb-2">
                                        <h6 class="mb-0">Your answer</h6>
                                        <small class="ms-2" title="@mySubmission.SubmissionDate.ToString("MMM dd, yyyy HH:mm")">
                                            Submitted @Util.FormatTimeAgo(mySubmission.SubmissionDate, DateTime.Now)
                                        </small>
                                        @if (!mySubmission.IsGraded && canEditYearActivity)
                                        {
                                            <button type="button" class="btn btn-outline-fcms fcms-btn-round ms-auto" title="Edit answer" @onclick="() => StartEditAnswer(mySubmission)">
                                                <i class="fa fa-pencil"></i>
                                            </button>
                                        }
                                    </div>
                                    <div class="formatted-content fcms-scroll-area mb-3">
                                        @((MarkupString)Util.FormatTextWithLinks(mySubmission.Answer))
                                    </div>
                                    @if (mySubmission.IsGraded && mySubmission.HomeworkGrade != null)
                                    {
                                        <div class="d-flex align-items-center">
                                            <span class="btn btn-fcms rounded-pill pe-none">
                                                @LogicMethods.ToHomeworkScale(mySubmission.HomeworkGrade.Score, currentHomework.MaxScore) / @currentHomework.MaxScore
                                            </span>
                                            @if (!string.IsNullOrWhiteSpace(mySubmission.FeedbackComment))
                                            {
                                                <span class="ms-3">@mySubmission.FeedbackComment</span>
                                            }
                                        </div>
                                    }
                                }
                            }

                            @if (canManageClassSession)
                            {
                                var rows = SubmissionRows;

                                <div class="d-flex flex-wrap fcms-gap-sm mb-3">
                                    <button type="button" class="btn btn-sm rounded-pill @SubmissionFilterClass(null)"
                                            @onclick="() => submissionFilter = null">
                                        All @rows.Count
                                    </button>
                                    <button type="button" class="btn btn-sm rounded-pill @SubmissionFilterClass(HomeworkSubmissionStatus.ToGrade)"
                                            @onclick="() => submissionFilter = HomeworkSubmissionStatus.ToGrade">
                                        To grade @(rows.Count(r => r.Status == HomeworkSubmissionStatus.ToGrade))
                                    </button>
                                    <button type="button" class="btn btn-sm rounded-pill @SubmissionFilterClass(HomeworkSubmissionStatus.Graded)"
                                            @onclick="() => submissionFilter = HomeworkSubmissionStatus.Graded">
                                        Graded @(rows.Count(r => r.Status == HomeworkSubmissionStatus.Graded))
                                    </button>
                                    <button type="button" class="btn btn-sm rounded-pill @SubmissionFilterClass(HomeworkSubmissionStatus.NotSubmitted)"
                                            @onclick="() => submissionFilter = HomeworkSubmissionStatus.NotSubmitted">
                                        Not submitted @(rows.Count(r => r.Status == HomeworkSubmissionStatus.NotSubmitted))
                                    </button>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-striped table-hover fcms-grid">
                                        <thead>
                                            <tr>
                                                <th>Student</th>
                                                <th>Submitted</th>
                                                <th>Status</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var row in rows.Where(r => submissionFilter == null || r.Status == submissionFilter))
                                            {
                                                <tr @key="row.Student.Id">
                                                    <td>@Util.GetFullName(row.Student.Person)</td>
                                                    <td>
                                                        @if (row.Submission != null)
                                                        {
                                                            <span title="@row.Submission.SubmissionDate.ToString("MMM dd, yyyy HH:mm")">
                                                                @Util.FormatTimeAgo(row.Submission.SubmissionDate, DateTime.Now)
                                                            </span>
                                                            @if (LogicMethods.IsLateSubmission(row.Submission.SubmissionDate, currentHomework.DueDate))
                                                            {
                                                                <span class="text-danger ms-1">Late</span>
                                                            }
                                                        }
                                                    </td>
                                                    <td>@SubmissionStatusText(row)</td>
                                                    <td class="text-end">
                                                        @if (row.Submission != null)
                                                        {
                                                            <button class="btn btn-sm btn-outline-warning" title="@(canEditYearActivity ? "Grade" : "View")"
                                                                    @onclick="() => gradingSubmission = row.Submission">
                                                                <i class="fa @(canEditYearActivity ? "fa-pencil" : "fa-eye")"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>

                    @if (canManageClassSession)
                    {
                        <div class="col-md-4 fcms-split-divider ps-md-4">
                            <h5 class="mb-3">Homework History</h5>
                            @if (!pastHomework.Any())
                            {
                                <p class="mb-0">No past homework yet.</p>
                            }
                            @foreach (var past in pastHomework)
                            {
                                <div class="d-flex align-items-center mb-2" @key="past.Id">
                                    <button type="button" title="@past.Title"
                                            class="btn btn-outline-fcms border-0 rounded-pill text-start text-truncate flex-grow-1 me-2"
                                            @onclick="() => ViewPastHomework(past)">
                                        <small class="me-2">@past.ClassSessionRecord?.AcademicPeriod?.AcademicYear</small>@past.Title
                                    </button>
                                    @if (canReuseHomework)
                                    {
                                        <button type="button" class="btn btn-outline-fcms fcms-btn-round flex-shrink-0 me-1" title="Use this question"
                                                @onclick="() => OpenReuseHomework(past)">
                                            <i class="fa fa-rotate-left"></i>
                                        </button>
                                    }
                                    @if (canDeletePastRecords)
                                    {
                                        <button type="button" class="btn btn-outline-fcms fcms-btn-round flex-shrink-0" title="Delete"
                                                @onclick="() => AskDeleteHomework(past)">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (activeTab == TabLessonPlan)
        {
            <!-- Lesson Plan Section -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">Lesson Plan</h4>
                    @if (!editingLessonPlan && !string.IsNullOrEmpty(classSession.LessonPlan) && canManageClassSession)
                    {
                        <button class="btn btn-sm btn-light" @onclick="EditLessonPlan">
                            <i class="fa fa-edit"></i> Edit
                        </button>
                    }
                </div>
                <div class="card-body">
                    @if (editingLessonPlan && canManageClassSession)
                    {
                        <EditForm Model="@classSession" OnValidSubmit="SaveLessonPlan">
                            <div class="mb-3">
                                <InputTextArea @bind-Value="classSession.LessonPlan"
                                               class="form-control"
                                               rows="10"
                                               placeholder="Enter your lesson plan content here..." />
                            </div>
                            <div class="d-flex justify-content-end">
                                <button type="button" class="btn btn-secondary me-2" @onclick="CancelLessonPlanEdit">Cancel</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <div class="lesson-plan-content p-3 bg-light rounded" style="min-height: 200px;">
                            @if (!string.IsNullOrEmpty(classSession.LessonPlan))
                            {
                                <div class="formatted-content">
                                    @((MarkupString)Util.FormatTextWithLinks(classSession.LessonPlan))
                                </div>
                            }
                            else
                            {
                                <div class="text-center text-muted my-5">
                                    <i class="fa fa-book-open fa-3x mb-3"></i>
                                    <p>No lesson plan has been created yet.</p>
                                    @if (canManageClassSession)
                                    {
                                        <button class="btn btn-outline-primary mt-2" @onclick="EditLessonPlan">
                                            <i class="fa fa-plus"></i> Create Lesson Plan
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (activeTab == TabRemarks)
        {
            <AuthorizeView Roles="Developer,Principal,Admin,Teacher">
                <Authorized Context="auth">
                    <div class="card fcms-tab-card mb-4">
                        <div class="card-body">
                            @if (canAddRemark)
                            {
                                <div class="d-flex justify-content-end mb-3">
                                    <button class="btn btn-sm btn-fcms" @onclick="OpenAddRemark">
                                        <i class="fa fa-plus me-1"></i>Add Remark
                                    </button>
                                </div>
                            }

                            @if (!remarkRecords.Any())
                            {
                                <p class="text-muted mb-0">No remarks yet.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover fcms-grid">
                                        <thead>
                                            <tr>
                                                <th>Academic Year</th>
                                                <th>Submitted By</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var remarkRecord in remarkRecords)
                                            {
                                                var isCurrentEditable = IsCurrentEditableRemark(remarkRecord);
                                                <tr @key="remarkRecord.Id">
                                                    <td>@remarkRecord.AcademicPeriod?.AcademicYear</td>
                                                    <td>@remarkRecord.RemarksSubmittedByName</td>
                                                    <td class="text-end">
                                                        <button class="btn btn-sm btn-outline-secondary me-1" title="View"
                                                                @onclick="() => OpenViewRemark(remarkRecord)">
                                                            <i class="fa fa-eye"></i>
                                                        </button>
                                                        @if (isCurrentEditable)
                                                        {
                                                            <button class="btn btn-sm btn-outline-warning me-1" title="Edit"
                                                                    @onclick="() => OpenEditRemark(remarkRecord)">
                                                                <i class="fa fa-pencil"></i>
                                                            </button>
                                                        }
                                                        @if (isCurrentEditable || canDeletePastRecords)
                                                        {
                                                            <button class="btn btn-sm btn-outline-danger" title="Delete"
                                                                    @onclick="() => AskDeleteRemark(remarkRecord)">
                                                                <i class="fa fa-trash"></i>
                                                            </button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </Authorized>
            </AuthorizeView>
        }
    }
</div>

<!-- Homework Modal -->
@if (homeworkFormSource != null)
{
    <HomeworkCreationModal IsVisible="true"
                           Heading="@homeworkFormHeading"
                           Source="homeworkFormSource"
                           OnSave="SaveHomework"
                           OnClose="() => homeworkFormSource = null" />
}

@if (gradingSubmission != null && currentHomework != null)
{
    <HomeworkGradingModal IsVisible="true"
                          Submission="gradingSubmission"
                          MaxScore="currentHomework.MaxScore"
                          DueDate="currentHomework.DueDate"
                          IsReadOnly="!canEditYearActivity"
                          OnSave="SaveGrade"
                          OnClose="() => gradingSubmission = null" />
}

<ConfirmDeleteModal IsVisible="showDeleteHomeworkConfirmation"
                    Title="Delete Homework"
                    Message="@($"Delete {homeworkToDelete?.Title}? Any answers submitted to it are deleted too. This can't be undone.")"
                    OnConfirm="ConfirmDeleteHomework"
                    OnCancel="() => showDeleteHomeworkConfirmation = false" />

<ConfirmDeleteModal IsVisible="showCloseConfirmation"
                    Title="Close Session"
                    Message="Close this session? Its remark, homework and discussion will be locked for the rest of this term."
                    ConfirmText="Close Session"
                    ConfirmButtonClass="btn-success"
                    OnConfirm="CloseSession"
                    OnCancel="() => showCloseConfirmation = false" />

<ErrorDisplayModal IsVisible="showErrorModal"
                   Title="Not allowed"
                   Message="@errorMessage"
                   OnClose="() => showErrorModal = false" />

@if (showRemarkModal)
{
    <ClassSessionRemarkModal IsVisible="showRemarkModal"
                             Title="@remarkModalTitle"
                             Subtitle="@remarkModalSubtitle"
                             Remark="@remarkModalText"
                             IsReadOnly="isRemarkReadOnly"
                             OnSubmit="SaveRemark"
                             OnClose="() => showRemarkModal = false" />
}

<ConfirmDeleteModal IsVisible="showDeleteRemarkConfirmation"
                    Title="Delete Remark"
                    Message="@($"Delete the {remarkToDelete?.AcademicPeriod?.AcademicYear} remark? This can't be undone.")"
                    OnConfirm="ConfirmDeleteRemark"
                    OnCancel="() => showDeleteRemarkConfirmation = false" />

@if (showVideoModal)
{
    <VideoLinkModal IsVisible="showVideoModal"
                    InitialTitle="@(classSession.VideoTitle ?? string.Empty)"
                    InitialUrl="@(classSession.VideoUrl ?? string.Empty)"
                    OnSave="SaveVideo"
                    OnClose="() => showVideoModal = false" />
}

<ConfirmDeleteModal IsVisible="showDeleteMaterialConfirmation"
                    Title="@(isDeletingVideo ? "Remove Video" : "Delete Material")"
                    Message="@(isDeletingVideo ? "Remove the video from this session?" : $"Delete {materialToDelete?.FileName}? This can't be undone.")"
                    OnConfirm="ConfirmDeleteMaterial"
                    OnCancel="() => showDeleteMaterialConfirmation = false" />

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    private ClassSession classSession = new();
    private ClassSchedule? scheduleEntry;
    private LearningPath relatedLearningPath = new();
    private List<Student> enrolledStudents = new List<Student>();
    private Staff? currentTeacher;
    private Student currentStudent = new();

    private bool editingLessonPlan = false;

    private Homework? homeworkFormSource;
    private string homeworkFormHeading = string.Empty;
    private HomeworkSubmission? gradingSubmission;
    private Homework? homeworkToDelete;
    private bool showDeleteHomeworkConfirmation;
    private List<Homework> pastHomework = new();
    private bool pastHomeworkLoaded;
    private HomeworkSubmissionStatus? submissionFilter;
    private string answerDraft = string.Empty;
    private bool isEditingAnswer;
    private bool canReuseHomework => canManageClassSession && canEditYearActivity && currentHomework == null;
    private HomeworkSubmission? MySubmission => currentHomework?.Submissions.FirstOrDefault(s => s.StudentId == currentStudent.Id);
    private record SubmissionRow(Student Student, HomeworkSubmission? Submission, HomeworkSubmissionStatus Status);

    private AcademicPeriod? currentPeriod;
    private ClassSessionRecord? currentRecord;
    private Homework? currentHomework => currentRecord?.HomeworkDetails;
    private int? learningPathId;
    private bool canEditYearActivity;

    private Person? currentUser;
    private int? currentUserId;
    private bool canManageClassSession;
    private bool isStudent;

    private bool isInCurrentPeriod;
    private bool showCloseConfirmation = false;
    private bool showErrorModal = false;
    private string errorMessage = string.Empty;
    private SessionState sessionState => LogicMethods.GetSessionState(scheduleEntry?.DateTime, currentRecord?.ClosedAt, DateTime.Now);

    private FileAttachment? selectedMaterial;
    private bool isPdfSelected => selectedMaterial != null && Util.IsPdfFile(selectedMaterial.FileName);
    private bool isImageSelected => selectedMaterial != null && Util.IsImageFile(selectedMaterial.FileName);
    private bool isOtherSelected => selectedMaterial != null && !isPdfSelected && !isImageSelected;
    private bool isUploadingMaterials;
    private string materialErrorMessage = string.Empty;
    private bool showVideoModal;
    private bool showDeleteMaterialConfirmation;
    private FileAttachment? materialToDelete;
    private bool isDeletingVideo;
    private bool isVideoSelected = false;
    private bool hasMaterials => classSession.StudyMaterials.Any() || !string.IsNullOrEmpty(classSession.VideoUrl);

    private const string TabSession = "session";
    private const string TabMaterials = "materials";
    private const string TabHomework = "homework";
    private const string TabLessonPlan = "lessonplan";
    private const string TabRemarks = "remarks";
    private string activeTab = TabSession;

    private List<ClassSessionRecord> remarkRecords = new();
    private bool remarksLoaded;
    private bool canDeletePastRecords;
    private bool showRemarkModal;
    private bool isRemarkReadOnly;
    private string remarkModalTitle = string.Empty;
    private string remarkModalSubtitle = string.Empty;
    private string remarkModalText = string.Empty;
    private bool showDeleteRemarkConfirmation;
    private ClassSessionRecord? remarkToDelete;
    private bool canAddRemark => canEditYearActivity && string.IsNullOrEmpty(currentRecord?.TeacherRemarks);

    private List<SubmissionRow> SubmissionRows
    {
        get
        {
            var submissions = currentHomework?.Submissions ?? new List<HomeworkSubmission>();

            var submitted = submissions
                .Where(sub => sub.Student != null)
                .Select(sub => new SubmissionRow(sub.Student!, sub, LogicMethods.GetHomeworkSubmissionStatus(sub)));

            var notSubmitted = enrolledStudents
                .Where(student => submissions.All(sub => sub.StudentId != student.Id))
                .Select(student => new SubmissionRow(student, null, HomeworkSubmissionStatus.NotSubmitted));

            return submitted.Concat(notSubmitted)
                .OrderBy(row => row.Student.Person.LastName)
                .ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        classSession = SchoolDataService.GetClassSessionById(Id) ?? new ClassSession();

        if (classSession != null)
        {
            scheduleEntry = SchoolDataService.GetClassScheduleByClassSessionId(Id);

            currentUserId = await PermissionService.GetCurrentUserIdAsync();
            currentUser = await PermissionService.GetCurrentPersonAsync();

            if (currentUser != null)
            {
                if (await PermissionService.IsInAnyRoleAsync("Developer", "Principal", "Admin", "Teacher"))
                    currentTeacher = SchoolDataService.GetStaffByPersonId(currentUser.Id);

                if (await PermissionService.IsInRoleAsync("Student"))
                    currentStudent = SchoolDataService.GetStudentByPersonId(currentUser.Id) ?? new Student();
            }

            currentPeriod = SchoolDataService.GetCurrentAcademicPeriod();
            isInCurrentPeriod = LogicMethods.IsSessionInPeriod(classSession.Semester, currentPeriod);

            LoadEnrolledStudents();
            LoadCurrentRecord();
            SelectDefaultMaterial();

            canManageClassSession = await PermissionService.IsInAnyRoleAsync("Developer", "Principal", "Admin", "Teacher");
            canDeletePastRecords = await PermissionService.IsInAnyRoleAsync("Developer", "Principal", "Admin");
            isStudent = await PermissionService.IsInRoleAsync("Student");

        }
    }

    private void LoadEnrolledStudents()
    {
        if (!LogicMethods.IsSessionInPeriod(classSession.Semester, currentPeriod))
            return;

        learningPathId = SchoolDataService.GetLearningPathIdForPeriod(classSession.ClassLevel, currentPeriod.Id);
        if (!learningPathId.HasValue)
            return;

        relatedLearningPath = SchoolDataService.GetLearningPathWithAttendanceForDate(learningPathId.Value, scheduleEntry?.DateTime ?? DateTime.MinValue) ?? new LearningPath();
        enrolledStudents = relatedLearningPath.Students?.ToList() ?? new List<Student>();
    }

    private void LoadCurrentRecord()
    {
        currentRecord = SchoolDataService.GetCurrentClassSessionRecord(classSession.Id);

        var gradesFinalized = learningPathId.HasValue && SchoolDataService.AreLearningPathGradesFinalized(learningPathId.Value);

        canEditYearActivity = LogicMethods.IsSessionInPeriod(classSession.Semester, currentPeriod) &&
                              LogicMethods.IsClassSessionRecordOpen(currentRecord?.ClosedAt, gradesFinalized);
    }

    private void OpenRemarksTab()
    {
        activeTab = TabRemarks;

        if (!remarksLoaded)
            LoadRemarkRecords();
    }

    private void LoadRemarkRecords()
    {
        remarkRecords = SchoolDataService.GetClassSessionRemarkRecords(classSession.Id);
        remarksLoaded = true;
    }

    private bool IsCurrentEditableRemark(ClassSessionRecord remarkRecord)
    {
        return canEditYearActivity && remarkRecord.AcademicPeriodId == currentPeriod?.Id;
    }

    private void OpenAddRemark()
    {
        OpenRemarkModal("Add Remark", currentPeriod?.DisplayName ?? string.Empty, string.Empty, false);
    }

    private void OpenEditRemark(ClassSessionRecord remarkRecord)
    {
        OpenRemarkModal("Edit Remark", remarkRecord.AcademicPeriod?.DisplayName ?? string.Empty, remarkRecord.TeacherRemarks, false);
    }

    private void OpenViewRemark(ClassSessionRecord remarkRecord)
    {
        var subtitle = $"{remarkRecord.AcademicPeriod?.DisplayName} · {remarkRecord.RemarksSubmittedByName} · {remarkRecord.RemarksSubmittedAt:MMM d, yyyy}";
        OpenRemarkModal("Teacher's Remark", subtitle, remarkRecord.TeacherRemarks, true);
    }

    private void OpenRemarkModal(string title, string subtitle, string text, bool readOnly)
    {
        remarkModalTitle = title;
        remarkModalSubtitle = subtitle;
        remarkModalText = text;
        isRemarkReadOnly = readOnly;
        showRemarkModal = true;
    }

    private void SaveRemark(string remark)
    {
        var submittedByName = currentUser != null ? Util.GetFullName(currentUser) : string.Empty;
        SchoolDataService.SaveTeacherRemarks(classSession.Id, remark, submittedByName);
        showRemarkModal = false;
        LoadCurrentRecord();
        LoadRemarkRecords();
    }

    private void AskDeleteRemark(ClassSessionRecord remarkRecord)
    {
        remarkToDelete = remarkRecord;
        showDeleteRemarkConfirmation = true;
    }

    private void ConfirmDeleteRemark()
    {
        showDeleteRemarkConfirmation = false;

        if (remarkToDelete == null)
            return;

        SchoolDataService.DeleteTeacherRemarks(remarkToDelete.Id);
        remarkToDelete = null;
        LoadCurrentRecord();
        LoadRemarkRecords();
    }

    private void GoBack()
    {
        if (!string.IsNullOrEmpty(ReturnUrl))
        {
            NavigationManager.NavigateTo(ReturnUrl);
            return;
        }
        NavigationManager.NavigateTo($"/myclasses");
    }

    private void SaveLessonPlan()
    {
        SchoolDataService.UpdateClassSession(classSession);
        editingLessonPlan = false;
    }

    private void EditLessonPlan()
    {
        editingLessonPlan = true;
    }

    private void CancelLessonPlanEdit()
    {
        editingLessonPlan = false;
    }

    private void OpenHomeworkTab()
    {
        activeTab = TabHomework;

        if (canManageClassSession && !pastHomeworkLoaded)
            LoadPastHomework();
    }

    private void LoadPastHomework()
    {
        pastHomework = SchoolDataService.GetPastHomework(classSession.Id);
        pastHomeworkLoaded = true;
    }

    private void OpenNewHomework()
    {
        homeworkFormHeading = "Add Homework";
        homeworkFormSource = new Homework
        {
            AssignedDate = DateTime.Now,
            DueDate = DateTime.Today.AddDays(FcmsConstants.DEFAULT_HOMEWORK_DUE_DAYS)
        };
    }

    private void OpenEditHomework()
    {
        homeworkFormHeading = "Edit Homework";
        homeworkFormSource = currentHomework;
    }

    private void OpenReuseHomework(Homework past)
    {
        homeworkFormHeading = "Use Past Question";
        homeworkFormSource = new Homework
        {
            Title = past.Title,
            Question = past.Question,
            MaxScore = past.MaxScore,
            AssignedDate = DateTime.Now,
            DueDate = DateTime.Today.AddDays(FcmsConstants.DEFAULT_HOMEWORK_DUE_DAYS)
        };
    }

    private void SaveHomework(Homework homework)
    {
        SchoolDataService.SaveHomework(classSession.Id, homework);
        homeworkFormSource = null;
        LoadCurrentRecord();
    }

    private void ViewPastHomework(Homework past)
    {
        var subtitle = $"{past.ClassSessionRecord?.AcademicPeriod?.DisplayName} · out of {past.MaxScore}";
        OpenRemarkModal(past.Title, subtitle, past.Question, true);
    }

    private void AskDeleteHomework(Homework homework)
    {
        homeworkToDelete = homework;
        showDeleteHomeworkConfirmation = true;
    }

    private void ConfirmDeleteHomework()
    {
        showDeleteHomeworkConfirmation = false;

        if (homeworkToDelete == null)
            return;

        SchoolDataService.DeleteHomework(homeworkToDelete.Id);
        homeworkToDelete = null;
        LoadCurrentRecord();

        if (pastHomeworkLoaded)
            LoadPastHomework();
    }

    private void SubmitAnswer()
    {
        if (currentHomework == null || string.IsNullOrWhiteSpace(answerDraft))
            return;

        SchoolDataService.SubmitHomework(currentHomework.Id, currentStudent, answerDraft);
        answerDraft = string.Empty;
        LoadCurrentRecord();
    }

    private void StartEditAnswer(HomeworkSubmission submission)
    {
        answerDraft = submission.Answer;
        isEditingAnswer = true;
    }

    private void SaveAnswerEdit(HomeworkSubmission submission)
    {
        if (string.IsNullOrWhiteSpace(answerDraft))
            return;

        SchoolDataService.UpdateHomeworkAnswer(submission.Id, answerDraft);
        isEditingAnswer = false;
        answerDraft = string.Empty;
        LoadCurrentRecord();
    }

    private async Task SaveGrade((double Score, string Feedback) grade)
    {
        if (gradingSubmission == null || currentHomework == null || !learningPathId.HasValue)
            return;

        await SchoolDataService.AddHomeworkSubmissionGradeAsync(
            gradingSubmission.StudentId,
            classSession.Course,
            LogicMethods.NormalizeHomeworkScore(grade.Score, currentHomework.MaxScore),
            currentTeacher?.Id,
            grade.Feedback,
            learningPathId.Value,
            currentHomework.AssignedDate,
            gradingSubmission.Id);

        gradingSubmission = null;
        LoadCurrentRecord();
    }

    private string SubmissionFilterClass(HomeworkSubmissionStatus? status)
    {
        return submissionFilter == status ? "btn-fcms" : "btn-outline-fcms";
    }

    private string SubmissionStatusText(SubmissionRow row)
    {
        if (row.Status == HomeworkSubmissionStatus.NotSubmitted)
            return "Not submitted";

        if (row.Status == HomeworkSubmissionStatus.ToGrade)
            return "To grade";

        return $"{LogicMethods.ToHomeworkScale(row.Submission!.HomeworkGrade?.Score ?? 0, currentHomework!.MaxScore)} / {currentHomework.MaxScore}";
    }

    private void SelectDefaultMaterial()
    {
        isVideoSelected = !string.IsNullOrEmpty(classSession.VideoUrl);
        selectedMaterial = isVideoSelected
            ? null
            : classSession.StudyMaterials.FirstOrDefault(m => Util.IsPdfFile(m.FileName) || Util.IsImageFile(m.FileName))
              ?? classSession.StudyMaterials.FirstOrDefault();
    }

    private void SelectVideo()
    {
        isVideoSelected = true;
        selectedMaterial = null;
    }

    private void SelectMaterial(FileAttachment material)
    {
        isVideoSelected = false;
        selectedMaterial = material;
    }

    private async Task UploadMaterials(InputFileChangeEventArgs e)
    {
        materialErrorMessage = string.Empty;
        isUploadingMaterials = true;

        foreach (var file in e.GetMultipleFiles(FcmsConstants.MAX_FILE_UPLOAD_COUNT))
        {
            if (file.Size > FcmsConstants.MAX_FILE_SIZE)
            {
                materialErrorMessage = $"{file.Name} is larger than {FcmsConstants.MAX_FILE_SIZE_MB}MB, so it wasn't uploaded.";
                continue;
            }

            var attachment = await SchoolDataService.UploadFileAsync(file, $"ClassSession-{classSession.Id}-Materials");
            classSession.StudyMaterials.Add(attachment);
        }

        SchoolDataService.UpdateClassSession(classSession);
        isUploadingMaterials = false;

        if (!isVideoSelected && selectedMaterial == null)
            SelectDefaultMaterial();
    }

    private void SaveVideo((string Title, string Url) video)
    {
        classSession.VideoUrl = video.Url;
        classSession.VideoTitle = string.IsNullOrWhiteSpace(video.Title) ? "Video Lesson" : video.Title;
        SchoolDataService.UpdateClassSession(classSession);
        showVideoModal = false;
        SelectVideo();
    }

    private void AskDeleteMaterial(FileAttachment material)
    {
        materialToDelete = material;
        isDeletingVideo = false;
        showDeleteMaterialConfirmation = true;
    }

    private void AskDeleteVideo()
    {
        materialToDelete = null;
        isDeletingVideo = true;
        showDeleteMaterialConfirmation = true;
    }

    private async Task ConfirmDeleteMaterial()
    {
        showDeleteMaterialConfirmation = false;

        if (isDeletingVideo)
        {
            classSession.VideoUrl = null;
            classSession.VideoTitle = null;
            SchoolDataService.UpdateClassSession(classSession);

            if (isVideoSelected)
                SelectDefaultMaterial();
            return;
        }

        if (materialToDelete == null)
            return;

        var wasSelected = selectedMaterial == materialToDelete;
        classSession.StudyMaterials.Remove(materialToDelete);
        await SchoolDataService.DeleteFileAsync(materialToDelete);
        SchoolDataService.UpdateClassSession(classSession);
        materialToDelete = null;

        if (wasSelected)
            SelectDefaultMaterial();
    }

    private void CloseSession()
    {
        showCloseConfirmation = false;

        try
        {
            var closedByName = currentUser != null ? Util.GetFullName(currentUser) : string.Empty;
            SchoolDataService.CloseClassSession(classSession.Id, closedByName);
            LoadCurrentRecord();
        }
        catch (BusinessRuleException ex)
        {
            errorMessage = ex.Message;
            showErrorModal = true;
        }
    }
}
