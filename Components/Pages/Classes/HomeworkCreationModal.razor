@using FcmsPortal.Constants
@using FcmsPortal.Models
@using FcmsPortalUI.Components.Pages.Shared

<div class="modal fade show" style="display: @(IsVisible ? "block" : "none");" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content fcms-modal-panel">
            <div class="modal-body">

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="modal-title fcms-picker-title mb-0">@Heading</h5>
                    <button type="button" class="fcms-picker-close" @onclick="Close">
                        <i class="fa fa-times"></i>
                    </button>
                </div>

                <EditForm Model="homework" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <InputText class="form-control" maxlength="@FcmsConstants.MAX_HOMEWORK_TITLE_LENGTH" @bind-Value="homework.Title" />
                        <ValidationMessage For="@(() => homework.Title)" />
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Due date</label>
                            <InputDate class="form-control" @bind-Value="homework.DueDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Out of</label>
                            <InputNumber class="form-control" @bind-Value="homework.MaxScore" />
                            <ValidationMessage For="@(() => homework.MaxScore)" />
                        </div>
                    </div>

                    <label class="form-label">Question</label>
                    <CharacterCountTextArea @bind-Value="homework.Question"
                                            MaxLength="FcmsConstants.MAX_HOMEWORK_QUESTION_LENGTH"
                                            Rows="8"
                                            ShowEmojiPicker="false"
                                            Placeholder="Write the homework question" />
                    <ValidationMessage For="@(() => homework.Question)" />

                    <div class="d-flex justify-content-end mt-3">
                        <button type="button" class="btn btn-secondary me-2" @onclick="Close">Cancel</button>
                        <button type="submit" class="btn btn-fcms">Save</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@if (IsVisible)
{
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public string Heading { get; set; } = string.Empty;
    [Parameter] public Homework Source { get; set; } = new();
    [Parameter] public EventCallback<Homework> OnSave { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Homework homework = new();

    protected override void OnInitialized()
    {
        homework = new Homework
        {
            Id = Source.Id,
            Title = Source.Title,
            Question = Source.Question,
            MaxScore = Source.MaxScore,
            AssignedDate = Source.AssignedDate,
            DueDate = Source.DueDate
        };
    }

    private async Task Save()
    {
        await OnSave.InvokeAsync(homework);
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}