@page "/archive"
@using FcmsPortal.Models
@using FcmsPortalUI.Services
@inject ISchoolDataService SchoolDataService
@rendermode InteractiveServer

<PageTitle>Archive Center</PageTitle>

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-3 fcms-gap-sm">
        <h2>Archive Center</h2>
    </div>

    <ul class="nav fcms-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(activeTab == TabPayments ? "active" : "")"
                    @onclick="() => activeTab = TabPayments">
                Payment Archive
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == TabAttendance ? "active" : "")"
                    @onclick="() => activeTab = TabAttendance">
                Attendance
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == TabGrades ? "active" : "")"
                    @onclick="() => activeTab = TabGrades">
                Grades
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeTab == TabGraduated ? "active" : "")"
                    @onclick="() => activeTab = TabGraduated">
                Graduated Students
            </button>
        </li>
    </ul>

    @if (activeTab == TabPayments)
    {
        <div class="card fcms-tab-card mb-4">
            <div class="card-body">
                <ul class="nav nav-pills fcms-subtabs mb-3">
                    <li class="nav-item">
                        <button class="nav-link @(activePaymentView == PayStudents ? "active" : "")"
                                @onclick="() => activePaymentView = PayStudents">
                            Student Payments
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activePaymentView == PayLearningPaths ? "active" : "")"
                                @onclick="() => activePaymentView = PayLearningPaths">
                            Learning Path Payments
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link @(activePaymentView == PaySchool ? "active" : "")"
                                @onclick="() => activePaymentView = PaySchool">
                            School Summaries
                        </button>
                    </li>
                </ul>

                @if (activePaymentView == PayStudents)
                {
                    <PaymentsArchivePanel />
                }

                @if (activePaymentView == PayLearningPaths)
                {
                    <LearningPathPaymentArchivePanel />
                }

                @if (activePaymentView == PaySchool)
                {
                    <SchoolPaymentArchivePanel />
                }
            </div>
        </div>
    }

    @if (activeTab == TabAttendance)
    {
        <div class="card fcms-tab-card mb-4">
            <div class="card-body">
                <ArchivedAttendancePanel />
            </div>
        </div>
    }

    @if (activeTab == TabGrades)
    {
        <div class="card fcms-tab-card mb-4">
            <div class="card-body">
                <GradesArchivePanel />
            </div>
        </div>
    }

    @if (activeTab == TabGraduated)
    {
        <div class="card fcms-tab-card mb-4">
            <div class="card-body">
                <GraduatedStudentsPanel />
            </div>
        </div>
    }
</div>

@code {
    private const string TabPayments = "payments";
    private const string TabAttendance = "attendance";
    private const string TabGrades = "grades";
    private const string TabGraduated = "graduated";

    private const string PayStudents = "students";
    private const string PayLearningPaths = "learningpaths";
    private const string PaySchool = "school";

    private string activeTab = TabPayments;
    private string activePaymentView = PayStudents;
}