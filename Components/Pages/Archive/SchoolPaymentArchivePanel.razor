@using FcmsPortal.Models
@using FcmsPortal.Enums
@using FcmsPortalUI.Services
@using FcmsPortalUI.Components.Pages.Shared
@using System.Globalization
@inject ISchoolDataService SchoolDataService

<div>
    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label">Academic Year</label>
                    <select class="form-select"
                            @bind="selectedAcademicYear"
                            @bind:after="LoadArchive">

                        <option value="">-- Select Academic Year --</option>
                        @foreach (var year in academicYears)
                        {
                            <option value="@year">@year</option>
                        }
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Term</label>
                    <select class="form-select"
                            @bind="selectedSemester"
                            @bind:after="LoadArchive">

                        @foreach (var sem in Enum.GetValues(typeof(Semester)))
                        {
                            <option value="@sem">@sem</option>
                        }
                    </select>
                </div>

            </div>
        </div>
    </div>

    @if (showResults && summary == null)
    {
        <p class="text-muted">No archived school payment data found for the selected filters.</p>
    }

    @if (showResults && summary != null)
    {
        <!-- KPI + REPORT CARD -->
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">School Payment Analytics</h5>
            </div>

            <div class="card-body">

                <!-- ROW 1 -->
                <div class="row g-3 mb-3">

                    <!-- Brought Forward -->
                    <div class="col-md-3">
                        <div class="card border shadow-sm p-3 h-100">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa fa-history text-warning fs-3"></i>
                                <div>
                                    <p class="kpi-title">Total Brought Forward</p>
                                    <p class="kpi-value text-warning">
                                        @summary.TotalBroughtForwardOutstanding.ToString("C", new CultureInfo("en-NG"))
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Expected Revenue -->
                    <div class="col-md-3">
                        <div class="card border shadow-sm p-3 h-100">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa fa-money-bill-wave text-primary fs-3"></i>
                                <div>
                                    <p class="kpi-title">Total Expected Revenue</p>
                                    <p class="kpi-value">
                                        @summary.TotalExpectedRevenue.ToString("C", new CultureInfo("en-NG"))
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Amount Received -->
                    <div class="col-md-3">
                        <div class="card border shadow-sm p-3 h-100">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa fa-coins text-success fs-3"></i>
                                <div>
                                    <p class="kpi-title">Total Amount Received</p>
                                    <p class="kpi-value text-success">
                                        @summary.TotalAmountReceived.ToString("C", new CultureInfo("en-NG"))
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Outstanding Balance -->
                    <div class="col-md-3">
                        <div class="card border shadow-sm p-3 h-100">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa fa-wallet text-danger fs-3"></i>
                                <div>
                                    <p class="kpi-title">Total Outstanding</p>
                                    <p class="kpi-value text-danger">
                                        @summary.TotalOutstandingBalance.ToString("C", new CultureInfo("en-NG"))
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- ROW 2 -->
                <div class="row g-3 mb-3">

                    <!-- Payment Completion Rate -->
                    <div class="col-md-6">
                        <div class="card border shadow-sm p-3 h-100">
                            <p class="kpi-title mb-1">Payment Completion Rate</p>
                            <div class="progress">
                                <div class="progress-bar bg-info"
                                     style="width:@summary.SchoolWidePaymentCompletionRate%">
                                </div>
                            </div>
                            <p class="kpi-bar-value text-info">
                                @summary.SchoolWidePaymentCompletionRate.ToString("F2")%
                            </p>
                        </div>
                    </div>

                    <!-- Timely Completion Rate -->
                    <div class="col-md-6">
                        <div class="card border shadow-sm p-3 h-100">
                            <p class="kpi-title mb-1">Timely Completion Rate</p>
                            <div class="progress">
                                <div class="progress-bar bg-warning"
                                     style="width:@summary.SchoolWideTimelyCompletionRate%">
                                </div>
                            </div>
                            <p class="kpi-bar-value text-warning">
                                @summary.SchoolWideTimelyCompletionRate.ToString("F2")%
                            </p>
                        </div>
                    </div>

                </div>

                <!-- ROW 3 -->
                <div class="row g-3 mb-3">

                    <!-- Learning Paths -->
                    <div class="col-md-3">
                        <div class="card border shadow-sm p-3 h-100">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa fa-layer-group text-primary fs-3"></i>
                                <div>
                                    <p class="kpi-title">Learning Paths</p>
                                    <p class="kpi-value">@summary.TotalLearningPaths</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Total Students -->
                    <div class="col-md-3">
                        <div class="card border shadow-sm p-3 h-100">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa fa-users text-info fs-3"></i>
                                <div>
                                    <p class="kpi-title">Total Students</p>
                                    <p class="kpi-value">@summary.TotalStudents</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Fully Paid Students -->
                    <div class="col-md-3">
                        <div class="card border shadow-sm p-3 h-100">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa fa-check-circle text-success fs-3"></i>
                                <div>
                                    <p class="kpi-title">Fully Paid Students</p>
                                    <p class="kpi-value text-success">@summary.FullyPaidStudents</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Students With Balance -->
                    <div class="col-md-3">
                        <div class="card border shadow-sm p-3 h-100">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa fa-exclamation-circle text-warning fs-3"></i>
                                <div>
                                    <p class="kpi-title">Students With Balance</p>
                                    <p class="kpi-value text-warning">@summary.StudentsWithBalance</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- BUTTON INSIDE SAME CARD -->
                <div class="d-flex justify-content-center mt-2 mb-2">
                    <button class="btn btn-primary btn-lg" @onclick="ShowSchoolReport">
                        <i class="fa fa-file-alt me-2"></i> Generate School Report
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<SchoolPaymentReportModal 
    IsVisible="showSchoolReport"
    ArchiveEntry="summary"
    OnClose="CloseSchoolReport" />

@code {
    private ArchivedSchoolPaymentSummary? summary;
    private List<string> academicYears = new();
    private Semester selectedSemester = Semester.First;
    private string? selectedAcademicYear;
    private bool showSchoolReport = false;
    private bool showResults = false;

    protected override void OnInitialized()
    {
        academicYears = SchoolDataService.GetArchivedLearningPathAcademicYears(); 
    }

    private void LoadArchive()
    {
        if (string.IsNullOrEmpty(selectedAcademicYear))
        {
            summary = null;
            showResults = false;
            return;
        }

        summary = SchoolDataService.GetArchivedSchoolPaymentSummary(selectedAcademicYear, selectedSemester);
        showResults = true;
    }

    private void ShowSchoolReport()
    {
        showSchoolReport = true;
    }

    private void CloseSchoolReport()
    {
        showSchoolReport = false;
    }
}

