@page "/students"
@inject ISchoolDataService SchoolDataService
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.QuickGrid
@using FcmsPortal
@using FcmsPortal.Models
@using FcmsPortal.Enums
@using FcmsPortal.Constants
@using FcmsPortalUI.Services
@using FcmsPortalUI.DTOs
@using FcmsPortalUI.Components.Pages.Shared
@rendermode InteractiveServer

<PageTitle>Students</PageTitle>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Students</h2>
        <AuthorizeView Roles="Developer,Principal,Admin">
            <Authorized>
                <div class="mb-3">
                    <button @onclick="ShowGuardianSelectionModal" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Add New Student
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
    <div class="card mb-4">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <label for="educationLevel" class="form-label">Education Level:</label>
                    <select class="form-select" id="educationLevel"
                            @bind="selectedEducationLevel"
                            @bind:after="OnEducationLevelFilterChanged">
                        <option value="">Select Education Level</option>
                        @foreach (var level in Enum.GetValues(typeof(EducationLevel)).Cast<EducationLevel>().Where(e => e != EducationLevel.None))
                        {
                            <option value="@level">@level.ToDisplayName()</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="classLevel" class="form-label">Class Level:</label>
                    <select class="form-select" id="classLevel"
                            @bind="selectedClassLevel"
                            @bind:after="FilterStudents">
                        <option value="">Select Class Level</option>
                        @foreach (var level in availableClassLevelsForFilter)
                        {
                            <option value="@level">@level.ToDisplayName()</option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (!filtersApplied)
    {
        <div class="alert alert-info">
            <i class="fa fa-info-circle me-2"></i>
            Please select filters to view students.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body">
                <AuthorizeView Roles="Developer,Principal,Admin">
                    <Authorized>
                        <div class="d-flex align-items-center flex-wrap mb-2" style="gap:0.5rem;">
                            @if (!selectMode)
                            {
                                <button class="btn btn-sm btn-outline-secondary" @onclick="EnterSelectMode">
                                    <i class="fa fa-check-square me-1"></i>Select
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-warning" disabled="@(selectedIds.Count != 1)" @onclick="EditSelected">
                                    <i class="fa fa-pencil me-1"></i>Edit
                                </button>
                                <button class="btn btn-sm btn-primary" disabled="@(selectedIds.Count != 1)" @onclick="AccountSelected">
                                    <i class="fa fa-user me-1"></i>Account
                                </button>
                                <button class="btn btn-sm btn-danger" disabled="@(!selectedIds.Any())" @onclick="DeleteSelected">
                                    <i class="fa fa-trash me-1"></i>Delete (@selectedIds.Count)
                                </button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="ExitSelectMode">
                                    <i class="fa fa-times me-1"></i>Cancel
                                </button>
                            }
                        </div>
                    </Authorized>
                </AuthorizeView>

                <div class="table-responsive">
                    <QuickGrid Items="itemsQuery" Pagination="pagination" Class="table table-striped fcms-grid">
                        @if (selectMode)
                        {
                            <TemplateColumn Title="">
                                <input type="checkbox"
                                       checked="@selectedIds.Contains(context.Id)"
                                       @onchange="e => ToggleSelection(context.Id, e)" />
                            </TemplateColumn>
                        }

                        <TemplateColumn Title="Name">
                            <a href="/students/details/@context.Id" class="grid-name-link">
                                <ListThumbnail ImageUrl="@context.ProfilePictureUrl" Initials="@context.Initials" />
                                @context.FullName
                            </a>
                        </TemplateColumn>

                        <PropertyColumn Property="@(s => s.Age)" Title="Age" Class="d-none d-md-table-cell" />

                        <TemplateColumn Title="Education Level" Class="d-none d-md-table-cell">
                            @context.EducationLevel.ToDisplayName()
                        </TemplateColumn>

                        <TemplateColumn Title="Class Level" Class="d-none d-md-table-cell">
                            @context.ClassLevel.ToDisplayName()
                        </TemplateColumn>

                        <TemplateColumn Title="Status">
                            <span class="badge @(context.IsActive ? "bg-success" : "bg-danger")">
                                @(context.IsActive ? "Active" : "Inactive")
                            </span>
                            <span class="badge @(context.IsEnrolled ? "bg-success" : "bg-danger")">
                                @(context.IsEnrolled ? "Enrolled" : "Not Enrolled")
                            </span>
                        </TemplateColumn>
                    </QuickGrid>
                </div>

                <div class="d-flex justify-content-between align-items-center mt-2">
                    <button class="btn btn-sm btn-fcms"
                            disabled="@(pagination.CurrentPageIndex == 0)"
                            @onclick="PreviousPage">
                        <i class="fa fa-arrow-left"></i>
                    </button>
                    <small class="text-muted">Page @(pagination.CurrentPageIndex + 1) of @((pagination.LastPageIndex ?? 0) + 1)</small>
                    <button class="btn btn-sm btn-fcms"
                            disabled="@(pagination.CurrentPageIndex >= (pagination.LastPageIndex ?? 0))"
                            @onclick="NextPage">
                        <i class="fa fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    }

    <ErrorDisplayModal IsVisible="showErrorModal"
                       Title="Delete Error"
                       Message="@errorMessage"
                       OnClose="CloseErrorModal" />

    <ConfirmDeleteModal IsVisible="showDeleteConfirmation"
                        Title="Confirm Delete"
                        Message="@deleteMessage"
                        OnConfirm="ConfirmDelete"
                        OnCancel="CancelDelete" />

    <GuardianSelectionModal IsVisible="showGuardianSelectionModal"
                            OnGuardianSelected="HandleGuardianSelected"
                            OnClose="CloseGuardianSelectionModal" />

</div>

@code {
    private IQueryable<StudentListItem>? itemsQuery;
    private PaginationState pagination = new() { ItemsPerPage = FcmsConstants.LIST_PAGE_SIZE };

    private bool selectMode = false;
    private HashSet<int> selectedIds = new();

    private List<ClassLevel> availableClassLevelsForFilter = new();
    private string selectedEducationLevel = "";
    private string selectedClassLevel = "";
    private bool filtersApplied = false;

    private bool showDeleteConfirmation = false;
    private bool showGuardianSelectionModal = false;
    private bool showErrorModal = false;
    private string errorMessage = "";
    private string deleteMessage = "";

    protected override void OnInitialized()
    {
        pagination.TotalItemCountChanged += (sender, eventArgs) => InvokeAsync(StateHasChanged);
    }

    private void OnEducationLevelFilterChanged()
    {
        selectedClassLevel = "";

        if (!string.IsNullOrEmpty(selectedEducationLevel) &&
            Enum.TryParse<EducationLevel>(selectedEducationLevel, out var eduLevel))
        {
            availableClassLevelsForFilter = LogicMethods.GetAvailableClassLevels(eduLevel);
        }
        else
        {
            availableClassLevelsForFilter = new List<ClassLevel>();
        }

        FilterStudents();
    }

    private void FilterStudents()
    {
        filtersApplied = !string.IsNullOrEmpty(selectedEducationLevel) ||
                         !string.IsNullOrEmpty(selectedClassLevel);

        if (!filtersApplied)
        {
            itemsQuery = null;
            return;
        }

        var query = SchoolDataService.GetStudentsForList();

        if (!string.IsNullOrEmpty(selectedEducationLevel) &&
            Enum.TryParse<EducationLevel>(selectedEducationLevel, out var eduLevel))
        {
            query = query.Where(s => s.EducationLevel == eduLevel);
        }

        if (!string.IsNullOrEmpty(selectedClassLevel) &&
            Enum.TryParse<ClassLevel>(selectedClassLevel, out var classLevel))
        {
            query = query.Where(s => s.ClassLevel == classLevel);
        }

        itemsQuery = query;
    }

    private void EnterSelectMode()
    {
        selectMode = true;
        selectedIds.Clear();
    }

    private void ExitSelectMode()
    {
        selectMode = false;
        selectedIds.Clear();
    }

    private void ToggleSelection(int id, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;

        if (isChecked)
        {
            selectedIds.Add(id);
        }
        else
        {
            selectedIds.Remove(id);
        }
    }

    private void EditSelected()
    {
        NavigationManager.NavigateTo($"/students/edit/{selectedIds.First()}");
    }

    private void AccountSelected()
    {
        NavigationManager.NavigateTo($"/students/account/{selectedIds.First()}");
    }

    private void DeleteSelected()
    {
        deleteMessage = $"Are you sure you want to delete {selectedIds.Count} student(s)?";
        showDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
    }

    private async Task ConfirmDelete()
    {
        var failures = new List<string>();

        foreach (var id in selectedIds.ToList())
        {
            try
            {
                var result = await SchoolDataService.DeleteStudentAsync(id);
                if (result)
                {
                    selectedIds.Remove(id);
                }
            }
            catch (BusinessRuleException ex)
            {
                failures.Add(ex.Message);
            }
        }

        if (failures.Any())
        {
            errorMessage = string.Join(" ", failures);
            showErrorModal = true;
        }

        FilterStudents();
        showDeleteConfirmation = false;
        StateHasChanged();
    }

    private async Task PreviousPage()
    {
        await pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex - 1);
    }

    private async Task NextPage()
    {
        await pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex + 1);
    }

    private void ShowGuardianSelectionModal()
    {
        showGuardianSelectionModal = true;
    }

    private void CloseGuardianSelectionModal()
    {
        showGuardianSelectionModal = false;
    }

    private void HandleGuardianSelected(Guardian selectedGuardian)
    {
        NavigationManager.NavigateTo($"/students/create?guardianId={selectedGuardian.Id}");
    }

    private void CloseErrorModal()
    {
        showErrorModal = false;
        errorMessage = "";
    }
}