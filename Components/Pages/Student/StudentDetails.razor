@page "/students/details/{Id:int}"
@inject ISchoolDataService SchoolDataService
@inject NavigationManager NavigationManager
@using FcmsPortal
@using FcmsPortalUI.Services
@using FcmsPortalUI.DTOs
@using FcmsPortal.Models
@using FcmsPortalUI.Components.Pages.Shared
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Student Details</PageTitle>

<div class="container">
    @if (student == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>Student Details</h1>
            <div>
                <AuthorizeView Roles="Developer,Principal,Admin,Teacher">
                    <Authorized>
                        @if (!IsStudentInLearningPath())
                        {
                            <button class="btn btn-success" @onclick="ShowLearningPathModal">
                                <i class="fa fa-graduation-cap"></i> Add to Learning Path
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-danger me-2" @onclick="ShowRemoveConfirmation">
                                Remove from Learning Path
                            </button>
                        }
                    </Authorized>
                </AuthorizeView>

                <AuthorizeView Roles="Developer,Principal,Admin">
                    <Authorized>
                        <a href="/students/account/@Id" class="btn btn-primary me-2">
                            <i class="fa fa-user"></i> Account
                        </a>
                        <a href="/students/edit/@Id" class="btn btn-warning">
                            <i class="fa fa-pencil"></i> Edit
                        </a>
                    </Authorized>
                </AuthorizeView>

                <a href="/students" class="btn btn-secondary">
                    <i class="fa fa-arrow-left"></i> Back to List
                </a>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card mb-4">
                    <div class="card-body text-center">
                        <ProfileThumbnailDetail Person="student.Person" />

                        <p class="text-muted">@student.Person.ClassLevel.ToDisplayName()</p>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0">Guardian</h5>
                    </div>
                    <div class="card-body">
                        @if (guardian != null)
                        {
                            <div class="d-flex align-items-center mb-2">
                                <a href="/guardians/details/@guardian.Id">
                                    @Util.GetFullName(guardian.Person)
                                </a>
                                <span class="badge bg-info ms-2">@guardian.RelationshipToStudent</span>
                            </div>
                            <div class="small text-muted">
                                <div><i class="fa fa-envelope me-1"></i> @guardian.Person.Email</div>
                                <div><i class="fa fa-phone me-1"></i> @guardian.Person.PhoneNumber</div>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No guardian associated with this student.</p>
                        }
                    </div>
                </div>
                <AuthorizeView Roles="Developer,Principal,Admin">
                    <Authorized>

                        @if (currentFees != null)
                        {
                            <div class="card fcms-tab-card fcms-payment-panel mt-4">
                                <div class="card-body">

                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div>
                                            <h5 class="mb-0">Current Academic Period</h5>
                                            <small class="text-muted">
                                                @Util.GetLearningPathName(currentFees.LearningPath!)
                                            </small>
                                        </div>
                                        @if (student!.LearningPath == null)
                                        {
                                            <span class="badge bg-secondary">Not Enrolled</span>
                                        }
                                    </div>

                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between align-items-center py-1">
                                            <span class="fcms-figure-label">Fees</span>
                                            <span class="fcms-figure">₦@currentFees.TotalAmount.ToString("N2")</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center py-1">
                                            <span class="fcms-figure-label">Paid</span>
                                            <span class="fcms-figure text-success">₦@currentFees.TotalPaid.ToString("N2")</span>
                                        </div>
                                        <div class="d-flex justify-content-between align-items-center py-1">
                                            <span class="fcms-figure-label">Balance</span>
                                            <span class="fcms-figure @(currentFees.Balance > 0 ? "text-danger" : "text-success")">
                                                ₦@currentFees.Balance.ToString("N2")
                                            </span>
                                        </div>
                                    </div>

                                    <div class="fcms-breakdown">
                                        <div class="d-flex justify-content-between py-1">
                                            <span>Term fee</span>
                                            <span>₦@((currentFees.LearningPath?.FeePerSemester ?? 0).ToString("N2"))</span>
                                        </div>

                                        @if (currentFees.TotalAdjustments > 0)
                                        {
                                            <div class="d-flex justify-content-between py-1 text-primary">
                                                <span><i class="fa fa-tag me-1"></i>Adjustments</span>
                                                <span>&minus; ₦@currentFees.TotalAdjustments.ToString("N2")</span>
                                            </div>
                                        }

                                        <div class="d-flex justify-content-between py-1 border-top fw-bold">
                                            <span>Payable this term</span>
                                            <span>₦@currentFees.TotalAmount.ToString("N2")</span>
                                        </div>

                                        @if (broughtForward != 0)
                                        {
                                            <div class="d-flex justify-content-between py-1 @(broughtForward > 0 ? "text-danger" : "text-success")">
                                                <span>@(broughtForward > 0 ? "Brought forward" : "Credit brought forward")</span>
                                                <span>₦@Math.Abs(broughtForward).ToString("N2")</span>
                                            </div>

                                            <div class="d-flex justify-content-between py-2 border-top fs-5 fw-bold">
                                                <span>Total outstanding</span>
                                                <span class="@((currentFees.Balance + broughtForward) > 0 ? "text-danger" : "text-success")">
                                                    ₦@((currentFees.Balance + broughtForward).ToString("N2"))
                                                </span>
                                            </div>
                                        }
                                    </div>

                                    @if (student.LearningPath != null)
                                    {
                                        <div class="mt-3">
                                            <button class="btn btn-primary" @onclick="NavigateToManagePayments">
                                                <i class="fa fa-file-invoice-dollar me-1"></i> Manage Payments
                                            </button>
                                        </div>
                                    }

                                </div>
                            </div>
                        }

                        @if (previousFees.Any())
                        {
                            <div class="card fcms-tab-card fcms-payment-panel mt-4">
                                <div class="card-body">

                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                        <h5 class="mb-0">Previous Academic Periods</h5>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => showHistoryModal = true">
                                            <i class="fa fa-clock-rotate-left me-1"></i>View History
                                        </button>
                                    </div>

                                    <div class="row text-center g-2">
                                        <div class="col-4">
                                            <div class="fcms-figure-label">Terms</div>
                                            <div class="fcms-figure">@previousFees.Count</div>
                                        </div>
                                        <div class="col-4">
                                            <div class="fcms-figure-label">Total Paid</div>
                                            <div class="fcms-figure text-success">
                                                ₦@previousFees.Sum(fees => fees.TotalPaid).ToString("N2")
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="fcms-figure-label">@(previousOutstanding < 0 ? "Credit" : "Outstanding")</div>
                                            <div class="fcms-figure @(previousOutstanding > 0 ? "text-danger" : "text-success")">
                                                ₦@Math.Abs(previousOutstanding).ToString("N2")
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>
                        }

                    </Authorized>
                </AuthorizeView>
            </div>

            <div class="col-md-8">
                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Personal Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">Gender</h6>
                                <p>@student.Person.Sex</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">Date of Birth</h6>
                                <p>@student.Person.DateOfBirth.ToString("MMMM d, yyyy")</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">State of Origin</h6>
                                <p>@(string.IsNullOrEmpty(student.Person.StateOfOrigin) ? "Not Specified" : student.Person.StateOfOrigin)</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">LGA of Origin</h6>
                                <p>@(string.IsNullOrEmpty(student.Person.LgaOfOrigin) ? "Not Specified" : student.Person.LgaOfOrigin)</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">Position Among Siblings</h6>
                                <p>@(string.IsNullOrEmpty(student.PositionAmongSiblings) ? "Not Specified" : student.PositionAmongSiblings)</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">Last School Attended</h6>
                                <p>@(string.IsNullOrEmpty(student.LastSchoolAttended) ? "Not Specified" : student.LastSchoolAttended)</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">Email</h6>
                                <p>@(string.IsNullOrEmpty(student.Person.Email) ? "Not Specified" : student.Person.Email)</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">Phone Number</h6>
                                <p>@(string.IsNullOrEmpty(student.Person.PhoneNumber) ? "Not Specified" : student.Person.PhoneNumber)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Academic Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">Education Level</h6>
                                <p>@student.Person.EducationLevel.ToDisplayName()</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">Class Level</h6>
                                <p>@student.Person.ClassLevel.ToDisplayName()</p>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">Date of Enrollment</h6>
                                <p>@student.Person.DateOfEnrollment.ToString("MMMM d, yyyy")</p>
                            </div>
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">Status</h6>
                                <p>
                                    @if (student.Person.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactive</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Contact Information</h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <h6 class="text-muted">Emergency Contact</h6>
                                <p>@(string.IsNullOrEmpty(student.Person.EmergencyContact) ? "Not Specified" : student.Person.EmergencyContact)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Address Information</h5>
                    </div>
                    <div class="card-body">
                        @if (student.Person.Address != null)
                        {
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <h6 class="text-muted mb-1">Street</h6>
                                    <p class="mb-0">@(string.IsNullOrEmpty(student.Person.Address.Street) ? "Not Specified" : student.Person.Address.Street)</p>
                                </div>

                                <div class="col-md-4">
                                    <h6 class="text-muted mb-1">City</h6>
                                    <p class="mb-0">@(string.IsNullOrEmpty(student.Person.Address.City) ? "Not Specified" : student.Person.Address.City)</p>
                                </div>

                                <div class="col-md-4">
                                    <h6 class="text-muted mb-1">State</h6>
                                    <p class="mb-0">@(string.IsNullOrEmpty(student.Person.Address.State) ? "Not Specified" : student.Person.Address.State)</p>
                                </div>

                                <div class="col-md-4">
                                    <h6 class="text-muted mb-1">Postal Code</h6>
                                    <p class="mb-0">@(string.IsNullOrEmpty(student.Person.Address.PostalCode) ? "Not Specified" : student.Person.Address.PostalCode)</p>
                                </div>

                                <div class="col-md-4">
                                    <h6 class="text-muted mb-1">Country</h6>
                                    <p class="mb-0">@(string.IsNullOrEmpty(student.Person.Address.Country) ? "Not Specified" : student.Person.Address.Country)</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No address information available.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@if (showLearningPathModal)
{
    <div class="modal show" style="display: block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Student to Learning Path</h5>
                    <button type="button" class="btn-close" @onclick="CloseLearningPathModal"></button>
                </div>
                <div class="modal-body">
                    @if (availableLearningPaths == null || !availableLearningPaths.Any())
                    {
                        <p>No matching learning paths available for this student.</p>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label for="selectedLearningPath" class="form-label">Select Learning Path</label>
                            <select id="selectedLearningPath" class="form-select" @bind="selectedLearningPathId">
                                <option value="0">-- Select Learning Path --</option>
                                @foreach (var lp in availableLearningPaths)
                                {
                                    <option value="@lp.Id">
                                        @lp.EducationLevel - @lp.ClassLevel (@lp.AcademicYear) Semester @lp.Semester.ToTermDisplay()
                                    </option>
                                }
                            </select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseLearningPathModal">Cancel</button>
                    <button type="button" class="btn btn-primary" @onclick="AddStudentToSelectedLearningPath"
                            disabled="@(selectedLearningPathId == 0)">
                        Add Student
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (showHistoryModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal show" style="display:block;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Payment History</h5>
                    <button type="button" class="btn-close" @onclick="() => showHistoryModal = false"></button>
                </div>
                <div class="modal-body">
                    @foreach (var fees in previousFees)
                    {
                        <div class="fcms-fold-item mb-2">
                            <div class="fcms-fold-header d-flex justify-content-between align-items-center"
                                 role="button"
                                 @onclick="() => ToggleFold(fees.Id)">
                                <div class="fcms-fold-item-main">
                                    <strong>@fees.LearningPath?.AcademicYear</strong>
                                    <small class="text-muted">@fees.LearningPath?.Semester.ToTermDisplay()</small>
                                </div>
                                <div class="d-flex align-items-center fcms-gap-sm">
                                    <span class="@(fees.Balance > 0 ? "text-danger" : "text-success")">
                                        ₦@fees.Balance.ToString("N2")
                                    </span>
                                    <i class="fa @(expandedFoldId == fees.Id ? "fa-chevron-up" : "fa-chevron-down")"></i>
                                </div>
                            </div>

                            @if (expandedFoldId == fees.Id)
                            {
                                <div class="fcms-fold-body small">
                                    <div class="d-flex justify-content-between py-1">
                                        <span>Term fee</span>
                                        <span>₦@((fees.LearningPath?.FeePerSemester ?? 0).ToString("N2"))</span>
                                    </div>
                                    @if (fees.TotalAdjustments > 0)
                                    {
                                        <div class="d-flex justify-content-between py-1 text-primary">
                                            <span>Adjustments</span>
                                            <span>&minus; ₦@fees.TotalAdjustments.ToString("N2")</span>
                                        </div>
                                    }
                                    <div class="d-flex justify-content-between py-1">
                                        <span>Payable</span>
                                        <span>₦@fees.TotalAmount.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1 text-success">
                                        <span>Paid</span>
                                        <span>₦@fees.TotalPaid.ToString("N2")</span>
                                    </div>
                                    <div class="d-flex justify-content-between py-1 border-top fw-bold">
                                        <span>Carried forward</span>
                                        <span class="@(fees.Balance > 0 ? "text-danger" : "text-success")">
                                            ₦@fees.Balance.ToString("N2")
                                        </span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showHistoryModal = false">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showRemoveConfirmation)
{
    <div class="modal show" style="display: block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">
                        <i class="fa fa-exclamation-triangle"></i> Remove from Learning Path
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseRemoveConfirmation"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to remove <strong>@student?.Person.FirstName @student?.Person.LastName</strong> from current learning path?</p>

                    @if (student?.LearningPath != null)
                    {
                        <div class="alert alert-info">
                            <strong>Current Learning Path:</strong><br />
                            @student.LearningPath.EducationLevel - @student.LearningPath.ClassLevel
                            (@student.LearningPath.AcademicYear) @student.LearningPath.Semester.ToTermDisplay())
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseRemoveConfirmation">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="RemoveStudentFromLearningPath">
                        Remove Student
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<ErrorDisplayModal IsVisible="showErrorModal"
                   Title="@errorModalTitle"
                   Message="@errorMessage"
                   OnClose="CloseErrorModal" />

@code {
    [Parameter]
    public int Id { get; set; }

    private Student? student;
    private Guardian? guardian;
    private SchoolFees? currentFees;
    private bool showLearningPathModal = false;
    private bool showRemoveConfirmation = false;
    private int selectedLearningPathId = 0;
    private List<LearningPathListItem> availableLearningPaths = new();

    private List<SchoolFees> previousFees = new();
    private double broughtForward;
    private double previousOutstanding;
    private bool showHistoryModal;
    private int? expandedFoldId;

    private bool showErrorModal;
    private string errorModalTitle = "Error";
    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        LoadStudent();

        if (student == null)
        {
            NavigationManager.NavigateTo("/students");
        }
        else if (student.GuardianId > 0)
        {
            guardian = SchoolDataService.GetGuardianById(student.GuardianId);
        }
    }

    private void ShowLearningPathModal()
    {
        if (student == null)
        {
            return;
        }
        availableLearningPaths = SchoolDataService.GetEnrollableLearningPaths(student.Person.EducationLevel, student.Person.ClassLevel);
        selectedLearningPathId = 0;
        showLearningPathModal = true;
    }

    private void CloseLearningPathModal()
    {
        showLearningPathModal = false;
    }

    private void AddStudentToSelectedLearningPath()
    {
        if (selectedLearningPathId == 0 || student == null)
            return;

        double amountTransferred = SchoolDataService.AddStudentToLearningPath(selectedLearningPathId, student);
        LoadStudent();
        CloseLearningPathModal();

        if (amountTransferred > 0)
        {
            errorModalTitle = "Payment Transferred";
            errorMessage = $"₦{amountTransferred:N2} was transferred from the previous learning path.";
            showErrorModal = true;
        }
    }

    private bool IsStudentInLearningPath()
    {
        return student?.LearningPathId > 0;
    }

    private void ShowRemoveConfirmation()
    {
        showRemoveConfirmation = true;
    }

    private void CloseRemoveConfirmation()
    {
        showRemoveConfirmation = false;
    }

    private void RemoveStudentFromLearningPath()
    {
        if (student == null || student.LearningPath == null)
            return;

        try
        {
            SchoolDataService.RemoveStudentFromLearningPath(student.LearningPath, student);
            LoadStudent();
        }
        catch (BusinessRuleException ex)
        {
            errorModalTitle = "Cannot Remove Student";
            errorMessage = ex.Message;
            showErrorModal = true;
        }

        CloseRemoveConfirmation();
    }

    private void LoadStudent()
    {
        student = SchoolDataService.GetStudentById(Id);

        currentFees = null;
        previousFees = new List<SchoolFees>();
        broughtForward = 0;
        previousOutstanding = 0;

        if (student == null)
            return;

        var currentPeriod = SchoolDataService.GetCurrentAcademicPeriod();
        var allFees = student.SchoolFees.Where(fees => fees.LearningPath != null).ToList();

        if (currentPeriod != null)
        {
            currentFees = allFees
                .FirstOrDefault(fees => fees.LearningPath!.AcademicPeriodId == currentPeriod.Id);

            previousFees = allFees
                .Where(fees => fees.LearningPath!.AcademicPeriodId != currentPeriod.Id)
                .OrderByDescending(fees => fees.LearningPath!.SemesterStartDate)
                .ToList();
        }

        previousOutstanding = previousFees.Sum(fees => fees.Balance);

        if (currentFees?.LearningPath != null)
        {
            broughtForward = LogicMethods.GetOutstandingBroughtForward(
                student.SchoolFees, currentFees.LearningPath);
        }
    }

    private void ToggleFold(int schoolFeesId)
    {
        expandedFoldId = expandedFoldId == schoolFeesId ? null : schoolFeesId;
    }

    private void NavigateToManagePayments()
    {
        if (currentFees == null || student?.LearningPath == null)
            return;

        NavigationManager.NavigateTo($"/schoolfees/{currentFees.Id}/payments");
    }

    private void CloseErrorModal()
    {
        showErrorModal = false;
        errorModalTitle = "Error";
    }
}