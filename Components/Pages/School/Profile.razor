@page "/profile"
@using FcmsPortal.Models
@using FcmsPortal.Enums
@using FcmsPortalUI.Services
@using FcmsPortalUI.Components.Pages.Shared
@using FcmsPortalUI.Components.Pages.Archive
@inject IPermissionService PermissionService
@inject ISchoolDataService SchoolDataService
@inject NavigationManager NavigationManager

<PageTitle>My Profile</PageTitle>

<div class="container mt-4">

    @if (isLoading || currentPerson == null)
    {
        <p class="text-muted">Loading...</p>
    }
    else
    {
        <!-- PROFILE HEADER -->
        <div class="card mb-4">

            <div class="card-body d-flex align-items-center flex-wrap" style="gap:1rem;">
                @if (!string.IsNullOrEmpty(currentPerson.ProfilePictureUrl))
                {
                    <img src="@currentPerson.ProfilePictureUrl"
                         class="rounded-circle flex-shrink-0"
                         style="width:80px;height:80px;object-fit:cover;" />
                }
                else
                {
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                         style="width:80px;height:80px;background-color:#5a3e2b;color:#fdf6f0;font-size:28px;font-weight:500;">
                        @Util.GetInitials(currentPerson)
                    </div>
                }

                <div class="flex-grow-1" style="min-width:0;">
                    <h3 class="mb-2">@Util.GetFullName(currentPerson)</h3>

                    <div class="d-flex align-items-center flex-wrap" style="gap:0.5rem;">
                        @if (!string.IsNullOrEmpty(userRole))
                        {
                            <span class="badge" style="background-color:#f0d5c4;color:#5a3e2b;">@userRole</span>
                        }

                        @if (isStudent && studentProfile != null)
                        {
                            @if (Util.IsStudentEnrolled(studentProfile))
                            {
                                <span class="badge" style="background-color:#d4edda;color:#218838;">Enrolled</span>
                                <small class="text-muted">@studentProfile.Person.EducationLevel.ToDisplayName() - @studentProfile.Person.ClassLevel.ToDisplayName()</small>
                            }
                            else
                            {
                                <span class="badge" style="background-color:#f0f0f0;color:#6c757d;">Not Enrolled</span>
                            }
                        }

                        @if (staffProfile != null)
                        {
                            @if (staffProfile.Person.EducationLevel != EducationLevel.None)
                            {
                                <small class="text-muted">@staffProfile.Person.EducationLevel.ToDisplayName()</small>
                            }
                            @if (staffProfile.Person.ClassLevel != ClassLevel.None)
                            {
                                <small class="text-muted">@staffProfile.Person.ClassLevel.ToDisplayName()</small>
                            }
                            @if (!string.IsNullOrEmpty(staffProfile.JobDescription))
                            {
                                <small class="text-muted">@staffProfile.JobDescription</small>
                            }
                        }
                    </div>

                    @if (isGuardian && guardianProfile != null && guardianProfile.Wards.Any())
                    {
                        <div class="mt-2">
                            <small class="text-muted d-block mb-1"><strong>Wards</strong></small>
                            @foreach (var ward in guardianProfile.Wards)
                            {
                                <div class="d-flex align-items-center flex-wrap mb-1" style="gap:0.5rem;">
                                    <small>@Util.GetFullName(ward.Person)</small>
                                    @if (Util.IsStudentEnrolled(ward))
                                    {
                                        <span class="badge" style="background-color:#d4edda;color:#218838;">Enrolled</span>
                                        <small class="text-muted">@ward.Person.EducationLevel.ToDisplayName() - @ward.Person.ClassLevel.ToDisplayName()</small>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background-color:#f0f0f0;color:#6c757d;">Not Enrolled</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="card-body border-top">
                <div class="row g-3">
                    <div class="col-md-6 col-lg-4">
                        <h6 class="text-muted">Email</h6>
                        <p>@currentPerson.Email</p>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <h6 class="text-muted">Phone</h6>
                        <p>@currentPerson.PhoneNumber</p>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <h6 class="text-muted">Age</h6>
                        <p>@currentPerson.Age years</p>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <h6 class="text-muted">Gender</h6>
                        <p>@(currentPerson.Sex.ToString() ?? "N/A")</p>
                    </div>
                    <div class="col-md-6 col-lg-4">
                        <h6 class="text-muted">Enrollment Date</h6>
                        <p>@currentPerson.DateOfEnrollment.ToString("MMMM d, yyyy")</p>
                    </div>
                    @if (!string.IsNullOrEmpty(currentPerson.StateOfOrigin))
                    {
                        <div class="col-md-6 col-lg-4">
                            <h6 class="text-muted">State of Origin</h6>
                            <p>@currentPerson.StateOfOrigin</p>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(currentPerson.LgaOfOrigin))
                    {
                        <div class="col-md-6 col-lg-4">
                            <h6 class="text-muted">LGA of Origin</h6>
                            <p>@currentPerson.LgaOfOrigin</p>
                        </div>
                    }
                </div>
            </div>

            <div class="card-body border-top">
                <h6 class="text-muted mb-2"><i class="fa fa-location-dot me-1"></i>Address</h6>
                @if (currentPerson.Address != null)
                {
                    <p class="mb-0">@Util.GetFormattedAddress(currentPerson.Address)</p>
                }
                else
                {
                    <p class="text-muted mb-0">No address on file.</p>
                }
            </div>
        </div>

        <!-- ACHIEVEMENTS -->
        @if ((isStudent && studentProfile != null) || (isGuardian && guardianProfile != null && guardianProfile.Wards.Any()))
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Achievements</h5>
                </div>
                <div class="card-body">

                    @if (isGuardian && guardianProfile != null && guardianProfile.Wards.Count > 1)
                    {
                        <div class="d-flex align-items-center flex-wrap mb-3" style="gap:0.5rem;">
                            <small class="text-muted">Viewing ward:</small>
                            @foreach (var ward in guardianProfile.Wards)
                            {
                                @if (ward.Id == activeAchievementStudentId)
                                {
                                    <span class="badge" style="background-color:#f0d5c4;color:#5a3e2b;cursor:default;">@Util.GetFullName(ward.Person)</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-secondary border" style="cursor:pointer;"
                                          @onclick="() => SelectAchievementWard(ward.Id)">@Util.GetFullName(ward.Person)</span>
                                }
                            }
                        </div>
                    }

                    <ul class="nav fcms-tabs mb-3">
                        <li class="nav-item">
                            <button class="nav-link @(activeAchievementTab == TabReportCards ? "active" : "")"
                                    @onclick="() => activeAchievementTab = TabReportCards">
                                <i class="fa fa-file-alt me-1"></i>Report Cards
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeAchievementTab == TabAwards ? "active" : "")"
                                    @onclick="() => activeAchievementTab = TabAwards">
                                <i class="fa fa-trophy me-1"></i>Awards
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeAchievementTab == TabBehaviour ? "active" : "")"
                                    @onclick="() => activeAchievementTab = TabBehaviour">
                                <i class="fa fa-star me-1"></i>Behaviour Rating
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link @(activeAchievementTab == TabGallery ? "active" : "")"
                                    @onclick="() => activeAchievementTab = TabGallery">
                                <i class="fa fa-images me-1"></i>Gallery
                            </button>
                        </li>
                    </ul>

                    @if (activeAchievementTab == TabReportCards)
                    {
                        var grades = GetActiveAchievementGrades();

                        @if (!grades.Any())
                        {
                            <p class="text-muted">No report cards available.</p>
                        }
                        else
                        {
                            @foreach (var yearGroup in grades
                                .GroupBy(g => g.ArchivedLearningPathGrade?.AcademicYear ?? "Unknown")
                                .OrderByDescending(gr => gr.Key))
                            {
                                var first = yearGroup.First();
                                var isExpanded = expandedAcademicYear == yearGroup.Key;

                                <div class="border rounded mb-2">
                                    <div class="d-flex justify-content-between align-items-center p-2 fcms-fold-header"
                                         @onclick="() => ToggleAcademicYear(yearGroup.Key)">
                                        <span>
                                            <strong>@yearGroup.Key</strong>
                                            @if (first.ArchivedLearningPathGrade != null)
                                            {
                                                <span class="text-muted ms-2">@first.ArchivedLearningPathGrade.EducationLevel.ToDisplayName() - @first.ArchivedLearningPathGrade.ClassLevel.ToDisplayName()</span>
                                            }
                                        </span>
                                        <i class="fa @(isExpanded ? "fa-chevron-up" : "fa-chevron-down") text-muted"></i>
                                    </div>

                                    @if (isExpanded)
                                    {
                                        <div class="d-flex flex-column p-2 fcms-fold-body">
                                            @foreach (var asg in yearGroup.OrderBy(g => g.ArchivedLearningPathGrade?.Semester))
                                            {
                                                <div class="d-flex justify-content-between align-items-center flex-wrap rounded p-2 fcms-fold-item">
                                                    <div>
                                                        <strong>@(asg.ArchivedLearningPathGrade?.Semester.ToTermDisplay() ?? "Unknown Term")</strong>
                                                        <small class="text-muted d-block">@asg.ArchivedLearningPathGrade?.ArchivedDate.ToString("MMMM d, yyyy")</small>
                                                        <span class="badge bg-light text-secondary border mt-1">Overall @asg.SemesterOverallGrade.ToString("F2")%</span>
                                                        @if (asg.IsPromoted)
                                                        {
                                                            <span class="badge mt-1" style="background-color:#d4edda;color:#218838;">
                                                                <i class="fa fa-arrow-up me-1"></i>Promoted
                                                            </span>
                                                        }
                                                    </div>
                                                    <div class="d-flex fcms-gap-sm">
                                                        <button class="btn btn-sm btn-primary" @onclick="() => OpenArchivedReportCard(asg)">
                                                            <i class="fa fa-file-alt me-1"></i>Report Card
                                                        </button>
                                                        <button class="btn btn-sm btn-info" @onclick="() => OpenArchivedGradeDetails(asg)">
                                                            <i class="fa fa-eye me-1"></i>Grade Details
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                    }

                    @if (activeAchievementTab == TabAwards)
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fa fa-trophy fa-2x mb-2" style="color:#f0d5c4;"></i>
                            <p class="mb-0">Coming soon</p>
                        </div>
                    }

                    @if (activeAchievementTab == TabBehaviour)
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fa fa-star fa-2x mb-2" style="color:#f0d5c4;"></i>
                            <p class="mb-0">Coming soon</p>
                        </div>
                    }

                    @if (activeAchievementTab == TabGallery)
                    {
                        <div class="text-center text-muted py-4">
                            <i class="fa fa-images fa-2x mb-2" style="color:#f0d5c4;"></i>
                            <p class="mb-0">Coming soon</p>
                        </div>
                    }

                </div>
            </div>
        }
    }

</div>
<ArchivedStudentReportCardModal IsVisible="showArchivedReportCardModal"
                                ArchivedStudent="selectedArchivedGrade"
                                OnClose="CloseArchivedReportCardModal" />

<ArchivedStudentGradeModal IsVisible="showArchivedGradeModal"
                           ArchivedStudent="selectedArchivedGrade"
                           OnClose="CloseArchivedGradeModal" />



@code {
    private Person? currentPerson;
    private string userRole = "";

    // Role flags (matches PermissionService)
    private bool isStudent = false;
    private bool isGuardian = false;
    private bool isPrincipal = false;
    private bool isDeveloper = false;

    // Profiles mapped from SchoolDataService
    private Student? studentProfile;
    private Guardian? guardianProfile;
    private Staff? staffProfile;

    // Loading state
    private bool isLoading = true;

    // Achievements section
    private const string TabReportCards = "reportcards";
    private const string TabAwards = "awards";
    private const string TabBehaviour = "behaviour";
    private const string TabGallery = "gallery";
    private string activeAchievementTab = TabReportCards;
    private int activeAchievementStudentId = 0;
    private string expandedAcademicYear = "";

    // key = studentId, value = archived grade snapshots (one per finalized term)
    private Dictionary<int, List<ArchivedStudentGrade>> achievementGrades = new();

    private bool showArchivedReportCardModal = false;
    private bool showArchivedGradeModal = false;
    private ArchivedStudentGrade? selectedArchivedGrade;

    protected override async Task OnInitializedAsync()
    {
        // 1. Load logged-in person
        currentPerson = await PermissionService.GetCurrentPersonAsync();

        if (currentPerson == null)
        {
            NavigationManager.NavigateTo("/Account/Login", true);
            return;
        }

        // 2. Determine user roles
        isStudent = await PermissionService.IsInRoleAsync("Student");
        isGuardian = await PermissionService.IsInRoleAsync("Guardian");
        //isStaff = await PermissionService.IsInAnyRoleAsync("Staff", "Teacher", "Admin");
        isPrincipal = await PermissionService.IsInRoleAsync("Principal");
        isDeveloper = await PermissionService.IsInRoleAsync("Developer");

        if (isDeveloper) userRole = "Developer";
        else if (isPrincipal) userRole = "Principal";
        else if (staffProfile != null) userRole = staffProfile.UserRole.ToString();
        else if (await PermissionService.IsInRoleAsync("Admin")) userRole = "Admin";
        else if (await PermissionService.IsInRoleAsync("Teacher")) userRole = "Teacher";
        else if (await PermissionService.IsInRoleAsync("Staff")) userRole = "Staff";
        else if (isGuardian) userRole = "Guardian";
        else if (isStudent) userRole = "Student";

        // 3. Student Profile + Achievements
        studentProfile = SchoolDataService.GetStudentByPersonId(currentPerson.Id);

        if (studentProfile != null)
        {
            achievementGrades[studentProfile.Id] = SchoolDataService.GetStudentArchivedGrades(studentProfile.Id);
            activeAchievementStudentId = studentProfile.Id;
        }

        // 4. Guardian Profile + Wards' Achievements
        guardianProfile = SchoolDataService.GetGuardians()
            .FirstOrDefault(g => g.PersonId == currentPerson.Id);

        if (guardianProfile != null)
        {
            foreach (var ward in guardianProfile.Wards)
            {
                achievementGrades[ward.Id] = SchoolDataService.GetStudentArchivedGrades(ward.Id);
            }

            if (guardianProfile.Wards.Any() && activeAchievementStudentId == 0)
            {
                activeAchievementStudentId = guardianProfile.Wards.First().Id;
            }
        }

        SetDefaultExpandedYear();

        // 5. Staff Profile
        staffProfile = SchoolDataService.GetStaff()
            .FirstOrDefault(s => s.PersonId == currentPerson.Id);

        isLoading = false;
    }

    private List<ArchivedStudentGrade> GetActiveAchievementGrades()
    {
        return achievementGrades.ContainsKey(activeAchievementStudentId)
            ? achievementGrades[activeAchievementStudentId]
            : new List<ArchivedStudentGrade>();
    }

    private void SelectAchievementWard(int wardId)
    {
        activeAchievementStudentId = wardId;
        SetDefaultExpandedYear();
    }

    private void SetDefaultExpandedYear()
    {
        expandedAcademicYear = GetActiveAchievementGrades()
            .Select(g => g.ArchivedLearningPathGrade?.AcademicYear ?? "")
            .OrderByDescending(y => y)
            .FirstOrDefault() ?? "";
    }

    private void ToggleAcademicYear(string year)
    {
        expandedAcademicYear = expandedAcademicYear == year ? "" : year;
    }

    private void OpenArchivedReportCard(ArchivedStudentGrade asg)
    {
        selectedArchivedGrade = asg;
        showArchivedReportCardModal = true;
    }

    private void OpenArchivedGradeDetails(ArchivedStudentGrade asg)
    {
        selectedArchivedGrade = asg;
        showArchivedGradeModal = true;
    }

    private void CloseArchivedReportCardModal()
    {
        showArchivedReportCardModal = false;
    }

    private void CloseArchivedGradeModal()
    {
        showArchivedGradeModal = false;
    }
}
