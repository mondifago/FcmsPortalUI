@page "/staff"
@inject ISchoolDataService SchoolDataService
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.Components.QuickGrid
@using FcmsPortal
@using FcmsPortal.Models
@using FcmsPortal.Enums
@using FcmsPortal.Constants
@using FcmsPortalUI.Services
@using FcmsPortalUI.DTOs
@using FcmsPortalUI.Components.Pages.Shared
@rendermode InteractiveServer

<PageTitle>Staff</PageTitle>

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Staff</h2>
        <AuthorizeView Roles="Developer,Principal,Admin">
            <Authorized>
                <div class="mb-3">
                    <a href="/staff/create" class="btn btn-primary">
                        <i class="fa fa-plus"></i> Add New Staff
                    </a>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>

    <div class="card">
        <div class="card-body">
            <AuthorizeView Roles="Developer,Principal,Admin">
                <Authorized>
                    <div class="d-flex align-items-center flex-wrap mb-2" style="gap:0.5rem;">
                        @if (!selectMode)
                        {
                            <button class="btn btn-sm btn-outline-secondary" @onclick="EnterSelectMode">
                                <i class="fa fa-check-square me-1"></i>Select
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-warning" disabled="@(selectedIds.Count != 1)" @onclick="EditSelected">
                                <i class="fa fa-pencil me-1"></i>Edit
                            </button>
                            <button class="btn btn-sm btn-primary" disabled="@(selectedIds.Count != 1)" @onclick="AccountSelected">
                                <i class="fa fa-user me-1"></i>Account
                            </button>
                            <button class="btn btn-sm btn-danger" disabled="@(!selectedIds.Any())" @onclick="DeleteSelected">
                                <i class="fa fa-trash me-1"></i>Delete (@selectedIds.Count)
                            </button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="ExitSelectMode">
                                <i class="fa fa-times me-1"></i>Cancel
                            </button>
                        }
                    </div>
                </Authorized>
            </AuthorizeView>

            <div class="table-responsive">
                <QuickGrid Items="itemsQuery" Pagination="pagination" Class="table table-striped fcms-grid">
                    @if (selectMode)
                    {
                        <TemplateColumn Title="">
                            <input type="checkbox"
                                   checked="@selectedIds.Contains(context.Id)"
                                   @onchange="e => ToggleSelection(context.Id, e)" />
                        </TemplateColumn>
                    }

                    <TemplateColumn Title="Name">
                        <a href="/staff/details/@context.Id" class="grid-name-link">
                            <ListThumbnail ImageUrl="@context.ProfilePictureUrl" Initials="@context.Initials" />
                            @context.FullName
                        </a>
                    </TemplateColumn>

                    <TemplateColumn Title="Email" Class="d-none d-md-table-cell">
                        @context.Email
                    </TemplateColumn>

                    <TemplateColumn Title="Phone" Class="d-none d-md-table-cell">
                        @context.PhoneNumber
                    </TemplateColumn>

                    <TemplateColumn Title="User Role">
                        @context.UserRole
                    </TemplateColumn>

                    <TemplateColumn Title="Status">
                        <span class="badge @(context.IsActive ? "bg-success" : "bg-danger")">
                            @(context.IsActive ? "Active" : "Inactive")
                        </span>
                    </TemplateColumn>
                </QuickGrid>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <button class="btn btn-sm btn-fcms"
                        disabled="@(pagination.CurrentPageIndex == 0)"
                        @onclick="PreviousPage">
                    <i class="fa fa-arrow-left"></i>
                </button>
                <small class="text-muted">Page @(pagination.CurrentPageIndex + 1) of @((pagination.LastPageIndex ?? 0) + 1)</small>
                <button class="btn btn-sm btn-fcms"
                        disabled="@(pagination.CurrentPageIndex >= (pagination.LastPageIndex ?? 0))"
                        @onclick="NextPage">
                    <i class="fa fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>

    <ConfirmDeleteModal IsVisible="showDeleteConfirmation"
                        Title="Confirm Delete"
                        Message="@deleteMessage"
                        OnConfirm="ConfirmDelete"
                        OnCancel="CancelDelete" />

    <ErrorDisplayModal IsVisible="showErrorModal"
                       Title="Cannot Delete Staff"
                       Message="@errorMessage"
                       OnClose="CloseErrorModal" />
</div>

@code {
    private IQueryable<StaffListItem>? itemsQuery;
    private PaginationState pagination = new() { ItemsPerPage = FcmsConstants.LIST_PAGE_SIZE };

    private bool selectMode = false;
    private HashSet<int> selectedIds = new();

    private bool showDeleteConfirmation = false;
    private bool showErrorModal = false;
    private string errorMessage = "";
    private string deleteMessage = "";

    protected override void OnInitialized()
    {
        pagination.TotalItemCountChanged += (sender, eventArgs) => InvokeAsync(StateHasChanged);
        itemsQuery = SchoolDataService.GetStaffForList();
    }

    private void EnterSelectMode()
    {
        selectMode = true;
        selectedIds.Clear();
    }

    private void ExitSelectMode()
    {
        selectMode = false;
        selectedIds.Clear();
    }

    private void ToggleSelection(int id, ChangeEventArgs e)
    {
        var isChecked = e.Value is bool b && b;

        if (isChecked)
        {
            selectedIds.Add(id);
        }
        else
        {
            selectedIds.Remove(id);
        }
    }

    private void EditSelected()
    {
        NavigationManager.NavigateTo($"/staff/edit/{selectedIds.First()}");
    }

    private void AccountSelected()
    {
        NavigationManager.NavigateTo($"/staff/account/{selectedIds.First()}");
    }

    private void DeleteSelected()
    {
        var validationErrors = new List<string>();

        foreach (var id in selectedIds)
        {
            var validationError = SchoolDataService.ValidateStaffDeletion(id);
            if (!string.IsNullOrEmpty(validationError))
            {
                validationErrors.Add(validationError);
            }
        }

        if (validationErrors.Any())
        {
            errorMessage = string.Join(" ", validationErrors);
            showErrorModal = true;
            return;
        }

        deleteMessage = $"Are you sure you want to delete {selectedIds.Count} staff member(s)?";
        showDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        showDeleteConfirmation = false;
    }

    private async Task ConfirmDelete()
    {
        foreach (var id in selectedIds.ToList())
        {
            var staff = SchoolDataService.GetStaffById(id);
            if (staff != null && !string.IsNullOrEmpty(staff.Person.ProfilePictureUrl) && !staff.Person.ProfilePictureUrl.StartsWith("data:"))
            {
                var attachment = new FileAttachment { FilePath = staff.Person.ProfilePictureUrl };
                await SchoolDataService.DeleteFileAsync(attachment);
            }

            var result = SchoolDataService.DeleteStaff(id);
            if (result)
            {
                selectedIds.Remove(id);
            }
        }

        itemsQuery = SchoolDataService.GetStaffForList();
        showDeleteConfirmation = false;
        StateHasChanged();
    }

    private async Task PreviousPage()
    {
        await pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex - 1);
    }

    private async Task NextPage()
    {
        await pagination.SetCurrentPageIndexAsync(pagination.CurrentPageIndex + 1);
    }

    private void CloseErrorModal()
    {
        showErrorModal = false;
        errorMessage = "";
    }
}