@page "/reports"
@using FcmsPortal.Models
@using FcmsPortal.Enums
@using FcmsPortalUI.Services
@using FcmsPortalUI.DTOs
@using FcmsPortal
@using FcmsPortalUI.Components.Pages.Shared
@inject ISchoolDataService SchoolDataService
@inject NavigationManager NavigationManager

<div class="container-fluid mt-3">
    <div class="row mb-3">
        <div class="col">
            <h2>
                Reports
            </h2>
        </div>
    </div>

    <ul class="nav fcms-tabs mb-3">
        <li class="nav-item">
            <button class="nav-link @(activeReportTab == TabAttendance ? "active" : "")"
                    @onclick="() => activeReportTab = TabAttendance">
                Attendance
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeReportTab == TabSessions ? "active" : "")"
                    @onclick="() => activeReportTab = TabSessions">
                Class Sessions
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(activeReportTab == TabGrades ? "active" : "")"
                    @onclick="() => activeReportTab = TabGrades">
                Grades
            </button>
        </li>
    </ul>

    @if (activeReportTab == TabAttendance)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <label for="attendanceAcademicYear" class="form-label">Academic Year:</label>
                        <select class="form-select" id="attendanceAcademicYear" @bind="attendanceYear" @bind:after="OnAttendanceFiltersChanged">
                            <option value="">Select Academic Year</option>
                            @foreach (var year in availableAcademicYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="attendanceSemester" class="form-label">Term:</label>
                        <select class="form-select" id="attendanceSemester" @bind="attendanceSemester" @bind:after="OnAttendanceFiltersChanged">
                            <option value="">Select Term</option>
                            @if (!string.IsNullOrEmpty(attendanceYear))
                            {
                                @foreach (var semester in attendanceSemesters)
                                {
                                    <option value="@semester">@semester</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="attendanceDate" class="form-label">Select Date:</label>
                        <input type="date" class="form-control" id="attendanceDate" @bind="attendanceDate" @bind:after="OnAttendanceDateChanged" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(attendanceYear) && !string.IsNullOrEmpty(attendanceSemester) && filteredLearningPaths.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover fcms-grid">
                            <thead>
                                <tr>
                                    <th>Class</th>
                                    <th>Present</th>
                                    <th>Absent</th>
                                    <th>Time Submitted</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var learningPath in filteredLearningPaths)
                                {
                                    var attendance = SchoolDataService.GetAttendanceForDate(learningPath.Id, attendanceDate);

                                    <tr>
                                        <td>@learningPath.ClassLevel.ToDisplayName()</td>
                                        <td>@(attendance?.PresentStudents.Count ?? 0)</td>
                                        <td>@(attendance?.AbsentStudents.Count ?? 0)</td>
                                        <td>@(attendance != null ? attendance.TimeStamp.ToString("h:mm tt") : "")</td>
                                        <td>
                                            @if (attendance != null)
                                            {
                                                <button class="btn btn-sm btn-outline-primary"
                                                        @onclick="() => ViewDailyAttendance(learningPath.Id)">
                                                    <i class="fa fa-calendar-day me-1"></i> Daily View
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-success"
                                                    @onclick="() => ViewSemesterAttendance(learningPath.Id)">
                                                <i class="fa fa-chart-line me-1"></i> Term View
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    @if (!string.IsNullOrEmpty(attendanceYear) && !string.IsNullOrEmpty(attendanceSemester))
                    {
                        <div class="text-center py-4">
                            <i class="fa fa-calendar-times fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No attendance records found</h5>
                            <p class="text-muted">
                                @if (attendanceDate == default)
                                {
                                    <span>Please select a date to view attendance records.</span>
                                }
                                else
                                {
                                    <span>No attendance records found for @attendanceDate.ToString("MMMM dd, yyyy") in @attendanceYear @attendanceSemester.ToTermDisplay()</span>
                                }
                            </p>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fa fa-filter fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">Select filters to view attendance</h5>
                            <p class="text-muted">Please select Academic Year and Term to continue.</p>
                        </div>
                    }
                }
            </div>
        </div>
    }

    @if (activeReportTab == TabSessions)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <label for="sessionAcademicYear" class="form-label">Academic Year:</label>
                        <select class="form-select" id="sessionAcademicYear" @bind="sessionYear" @bind:after="OnSessionFiltersChanged">
                            <option value="">Select Academic Year</option>
                            @foreach (var year in availableAcademicYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="sessionSemester" class="form-label">Term:</label>
                        <select class="form-select" id="sessionSemester" @bind="sessionSemester" @bind:after="OnSessionFiltersChanged">
                            <option value="">Select Term</option>
                            @if (!string.IsNullOrEmpty(sessionYear))
                            {
                                @foreach (var semester in sessionSemesters)
                                {
                                    <option value="@semester">@semester</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="sessionDate" class="form-label">Select Date:</label>
                        <input type="date" class="form-control" id="sessionDate" @bind="sessionDate" @bind:after="OnSessionDateChanged" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(sessionYear) && !string.IsNullOrEmpty(sessionSemester))
                {
                    @if (filteredSessionReports != null && filteredSessionReports.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover fcms-grid">
                                <thead>
                                    <tr>
                                        <th>Class</th>
                                        <th>Course</th>
                                        <th>Topic</th>
                                        <th>Time Submitted</th>
                                        <th>Submitted By</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var report in filteredSessionReports)
                                    {
                                        <tr>
                                            <td>@report.LearningPathName</td>
                                            <td>@report.Course</td>
                                            <td>@report.Topic</td>
                                            <td>@report.TimeSubmitted.ToString("hh:mm tt")</td>
                                            <td>@report.SubmittedBy</td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewClassSession(report.ClassSessionId)">
                                                    <i class="fa fa-eye me-1"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fa fa-comments fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No class session reports found</h5>
                            <p class="text-muted">
                                @if (sessionDate == default)
                                {
                                    <span>Please select a date to view class session reports.</span>
                                }
                                else
                                {
                                    <span>No class session reports found for @sessionDate.ToString("MMMM dd, yyyy") in @sessionYear @sessionSemester.ToTermDisplay().</span>
                                }
                            </p>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fa fa-filter fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">Select filters to view class session reports</h5>
                        <p class="text-muted">Please select Academic Year and Term to continue.</p>
                    </div>
                }
            </div>
        </div>
    }

    @if (activeReportTab == TabGrades)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <label for="gradesAcademicYear" class="form-label">Academic Year:</label>
                        <select class="form-select" id="gradesAcademicYear" @bind="gradesYear" @bind:after="OnGradesFiltersChanged">
                            <option value="">Select Academic Year</option>
                            @foreach (var year in availableAcademicYears)
                            {
                                <option value="@year">@year</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="gradesSemester" class="form-label">Term:</label>
                        <select class="form-select" id="gradesSemester" @bind="gradesSemester" @bind:after="OnGradesFiltersChanged">
                            <option value="">Select Term</option>
                            @if (!string.IsNullOrEmpty(gradesYear))
                            {
                                @foreach (var semester in gradesSemesters)
                                {
                                    <option value="@semester">@semester</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body">
                @if (!string.IsNullOrEmpty(gradesYear) && !string.IsNullOrEmpty(gradesSemester))
                {
                    @if (filteredGradesReports != null && filteredGradesReports.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover fcms-grid">
                                <thead>
                                    <tr>
                                        <th>Class</th>
                                        <th>Date Submitted</th>
                                        <th>Submitted By</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var report in filteredGradesReports)
                                    {
                                        <tr>
                                            <td>@report.LearningPathName</td>
                                            <td>@report.DateSubmitted.ToString("MMM dd, yyyy hh:mm tt")</td>
                                            <td>@report.SubmittedBy</td>
                                            <td>
                                                <span class="badge @Util.GetApprovalStatusBadgeClass(report.Status)">
                                                    @(report.Status == PrincipalApprovalStatus.Review ? "Pending" : report.Status.ToString())
                                                </span>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => ViewGradesReport(report.LearningPathId)">
                                                    <i class="fa fa-eye me-1"></i> View
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <i class="fa fa-chart-bar fa-3x text-muted mb-3"></i>
                            <h5 class="text-muted">No grades reports found</h5>
                            <p class="text-muted">
                                <span>No grades reports found for @gradesYear @gradesSemester.ToTermDisplay().</span>
                            </p>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4">
                        <i class="fa fa-filter fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">Select filters to view grades reports</h5>
                        <p class="text-muted">Please select Academic Year and Term to continue.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

<DailyAttendanceViewModal IsVisible="showDailyAttendanceModal"
                          SelectedDate="attendanceDate"
                          AttendanceData="dailyAttendanceData"
                          LearningPathName="@selectedLearningPathName"
                          OnClose="CloseDailyAttendanceModal" />


<SemesterAttendanceViewModal IsVisible="showSemesterAttendanceModal"
                             LearningPathName="@(selectedLearningPath != null ? Util.GetLearningPathName(selectedLearningPath) : string.Empty)"
                             AttendanceReport="semesterAttendanceReport"
                             OnClose="CloseSemesterAttendanceModal" />
@code {
    private const string TabAttendance = "attendance";
    private const string TabSessions = "sessions";
    private const string TabGrades = "grades";

    private string activeReportTab = TabAttendance;

    private School school = new School();
    private LearningPath? selectedLearningPath = null;
    private DailyAttendanceLogEntry dailyAttendanceData = new();
    private SemesterAttendanceReport semesterAttendanceReport = new();
    private List<ClassSessionReport> filteredSessionReports = new List<ClassSessionReport>();
    private List<GradesReport> filteredGradesReports = new List<GradesReport>();
    private List<LearningPath> filteredLearningPaths = new();
    private List<string> availableAcademicYears = new();
    private bool showDailyAttendanceModal = false;
    private bool showSemesterAttendanceModal = false;
    private string selectedLearningPathName = string.Empty;

    // Attendance tab filters
    private string attendanceYear = "";
    private string attendanceSemester = "";
    private DateTime attendanceDate = DateTime.Today;
    private List<string> attendanceSemesters = new();

    // Class Sessions tab filters
    private string sessionYear = "";
    private string sessionSemester = "";
    private DateTime sessionDate = DateTime.Today;
    private List<string> sessionSemesters = new();

    // Grades tab filters
    private string gradesYear = "";
    private string gradesSemester = "";
    private List<string> gradesSemesters = new();

    protected override void OnInitialized()
    {
        school = SchoolDataService.GetSchoolLearningPathsForReports();
        LoadAvailableAcademicYears();

        var (defaultYear, defaultSemester) = ResolveDefaultPeriod();

        attendanceYear = defaultYear;
        attendanceSemesters = GetSemestersForYear(defaultYear);
        attendanceSemester = defaultSemester;
        attendanceDate = DateTime.Today;

        sessionYear = defaultYear;
        sessionSemesters = GetSemestersForYear(defaultYear);
        sessionSemester = defaultSemester;
        sessionDate = DateTime.Today;

        gradesYear = defaultYear;
        gradesSemesters = GetSemestersForYear(defaultYear);
        gradesSemester = defaultSemester;

        if (!string.IsNullOrEmpty(defaultYear) && !string.IsNullOrEmpty(defaultSemester))
        {
            LoadFilteredLearningPaths();
            LoadSessionReports();
            LoadGradesReports();
        }
    }

    private (string year, string semester) ResolveDefaultPeriod()
    {
        var currentPeriod = SchoolDataService.GetCurrentAcademicPeriod();

        if (currentPeriod != null && availableAcademicYears.Contains(currentPeriod.AcademicYear))
        {
            var semesters = GetSemestersForYear(currentPeriod.AcademicYear);
            if (semesters.Contains(currentPeriod.Semester.ToString()))
            {
                return (currentPeriod.AcademicYear, currentPeriod.Semester.ToString());
            }
        }

        var fallbackYear = availableAcademicYears.FirstOrDefault() ?? "";
        var fallbackSemester = GetSemestersForYear(fallbackYear).FirstOrDefault() ?? "";
        return (fallbackYear, fallbackSemester);
    }

    private List<string> GetSemestersForYear(string year)
    {
        return school.LearningPaths
            .Where(lp => lp.AcademicYear == year)
            .Select(lp => lp.Semester.ToString())
            .Distinct()
            .OrderBy(semester => semester)
            .ToList();
    }

    private void LoadAvailableAcademicYears()
    {
        availableAcademicYears = school.LearningPaths
            .Select(lp => lp.AcademicYear)
            .Distinct()
            .OrderByDescending(year => year)
            .ToList();
    }

    private void OnAttendanceFiltersChanged()
    {
        if (!string.IsNullOrEmpty(attendanceYear))
        {
            attendanceSemesters = GetSemestersForYear(attendanceYear);
        }

        if (!string.IsNullOrEmpty(attendanceYear) && !string.IsNullOrEmpty(attendanceSemester))
        {
            LoadFilteredLearningPaths();
        }
    }

    private void OnAttendanceDateChanged()
    {
        if (!string.IsNullOrEmpty(attendanceYear) && !string.IsNullOrEmpty(attendanceSemester))
        {
            LoadFilteredLearningPaths();
        }
    }

    private void LoadFilteredLearningPaths()
    {
        filteredLearningPaths = school.LearningPaths
            .Where(lp => lp.AcademicYear == attendanceYear &&
                         lp.Semester.ToString() == attendanceSemester)
            .ToList();
    }

    private void ViewDailyAttendance(int learningPathId)
    {
        var learningPath = filteredLearningPaths.FirstOrDefault(lp => lp.Id == learningPathId);

        dailyAttendanceData = SchoolDataService.GetAttendanceForDate(learningPathId, attendanceDate) ?? new DailyAttendanceLogEntry();
        selectedLearningPathName = learningPath != null ? Util.GetLearningPathName(learningPath) : "Unknown";
        showDailyAttendanceModal = true;
    }

    private void ViewSemesterAttendance(int learningPathId)
    {
        selectedLearningPath = SchoolDataService.GetLearningPathForAttendanceReport(learningPathId);
        if (selectedLearningPath != null)
        {
            semesterAttendanceReport = LogicMethods.GenerateSemesterAttendanceReport(selectedLearningPath);
            semesterAttendanceReport.LearningPathName = Util.GetLearningPathName(selectedLearningPath);
            showSemesterAttendanceModal = true;
        }
    }

    private void CloseDailyAttendanceModal()
    {
        showDailyAttendanceModal = false;
        dailyAttendanceData = new DailyAttendanceLogEntry();
        selectedLearningPath = new LearningPath();
    }

    private void CloseSemesterAttendanceModal()
    {
        showSemesterAttendanceModal = false;
        semesterAttendanceReport = new();
        selectedLearningPath = null;
    }

    private void OnSessionFiltersChanged()
    {
        if (!string.IsNullOrEmpty(sessionYear))
        {
            sessionSemesters = GetSemestersForYear(sessionYear);
        }

        LoadSessionReports();
    }

    private void OnSessionDateChanged()
    {
        LoadSessionReports();
    }

    private void LoadSessionReports()
    {
        filteredSessionReports.Clear();
        if (string.IsNullOrEmpty(sessionYear) || string.IsNullOrEmpty(sessionSemester))
            return;

        var learningPaths = school.LearningPaths
            .Where(lp => lp.AcademicYear == sessionYear && lp.Semester.ToString() == sessionSemester)
            .ToList();

        foreach (var learningPath in learningPaths)
        {
            if (learningPath.Schedule == null) continue;

            var scheduleEntries = learningPath.Schedule
                .Where(s => s.ClassSession != null && !string.IsNullOrEmpty(s.ClassSession.TeacherRemarks) && s.DateTime.Date == sessionDate.Date)
                .ToList();

            foreach (var schedule in scheduleEntries)
            {
                var report = LogicMethods.CreateClassSessionReport(schedule);
                if (report != null)
                    report.LearningPathName = learningPath.ClassLevel.ToDisplayName();
                filteredSessionReports.Add(report);
            }
        }

        var ordered = filteredSessionReports
             .OrderByDescending(r => r.TimeSubmitted)
             .ToList();

        filteredSessionReports.Clear();
        filteredSessionReports.AddRange(ordered);
    }

    private void OnGradesFiltersChanged()
    {
        if (!string.IsNullOrEmpty(gradesYear))
        {
            gradesSemesters = GetSemestersForYear(gradesYear);
        }

        LoadGradesReports();
    }

    private void LoadGradesReports()
    {
        filteredGradesReports.Clear();
        if (string.IsNullOrEmpty(gradesYear) || string.IsNullOrEmpty(gradesSemester))
            return;

        var learningPaths = SchoolDataService.GetSubmittedLearningPaths(gradesYear, gradesSemester);

        var reports = learningPaths.Select(lp => new GradesReport
        {
            LearningPathId = lp.Id,
            LearningPathName = lp.ClassLevel.ToDisplayName(),
            DateSubmitted = lp.DateSubmitted ?? DateTime.Now,
            SubmittedBy = lp.SubmittedByName ?? "Unknown",
            Status = lp.ApprovalStatus
        }).OrderByDescending(r => r.DateSubmitted).ToList();

        filteredGradesReports.AddRange(reports);
    }

    private void ViewGradesReport(int learningPathId)
    {
        NavigationManager.NavigateTo($"/learningpaths/details/{learningPathId}");
    }

    private void ViewClassSession(int classSessionId)
    {
        NavigationManager.NavigateTo($"/classsession/details/{classSessionId}");
    }
}