@using FcmsPortal
@using FcmsPortal.Models
@using FcmsPortal.Enums
@using FcmsPortalUI.DTOs

<div class="card">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h4 class="mb-0">@Title for @SelectedDate.ToString("MMMM d, yyyy")</h4>
        <div>
            <button class="btn btn-sm btn-light me-2" @onclick="PreviousDay">
                <i class="fa fa-chevron-left"></i>
            </button>
            <span class="text-white">@SelectedDate.ToString("dddd")</span>
            <button class="btn btn-sm btn-light ms-2" @onclick="NextDay">
                <i class="fa fa-chevron-right"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        @if (!Schedules.Any() && !ClassSchedules.Any())
        {
            <div class="alert alert-info">
                <i class="fa fa-info-circle me-2"></i>
                No @(ScheduleTypesLabel.ToLower()) found for this date.
            </div>
        }

        @if (Schedules.Any())
        {
            <div class="list-group">
                @foreach (var schedule in Schedules.OrderBy(s => s.DateTime.TimeOfDay))
                {
                    <div class="list-group-item list-group-item-action">
                        <div class="d-flex w-100 justify-content-between align-items-center">
                            <div>
                                <h5 class="mb-1">@Util.GetScheduleTitle(schedule)</h5>
                                

                                <p class="mb-1">
                                    <small>
                                        <i class="fa fa-clock me-1"></i>
                                        @schedule.DateTime.ToString("h:mm tt") - @schedule.DateTime.Add(schedule.Duration).ToString("h:mm tt")
                                    </small>
                                    <small class="ms-3">
                                        <i class="fa fa-map-marker-alt me-1"></i>
                                        @schedule.Venue
                                    </small>
                                </p>
                            </div>
                            <div class="btn-group">
                                @if (OnView.HasDelegate)
                                {
                                    <button class="btn btn-sm btn-info" @onclick="() => OnView.InvokeAsync(schedule)">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                }
                                @if (OnEdit.HasDelegate && CanEditSchedule(schedule))
                                {
                                    <button class="btn btn-sm btn-warning" @onclick="() => EditSchedule(schedule)">
                                        <i class="fa fa-pencil"></i>
                                    </button>
                                }
                                @if (OnDelete.HasDelegate && CanEditSchedule(schedule))
                                {
                                    <button class="btn btn-sm btn-danger" @onclick="() => OnDelete.InvokeAsync(schedule)">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        @if (ClassSchedules.Any())
        {
            <h6 class="@(Schedules.Any() ? "mt-3" : "") mb-2">@ClassSchedules.First().ClassLevel.ToDisplayName() classes</h6>
            <div class="list-group">
                @foreach (var classSchedule in ClassSchedules)
                {
                    <div class="list-group-item">
                        <div class="d-flex w-100 justify-content-between align-items-center">
                            <div>
                                @if (classSchedule.ClassSessionId == null)
                                {
                                    <h6 class="mb-1 text-muted">Unassigned</h6>
                                }
                                else
                                {
                                    <h6 class="mb-1">
                                        @Util.GetClassSessionCode(classSchedule.ClassLevel, classSchedule.Semester, classSchedule.Course, classSchedule.SessionNumber) · @classSchedule.Topic
                                    </h6>
                                }
                                <p class="mb-1">
                                    <small>
                                        <i class="fa fa-clock me-1"></i>
                                        @classSchedule.DateTime.ToString("h:mm tt") - @classSchedule.DateTime.Add(classSchedule.Duration).ToString("h:mm tt")
                                    </small>
                                    <small class="ms-3">
                                        <i class="fa fa-map-marker-alt me-1"></i>
                                        @classSchedule.Venue
                                    </small>
                                    @if (!string.IsNullOrEmpty(classSchedule.TeacherName))
                                    {
                                        <small class="ms-3">
                                            <i class="fa fa-user me-1"></i>
                                            @classSchedule.TeacherName
                                        </small>
                                    }
                                </p>
                            </div>
                            @if (classSchedule.ClassSessionId != null)
                            {
                                var state = LogicMethods.GetSessionState(classSchedule.DateTime, classSchedule.ClosedAt, DateTime.Now);

                                <div class="d-flex align-items-center gap-2">
                                    <span class="@Util.GetSessionStateBadgeClass(state)">@state</span>
                                    <button class="btn btn-sm btn-info" @onclick="() => OnViewClassSchedule.InvokeAsync(classSchedule)">
                                        <i class="fa fa-eye"></i>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {

    [Parameter] public DateTime SelectedDate { get; set; }
    [Parameter] public List<ScheduleEntry> Schedules { get; set; } = new List<ScheduleEntry>();
    [Parameter] public List<ClassScheduleListItem> ClassSchedules { get; set; } = new List<ClassScheduleListItem>();
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<ScheduleEntry> OnView { get; set; }
    [Parameter] public EventCallback<ScheduleEntry> OnEdit { get; set; }
    [Parameter] public EventCallback<ScheduleEntry> OnDelete { get; set; }
    [Parameter] public EventCallback<ClassScheduleListItem> OnViewClassSchedule { get; set; }
    [Parameter] public EventCallback<DateTime> SelectedDateChanged { get; set; }

    [Parameter] public int ReferenceId { get; set; } = 0;
    [Parameter] public bool IsGeneralCalendar { get; set; } = false;
    [Parameter] public string ScheduleTypesLabel { get; set; } = "Schedules";
    [Parameter] public string Title { get; set; } = "Schedules";
  
    private async Task PreviousDay()
    {
        SelectedDate = SelectedDate.AddDays(-1);
        await SelectedDateChanged.InvokeAsync(SelectedDate);
        StateHasChanged();
    }

    private async Task NextDay()
    {
        SelectedDate = SelectedDate.AddDays(1);
        await SelectedDateChanged.InvokeAsync(SelectedDate);
        StateHasChanged();
    }

    private void EditSchedule(ScheduleEntry schedule)
    {
        OnEdit.InvokeAsync(schedule);
    }

    private bool CanEditSchedule(ScheduleEntry schedule)
    {
        return IsGeneralCalendar;
    }
}