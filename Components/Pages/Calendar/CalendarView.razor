@page "/calendar"
@using FcmsPortal
@using FcmsPortal.Models
@using FcmsPortal.Enums
@using FcmsPortal.Constants
@using FcmsPortalUI.DTOs
@using FcmsPortalUI.Services
@using FcmsPortalUI.Components.Pages.Shared
@inject ISchoolDataService SchoolDataService
@inject NavigationManager NavigationManager

<PageTitle>Calendar</PageTitle>

<div class="container-fluid mt-3">
    <div class="row mb-3">
        <div class="col">
            <div class="d-flex justify-content-between align-items-center">
                <h2>School Calendar</h2>
                <div>
                    <AuthorizeView Roles="Developer,Principal,Admin">
                        <Authorized>
                            <button class="btn btn-success" @onclick="ShowAddEventModal">
                                <i class="fa fa-plus"></i> Add Event
                            </button>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Filters</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Schedule Types</label>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="showMeetings"
                                   @bind="showMeetings" @bind:after="ApplyFilters">
                            <label class="form-check-label" for="showMeetings">
                                <span class="badge bg-warning">
                                    <i class="fa fa-users me-1"></i> Meetings
                                </span>
                            </label>
                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="showEvents"
                                   @bind="showEvents" @bind:after="ApplyFilters">
                            <label class="form-check-label" for="showEvents">
                                <span class="badge bg-success">
                                    <i class="fa fa-calendar-day me-1"></i> Events
                                </span>
                            </label>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="classLevelFilter" class="form-label">Class Schedules</label>
                        <select id="classLevelFilter" class="form-select" @bind="selectedClassLevel" @bind:after="LoadVisibleRangeAsync">
                            <option value="@ClassLevel.None">None</option>
                            @foreach (var educationLevel in Enum.GetValues<EducationLevel>().Where(l => l != EducationLevel.None))
                            {
                                <optgroup label="@educationLevel.ToDisplayName()">
                                    @foreach (var classLevel in LogicMethods.GetAvailableClassLevels(educationLevel))
                                    {
                                        <option value="@classLevel">@classLevel.ToDisplayName()</option>
                                    }
                                </optgroup>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="viewMode" class="form-label">View Mode</label>
                        <select id="viewMode" class="form-select" @bind="viewMode" @bind:after="OnViewModeChanged">
                            <option value="month">Month</option>
                            <option value="week">Week</option>
                            <option value="day">Day</option>
                        </select>
                    </div>
                </div>
            </div>
            @if (ShowSelectedDayList)
            {
                <div class="d-none d-lg-block">
                    @SelectedDayList(true)
                </div>
            }
        </div>

        <div class="col-lg-8">
            @if (viewMode == "month")
            {
                <MonthlyCalendarView Title="Calendar"
                                     CurrentDate="@currentDate"
                                     CurrentDateChanged="HandleCurrentDateChanged"
                                     OnDateSelected="ShowDateDetails"
                                     GetSchedulesForDate="date => GetFilteredSchedules(date)"
                                     GetClassSchedulesForDate="date => GetClassSchedulesForDate(date)" />
            }

            @if (viewMode == "week")
            {
                <WeeklyCalendarView CurrentDate="@currentDate"
                                    CurrentDateChanged="HandleCurrentDateChanged"
                                    OnScheduleClicked="ViewScheduleDetails"
                                    GetSchedulesForDate="date => GetFilteredSchedules(date)"
                                    GetClassSchedulesForDate="date => GetClassSchedulesForDate(date)"
                                    OnClassScheduleClicked="ViewClassSchedule" />
            }

            @if (viewMode != "month" && viewMode != "week")
            {
                <DailyScheduleList Title="Schedule for"
                                   SelectedDate="currentDate"
                                   SelectedDateChanged="HandleDateChanged"
                                   Schedules="GetFilteredSchedules(currentDate)"
                                   ClassSchedules="GetClassSchedulesForDate(currentDate)"
                                   OnViewClassSchedule="ViewClassSchedule"
                                   IsGeneralCalendar="true"
                                   OnView="ViewScheduleDetails"
                                   OnEdit="EditSchedule"
                                   OnDelete="DeleteSchedule" />
            }

            @if (ShowSelectedDayList)
            {
                <div class="mt-4 d-lg-none">
                    @SelectedDayList(false)
                </div>
            }
        </div>
    </div>
</div>

@if (showDeleteConfirmation && scheduleToDelete != null)
{
    <ConfirmDeleteModal IsVisible="showDeleteConfirmation"
                        Title="Confirm Delete"
                        Message="Are you sure you want to delete this schedule? This action cannot be undone."
                        OnConfirm="ConfirmDeleteScheduleAsync"
                        OnCancel="CancelDelete" />
}

<ScheduleEntryCreate IsVisible="showAddEventModal"
                     DateParam="@null"
                     OnSave="SaveScheduleEntryAsync"
                     OnClose="CloseAddEventModal" />

<ScheduleEntryEdit IsVisible="showEditModal"
                   ExistingScheduleEntry="selectedSchedule"
                   OnSave="UpdateScheduleEntryAsync"
                   OnClose="CloseEditModal" />

@if (showScheduleDetailsModal && selectedSchedule != null)
{
    <ScheduleDetailsModal IsVisible="showScheduleDetailsModal"
                          ScheduleEntry="selectedSchedule"
                          OnEdit="EditSchedule"
                          OnClose="CloseScheduleDetailsModal" />
}

@if (selectedClassSchedule != null)
{
    <ClassSessionDetailModal IsVisible="true"
                             Session="selectedClassSchedule.ToClassSessionListItem()"
                             ClassLevel="selectedClassSchedule.ClassLevel"
                             Term="selectedClassSchedule.Semester"
                             OnClose="CloseClassScheduleDetails" />
}

@code {
    private List<ScheduleEntry> scheduleEntries = new();
    private List<ClassScheduleListItem> classSchedules = new();
    private ScheduleEntry? scheduleToDelete = null;
    private ScheduleEntry? selectedSchedule = null;
    private ClassScheduleListItem? selectedClassSchedule = null;
    private ClassLevel selectedClassLevel = ClassLevel.None;
    private DateTime currentDate = DateTime.Now;
    private DateTime? selectedDate = null;
    private string viewMode = "month";
    private bool showMeetings = true;
    private bool showEvents = true;
    private bool showDailyView = false;
    private bool showEditModal = false;
    private bool showDeleteConfirmation = false;
    private bool showAddEventModal = false;
    private bool showScheduleDetailsModal = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadVisibleRangeAsync();
    }

    private async Task LoadVisibleRangeAsync()
    {
        var range = GetVisibleRange();
        var classLevel = selectedClassLevel;
        var entries = await SchoolDataService.GetScheduleEntriesInRangeAsync(range.Start, range.End);
        var classes = classLevel == ClassLevel.None
            ? new List<ClassScheduleListItem>()
            : await SchoolDataService.GetClassSchedulesInRangeAsync(range.Start, range.End, classLevel);

        if (range != GetVisibleRange() || classLevel != selectedClassLevel)
            return;

        scheduleEntries = entries;
        classSchedules = classes;
    }

    private (DateTime Start, DateTime End) GetVisibleRange()
    {
        if (viewMode == "month")
        {
            var monthStart = new DateTime(currentDate.Year, currentDate.Month, 1);
            return (monthStart, monthStart.AddMonths(1));
        }

        if (viewMode == "week")
        {
            var weekStart = LogicMethods.GetWeekStart(currentDate);
            return (weekStart, weekStart.AddDays(FcmsConstants.DAYS_IN_WEEK));
        }

        return (currentDate.Date, currentDate.Date.AddDays(1));
    }

    private List<ScheduleEntry> GetFilteredSchedules(DateTime date)
    {
        return scheduleEntries
            .Where(s => s.DateTime.Date == date.Date)
            .Where(s => (showMeetings && !string.IsNullOrWhiteSpace(s.Meeting)) ||
                        (showEvents && !string.IsNullOrWhiteSpace(s.Event)))
            .ToList();
    }

    private List<ClassScheduleListItem> GetClassSchedulesForDate(DateTime date)
    {
        return classSchedules
            .Where(c => c.DateTime.Date == date.Date)
            .ToList();
    }

    private async Task ApplyFilters()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnViewModeChanged()
    {
        showDailyView = false;
        selectedDate = null;
        await LoadVisibleRangeAsync();
    }

    private async Task ShowDateDetails(DateTime date)
    {
        selectedDate = date;
        showDailyView = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleCurrentDateChanged(DateTime date)
    {
        currentDate = date;
        showDailyView = false;
        selectedDate = null;
        await LoadVisibleRangeAsync();
    }

    private async Task HandleDateChanged(DateTime newDate)
    {
        currentDate = newDate;
        selectedDate = newDate;
        await LoadVisibleRangeAsync();
    }

    private void ViewScheduleDetails(ScheduleEntry schedule)
    {
        selectedSchedule = schedule;
        showScheduleDetailsModal = true;
    }

    private void ViewClassSchedule(ClassScheduleListItem classSchedule)
    {
        selectedClassSchedule = classSchedule;
    }

    private void CloseClassScheduleDetails() => selectedClassSchedule = null;

    
    private bool ShowSelectedDayList => showDailyView && selectedDate.HasValue && viewMode == "month";

    private RenderFragment SelectedDayList(bool isCompact) => @<DailyScheduleList Title="Schedule for"
                                                                                  SelectedDate="selectedDate.GetValueOrDefault()"
                                                                                  SelectedDateChanged="HandleDateChanged"
                                                                                  Schedules="GetFilteredSchedules(selectedDate.GetValueOrDefault())"
                                                                                  ClassSchedules="GetClassSchedulesForDate(selectedDate.GetValueOrDefault())"
                                                                                  OnViewClassSchedule="ViewClassSchedule"
                                                                                  IsGeneralCalendar="true"
                                                                                  IsCompact="isCompact"
                                                                                  OnView="ViewScheduleDetails"
                                                                                  OnEdit="EditSchedule"
                                                                                  OnDelete="DeleteSchedule" />;

    private void EditSchedule(ScheduleEntry schedule)
    {
        selectedSchedule = schedule;
        showEditModal = true;
        showScheduleDetailsModal = false;
    }

    private void DeleteSchedule(ScheduleEntry schedule)
    {
        scheduleToDelete = schedule;
        showDeleteConfirmation = true;
    }

    private void CancelDelete()
    {
        scheduleToDelete = null;
        showDeleteConfirmation = false;
    }

    private async Task ConfirmDeleteScheduleAsync()
    {
        if (scheduleToDelete != null)
        {
            SchoolDataService.DeleteGeneralCalendarScheduleEntry(scheduleToDelete.Id);
            await LoadVisibleRangeAsync();
        }
        showDeleteConfirmation = false;
        scheduleToDelete = null;
    }

    private void ShowAddEventModal() => showAddEventModal = true;
    private void CloseAddEventModal() => showAddEventModal = false;
    private void CloseEditModal() { showEditModal = false; selectedSchedule = null; }
    private void CloseScheduleDetailsModal() { showScheduleDetailsModal = false; selectedSchedule = null; }

    private async Task SaveScheduleEntryAsync(ScheduleEntry scheduleEntry)
    {
        SchoolDataService.AddGeneralScheduleEntry(scheduleEntry);
        await LoadVisibleRangeAsync();
        showAddEventModal = false;
    }

    private async Task UpdateScheduleEntryAsync(ScheduleEntry scheduleEntry)
    {
        SchoolDataService.UpdateGeneralCalendarScheduleEntry(scheduleEntry);
        await LoadVisibleRangeAsync();
        showEditModal = false;
        selectedSchedule = null;
    }
}